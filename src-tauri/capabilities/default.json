{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the HivemindOS desktop window",
  "windows": [
    "main",
    "about",
    "route-*"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-confirm",
    "dialog:allow-open",
    "liquid-glass:default",
    "opener:default",
    "process:allow-restart",
    "updater:default",
    "allow-desktop-status",
    "allow-native-pairing-host",
    "allow-native-dashboard-unlock-token",
    "allow-dashboard-bootstrap",
    "allow-list-local-directories",
    "allow-create-local-folder",
    "allow-display-local-path",
    "allow-open-deliverable",
    "allow-open-project-terminal",
    "allow-list-aeon-deliverables",
    "allow-list-aeon-outputs",
    "allow-list-aeon-schedules",
    "allow-get-aeon-memory",
    "allow-prepare-aeon-workspace",
    "allow-aeon-repo-sync",
    "allow-list-aeon-runs",
    "allow-get-aeon-run-log",
    "allow-brain-skill-inventory",
    "allow-brain-graph",
    "allow-hive-env-read",
    "allow-fleet-apps-cache",
    "allow-fleet-discover",
    "allow-tailscale-devices",
    "allow-kanban-read",
    "allow-memory-telemetry",
    "allow-phone-prompts",
    "allow-native-boot-status",
    "allow-retry-native-server",
    "allow-runtime-files",
    "allow-runtime-usage",
    "allow-read-local-image-preview",
    "allow-native-setup-run",
    "allow-native-setup-status",
    "allow-scheduler-shared-schedules",
    "allow-obsidian-capture-note",
    "allow-obsidian-agents",
    "allow-obsidian-personal-wallets",
    "allow-dashboard-state-read",
    "allow-dashboard-state-write",
    "allow-download-aeon-deliverable",
    "allow-send-aeon-deliverable",
    "allow-open-route-window",
    "allow-wallet-secret-export-save",
    "allow-slack-session-capture",
    "allow-speech-recognition-available",
    "allow-speech-recognition-start",
    "allow-speech-recognition-stop"
  ]
}
