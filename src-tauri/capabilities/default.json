{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the HivemindOS desktop window",
  "windows": [
    "main",
    "route-*"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:default"
  ]
}
