<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.microphone</key>
  <true/>
  <!-- The bundled Node.js sidecar (resources/hivemindos-node/node) runs the
       embedded Next server. V8 JIT-compiles, so under the hardened runtime it
       MUST be allowed to allocate executable memory or the kernel kills it on
       boot (EXC_BAD_ACCESS / mprotect denied), the dashboard port never opens,
       and the app crashes after the 25s start timeout. These entitlements ride
       on the same plist used to (re-)sign both the app and the node binary, so
       node keeps JIT rights whether it is signed pre-bundle or re-signed by the
       Tauri deep-sign. disable-library-validation lets node load its packaged
       native addons even if they carry a different (or ad-hoc) signature. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
