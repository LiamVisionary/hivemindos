{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HivemindOS",
  "mainBinaryName": "HivemindOS",
  "version": "0.2.0",
  "identifier": "com.hivemindos.desktop",
  "build": {
    "beforeDevCommand": "pnpm tauri:next-dev",
    "devUrl": "http://localhost:5021",
    "beforeBuildCommand": "pnpm tauri:prepare",
    "frontendDist": "static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HivemindOS",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#080a0f",
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/claw"
    ],
    "macOS": {
      "bundleName": "HivemindOS",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "resources/": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
