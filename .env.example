OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=

NEXT_PUBLIC_HERMES_BASE_URL=http://127.0.0.1:8642
NEXT_PUBLIC_AEON_A2A_URL=http://127.0.0.1:41241
NEXT_PUBLIC_AEON_REPO=
NEXT_PUBLIC_AEON_LOCAL_PATH=
MIROSHARK_BASE_URL=http://127.0.0.1:5001
# Optional explicit install path. Otherwise the MiroShark adapter detects common local locations.
MIROSHARK_HOME=
# Optional admin token for MiroShark mutation endpoints such as publish/export.
# The Swarm tab can generate and store this in MiroShark's local .env automatically.
MIROSHARK_ADMIN_TOKEN=
# Optional public fallback for local browser-visible config
NEXT_PUBLIC_MIROSHARK_BASE_URL=http://127.0.0.1:5001
# Optional: leave this default or blank to auto-detect a local Obsidian vault.
NEXT_PUBLIC_OBSIDIAN_VAULT_PATH=~/Documents/Obsidian/hivemindos-vault
NEXT_PUBLIC_OBSIDIAN_KANBAN_FOLDER=Projects/HivemindOS/Kanban
# setup.sh writes true when Tailscale is installed and logged in.
NEXT_PUBLIC_TAILNET_SYNC_ENABLED=false
# Optional comma-separated hostnames/IPs allowed to load Next dev assets.
# Usually auto-detected from `tailscale ip -4` and MagicDNS when Tailscale is installed.
NEXT_ALLOWED_DEV_ORIGINS=
OBSIDIAN_CLI_PATH=obsidian
NEXT_PUBLIC_HERMES_CONTROL_ROOM_PATH=~/agent-control-room
# Optional folder-backed notes provider root for encrypted hive-env-add backups.
# Defaults to NEXT_PUBLIC_OBSIDIAN_VAULT_PATH when blank.
HIVE_NOTE_ROOT=
HIVE_NOTE_SECURE_FOLDER=Notes/Secure
HIVE_ENV_BACKUP_DIR=
HIVE_ENV_GPG_RECIPIENT=
HIVE_ENV_PUBLIC_KEY=
# Optional generic agent env target for hive-env-add. Runtime compatibility
# modes remain explicit via HIVE_AGENT_RUNTIME=hermes|aeon|openclaw.
HIVE_AGENT_ENV_FILE=~/.hivemindos/.env
HIVE_AGENT_RUNTIME=generic
# setup.sh writes true only when Tailscale SSH is verified, because hive-env-add
# peer reconciliation uses `tailscale ssh`.
HIVE_ENV_TAILNET_SYNC=false
# setup.sh writes the local user so peer sync can try user@host before root fallback.
HIVE_ENV_TAILNET_USER=
HIVE_ENV_COLLECTOR_PORT=8787
# Optional comma-separated override such as root@ubuntu.tailnet.ts.net,liam@mac.tailnet.ts.net.
HIVE_ENV_TAILNET_TARGETS=
HIVE_ENV_TAILNET_VERBOSE=false

# Optional fallback AI route
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude--sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_MODEL=
NEXT_PUBLIC_LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234
NEXT_PUBLIC_LOCAL_OPENAI_MODEL=

# Optional phone-call STT. Leave WHISPER_BASE_URL blank to use OpenAI audio
# transcriptions with OPENAI_TRANSCRIBE_KEY, OPENAI_REALTIME_KEY, or OPENAI_API_KEY.
OPENAI_TRANSCRIBE_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
WHISPER_BASE_URL=
WHISPER_API_KEY=
LOCAL_WHISPER_BASE_URL=
LOCAL_WHISPER_API_KEY=
OPENAI_TRANSCRIBE_BASE_URL=

# Optional UsePod demand-side inference proxy. Keep the token server-side; HivemindOS
# builds https://api.usepod.ai/proxy/$USEPOD_TOKEN/v1 at request time.
USEPOD_TOKEN=
USEPOD_DEPOSIT_ADDRESS=
USEPOD_MAX_PRICE_INPUT_MICRO_USDC=
USEPOD_MAX_PRICE_OUTPUT_MICRO_USDC=

# Optional web search tool for /api/chat/agent
TAVILY_API_KEY=
EXA_API_KEY=

# Public official Honey ledger endpoint. Safe to commit. The backend stores the
# official balance; frontend values are display-only.
HONEY_LEDGER_REMOTE_URL=https://hivemindos-honey-ledger.hivemindos.workers.dev
HONEY_LEDGER_ISSUER_ID=hivemindos
HONEY_COMPUTE_GATEWAY_URL=https://hivemindos-compute-gateway.hivemindos.workers.dev
HIVE_TOKEN_ADDRESS=

# Managed-agent Honey credits. Managed Honey is spend-only service credit and
# is separate from reward Honey that can be claimed to HIVE.
MANAGED_HONEY_CREDITS_PER_USD=100
MANAGED_AGENT_MARKUP_BPS=5000
MANAGED_AGENT_USD_PER_1K_TOKENS=0.01
MANAGED_HONEY_MANUAL_CREDIT_ENABLED=false
MANAGED_HONEY_MANUAL_DEBIT_ENABLED=false
MANAGED_AGENT_X402_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HONEY_BILLING_LOCAL_TOKEN=
HONEY_BILLING_SIGNING_SECRET=

# Optional x402 Base Builder Code attribution. Builder Codes are public
# identifiers from dashboard.base.org, not secrets. They apply only on Base
# mainnet (eip155:8453).
HIVEMINDOS_PAID_AGENT_TESTNET_MODE=false
HIVEMINDOS_X402_CLIENT_BUILDER_CODE=
HIVEMINDOS_PAID_AGENT_BUILDER_CODE=
HIVEMINDOS_X402_BUILDER_CODE=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional platform fees for locally signed wallet rails. By default the app
# reads public official fee policy from the hosted HivemindOS endpoint below.
# Setting HIVEMINDOS_TRADING_PLATFORM_FEES_ENABLED or a local recipient value
# makes this install use self-hosted override policy instead. Fee-rate defaults
# alone keep using the hosted official policy.
HIVEMINDOS_PLATFORM_FEE_POLICY_URL=https://hivemindos-paid-agent-gateway.hivemindos.workers.dev/api/platform-fees/config
HIVEMINDOS_TRADING_PLATFORM_FEES_ENABLED=
HIVEMINDOS_TRADING_PLATFORM_FEE_BPS=100
HIVEMINDOS_TRADING_PLATFORM_MIN_FEE_USD=0.01
HIVEMINDOS_TRADING_PLATFORM_MAX_FEE_USD=
HIVEMINDOS_PLATFORM_FEE_RECIPIENT_EVM=
HIVEMINDOS_PLATFORM_FEE_RECIPIENT_SOLANA=

# User-funded Bankr LLM key. Add credits at bankr.bot/llm or with:
# bankr llm credits add 25
BANKR_LLM_KEY=

# Private official signer value. Normal clones leave this blank; official Honey
# is minted by the trusted compute gateway, not by client-reported token usage.
HONEY_LEDGER_SIGNING_SECRET=

# Tailnet hygiene. TAILSCALE_API_KEY (an API access token from the Tailscale
# admin console) lets the dashboard list and prune stale tailnet nodes via
# /api/tailscale/cleanup. HIVE_TAILNET_AUTO_CLEANUP=1 additionally allows the
# daily sweep to delete offline hivemindos-* link nodes without asking;
# leave it unset to keep the sweep report-only.
TAILSCALE_API_KEY=
HIVE_TAILNET_AUTO_CLEANUP=
# Register the Hivemind Link node as ephemeral so stale registrations
# self-delete after going offline (requires HIVE_LINK_AUTH_KEY to re-join).
HIVE_LINK_EPHEMERAL=

# HivemindOS Cloud Agent Calls (LiveKit). Off by default: LiveKit rooms
# connect over the internet, while the default setup stays local and private
# (BYOK OpenAI Realtime + Local TTS need none of this). Both flags must be set
# before the LiveKit voice worker starts or any cloud room is created, along
# with LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET.
HIVEMINDOS_PREMIUM=
HIVEMINDOS_LIVEKIT_ENABLED=
