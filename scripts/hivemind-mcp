function criticalExecutionAnnotations(toolName) {
  return {
    destructiveHint: true,
    "hivemindos/risk": "critical",
    "hivemindos/sideEffects": ["wallet", "payment", "network"],
    "hivemindos/confirmation": CRITICAL_EXECUTION_ANNOTATIONS[toolName],
  };
}

