#!/usr/bin/env node
import fs from "node:fs";
import http from "node:http";
import os from "node:os";
import path from "node:path";
import readline from "node:readline";

const TOOLS = [
  {
    name: "list_hivemind_machines",
    description: "List connected HivemindOS machines and their available agents.",
    inputSchema: { type: "object", properties: {} },
  },
  {
    name: "plan_handoff",
    description: "Resolve a fuzzy machine name and select the best target agent without side effects.",
    inputSchema: handoffSchema(["target"]),
  },
  {
    name: "handoff_file",
    description: "Copy local files into the Hivemind Sync handoff folder for a target machine.",
    inputSchema: handoffSchema(["target", "files"]),
  },
  {
    name: "handoff_file_task",
    description: "Copy files to a target machine and start the best matching agent there on the task.",
    inputSchema: handoffSchema(["target", "files", "task"]),
  },
  {
    name: "handoff_task",
    description: "Start the best matching agent on a target machine on a task, without files.",
    inputSchema: handoffSchema(["target", "task"]),
  },
  {
    name: "crypto_capabilities",
    description: "List HivemindOS crypto/payment rail readiness for Bankr, x402, Veil Cash, MoneyClaw, and UsePod without spending.",
    inputSchema: cryptoSchema([]),
  },
  {
    name: "select_crypto_rail",
    description: "Select the best configured crypto/payment rail for an intent without executing the spend.",
    inputSchema: cryptoSchema(["intent"]),
  },
  {
    name: "prepare_crypto_action",
    description: "Prepare a spend-gated crypto/payment action draft and return the provider endpoint, request body, approval need, and missing readiness.",
    inputSchema: cryptoSchema(["intent"]),
  },
  {
    name: "compile_brain_knowledge",
    description: "Compile source text into HivemindOS compiled-knowledge wiki pages with entities, concepts, summaries, frontmatter, and wikilinks.",
    inputSchema: knowledgeCompileSchema(),
  },
  {
    name: "brain_graph_overview",
    description: "Return a compact graph overview for a compiled-knowledge domain: counts, hubs, and orphan totals.",
    inputSchema: knowledgeSchema([]),
  },
  {
    name: "brain_search_knowledge",
    description: "Search a compiled-knowledge domain with weighted title, slug, tags, frontmatter, and markdown body matches.",
    inputSchema: knowledgeSearchSchema(),
  },
  {
    name: "brain_get_node",
    description: "Fetch one compiled-knowledge node with body, outgoing links, and backlinks.",
    inputSchema: knowledgeSchema(["slug"]),
  },
  {
    name: "brain_get_backlinks",
    description: "List every compiled-knowledge page that links to a node.",
    inputSchema: knowledgeSchema(["slug"]),
  },
  {
    name: "scan_brain_wiki_health",
    description: "Scan a compiled-knowledge domain for broken links, orphans, duplicate slugs, and missing backlinks.",
    inputSchema: knowledgeSchema([]),
  },
  {
    name: "fix_brain_wiki_issue",
    description: "Apply one safe compiled-knowledge health fix, such as a suggested broken-link retarget or missing backlink.",
    inputSchema: knowledgeFixSchema(),
  },
  {
    name: "shared_brain_contract",
    description: "Explain whether a write is allowed under HivemindOS personal, agent-to-agent, or human-collective shared-brain contribution rules.",
    inputSchema: sharedContractSchema(),
  },
];

function handoffSchema(required) {
  return {
    type: "object",
    required,
    properties: {
      target: { type: "string", description: "Fuzzy machine name, such as ubuntu." },
      files: { type: "array", items: { type: "string" }, description: "Local file paths available to the dashboard host." },
      task: { type: "string", description: "Work the receiving agent should perform." },
      note: { type: "string" },
      allowAmbiguous: { type: "boolean" },
    },
  };
}

function cryptoSchema(required) {
  return {
    type: "object",
    required,
    properties: {
      intent: {
        type: "string",
        enum: ["status", "portfolio", "receive", "send", "private-transfer", "paid-api", "private-paid-api", "trade", "card-payment", "fund-llm-credits"],
        description: "Natural payment intent to route.",
      },
      agentId: { type: "string", description: "Agent wallet/profile id, when the action belongs to a specific agent." },
      preferredProvider: { type: "string", enum: ["bankr", "moneyclaw", "x402", "usepod", "veil"], description: "Optional explicit provider preference." },
      wallet: { type: "object", description: "Current agent wallet policy from the dashboard, including provider, Spend, caps, network, and auto-use settings." },
      amountUsd: { type: "number", description: "USD-denominated amount or cap for the intended action." },
      asset: { type: "string", enum: ["USDC", "ETH"], description: "Asset for private transfers." },
      url: { type: "string", description: "Paid API/x402 URL." },
      method: { type: "string", description: "HTTP method for paid API/x402 requests." },
      headers: { type: "object", description: "HTTP headers for paid API/x402 requests." },
      body: { description: "JSON body for paid API/x402 requests." },
      recipientAddress: { type: "string", description: "Recipient wallet address for send/private-transfer intents." },
      amount: { description: "Asset amount for private transfer intents." },
    },
  };
}

function knowledgeSchema(required) {
  return {
    type: "object",
    required,
    properties: {
      domain: { type: "string", description: "Compiled-knowledge domain. Defaults to shared-brain." },
      vaultPath: { type: "string", description: "Optional shared vault path override." },
      slug: { type: "string", description: "Node slug, such as hivemindos or compiled-knowledge." },
    },
  };
}

function knowledgeCompileSchema() {
  return {
    type: "object",
    required: ["title", "content"],
    properties: {
      domain: { type: "string", description: "Compiled-knowledge domain. Defaults to shared-brain." },
      vaultPath: { type: "string", description: "Optional shared vault path override." },
      title: { type: "string" },
      content: { type: "string" },
      summary: { type: "string" },
      sourcePath: { type: "string" },
      tags: { type: "array", items: { type: "string" } },
      entities: { type: "array", items: knowledgeDraftSchema() },
      concepts: { type: "array", items: knowledgeDraftSchema() },
      collaborationMode: { type: "string", enum: ["personal", "agent-to-agent", "human-collective"] },
      optedInDomain: { type: "string", description: "Personal opted-in domain for human collective contributions." },
    },
  };
}

function knowledgeSearchSchema() {
  return {
    type: "object",
    required: ["query"],
    properties: {
      domain: { type: "string", description: "Compiled-knowledge domain. Defaults to shared-brain." },
      vaultPath: { type: "string", description: "Optional shared vault path override." },
      query: { type: "string", description: "Search query for compiled entity, concept, and summary pages." },
      limit: { type: "number", description: "Maximum results to return, from 1 to 50." },
      types: { type: "array", items: { type: "string", enum: ["entity", "concept", "summary"] } },
    },
  };
}

function knowledgeDraftSchema() {
  return {
    type: "object",
    required: ["name"],
    properties: {
      name: { type: "string" },
      slug: { type: "string" },
      description: { type: "string" },
      facts: { type: "array", items: { type: "string" } },
      tags: { type: "array", items: { type: "string" } },
      related: { type: "array", items: { type: "string" } },
    },
  };
}

function knowledgeFixSchema() {
  return {
    type: "object",
    required: ["issueId"],
    properties: {
      domain: { type: "string" },
      vaultPath: { type: "string" },
      issueId: { type: "string" },
    },
  };
}

function sharedContractSchema() {
  return {
    type: "object",
    properties: {
      domain: { type: "string" },
      actorKind: { type: "string", enum: ["human", "agent"] },
      collaborationMode: { type: "string", enum: ["personal", "agent-to-agent", "human-collective"] },
      operation: { type: "string", enum: ["compile", "fix-health", "dismiss-health", "direct-edit"] },
      readonly: { type: "boolean" },
      optedInDomain: { type: "string" },
    },
  };
}

function readEnvValue(filePath, key) {
  const raw = fs.existsSync(filePath) ? fs.readFileSync(filePath, "utf8") : "";
  const escapedKey = key.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = raw.match(new RegExp(`^${escapedKey}=(.*)$`, "m"));
  return match?.[1]?.trim().replace(/^['"]|['"]$/g, "") || "";
}

function dashboardToken() {
  return process.env.HIVEMINDOS_DASHBOARD_DEVICE_TOKEN
    || process.env.HIVE_E2E_DASHBOARD_TOKEN
    || readEnvValue(path.join(process.cwd(), ".env.local"), "HIVEMINDOS_DASHBOARD_DEVICE_TOKEN");
}

function candidateApiBases() {
  const values = [];
  if (process.env.HIVEMINDOS_APP_URL) values.push(process.env.HIVEMINDOS_APP_URL);
  if (process.env.NEXT_PUBLIC_APP_URL) values.push(process.env.NEXT_PUBLIC_APP_URL);
  if (process.env.DASHBOARD_URL) values.push(process.env.DASHBOARD_URL);
  if (process.env.PORT) values.push(`http://127.0.0.1:${process.env.PORT}`);
  for (const port of [5020, 5021, 5022, 5023, 5024, 5025]) values.push(`http://127.0.0.1:${port}`);
  return [...new Set(values.map((value) => String(value).replace(/\/+$/, "")))];
}

function requestJson(base, route, method = "GET", body) {
  return new Promise((resolve, reject) => {
    const url = new URL(route, base);
    const payload = body ? JSON.stringify(body) : "";
    const token = dashboardToken();
    const headers = {
      ...(payload ? { "content-type": "application/json", "content-length": Buffer.byteLength(payload) } : {}),
      ...(token ? { "x-hivemindos-device-token": token } : {}),
    };
    const req = http.request(url, { method, headers, timeout: 190_000 }, (res) => {
      let data = "";
      res.setEncoding("utf8");
      res.on("data", (chunk) => { data += chunk; });
      res.on("end", () => {
        let parsed = null;
        try {
          parsed = data ? JSON.parse(data) : {};
        } catch {
          reject(new Error(`${base} returned non-JSON response`));
          return;
        }
        if (res.statusCode < 200 || res.statusCode >= 300 || parsed?.ok === false) {
          const error = new Error(parsed?.error || `${base} returned HTTP ${res.statusCode}`);
          error.payload = parsed;
          reject(error);
          return;
        }
        resolve(parsed);
      });
    });
    req.on("timeout", () => req.destroy(new Error(`${base} timed out`)));
    req.on("error", reject);
    if (payload) req.write(payload);
    req.end();
  });
}

async function callDashboard(route, method, body) {
  let lastError = null;
  for (const base of candidateApiBases()) {
    try {
      return await requestJson(base, route, method, body);
    } catch (error) {
      lastError = error;
      if (error?.payload?.needsUserInput) throw error;
    }
  }
  throw lastError || new Error("No HivemindOS dashboard API could be reached.");
}

async function callTool(name, args = {}) {
  if (name === "list_hivemind_machines") {
    const data = await callDashboard("/api/fleet/discover?includeSnapshots=0&fresh=1", "GET");
    return {
      ok: true,
      machines: (data.machines || []).filter((machine) => machine.collector === "ready").map((machine) => ({
        name: machine.device?.name || machine.key,
        os: machine.device?.os,
        self: machine.device?.self === true,
        runtimes: machine.capabilities?.runtimes || [],
        agents: (machine.agents || []).map((agent) => ({
          name: agent.name,
          runtime: agent.runtime,
          workerClass: agent.workerClass || "general",
          beeRole: agent.beeRole || "worker",
        })),
      })),
    };
  }
  if (name === "crypto_capabilities") {
    return callDashboard("/api/crypto/capabilities", "POST", {
      action: "status",
      ...cryptoArgs(args),
    });
  }
  if (name === "select_crypto_rail") {
    return callDashboard("/api/crypto/capabilities", "POST", {
      action: "select",
      ...cryptoArgs(args),
    });
  }
  if (name === "prepare_crypto_action") {
    return callDashboard("/api/crypto/capabilities", "POST", {
      action: "prepare",
      ...cryptoArgs(args),
    });
  }
  if (name === "compile_brain_knowledge") {
    return callDashboard("/api/brain/knowledge", "POST", {
      action: "compile",
      actorKind: "agent",
      collaborationMode: args.collaborationMode || "agent-to-agent",
      ...knowledgeArgs(args),
    });
  }
  if (name === "brain_graph_overview") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "graph-overview", ...knowledgeArgs(args) });
  }
  if (name === "brain_search_knowledge") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "search", ...knowledgeArgs(args) });
  }
  if (name === "brain_get_node") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "get-node", ...knowledgeArgs(args) });
  }
  if (name === "brain_get_backlinks") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "get-backlinks", ...knowledgeArgs(args) });
  }
  if (name === "scan_brain_wiki_health") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "scan-health", ...knowledgeArgs(args) });
  }
  if (name === "fix_brain_wiki_issue") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "fix-health", ...knowledgeArgs(args) });
  }
  if (name === "shared_brain_contract") {
    return callDashboard("/api/brain/knowledge", "POST", {
      action: "shared-contract",
      domain: args.domain,
      actorKind: args.actorKind,
      collaborationMode: args.collaborationMode,
      operation: args.operation,
      readonly: args.readonly,
      optedInDomain: args.optedInDomain,
    });
  }
  const actionByTool = {
    plan_handoff: "plan",
    handoff_file: "send-file",
    handoff_file_task: "send-file-task",
    handoff_task: "send-task",
  };
  const action = actionByTool[name];
  if (!action) throw new Error(`Unknown tool: ${name}`);
  return callDashboard("/api/handoff", "POST", {
    action,
    target: args.target,
    files: Array.isArray(args.files) ? args.files.map(expandHome) : [],
    task: args.task,
    note: args.note,
    dryRun: name === "plan_handoff",
    allowAmbiguous: args.allowAmbiguous === true,
  });
}

function cryptoArgs(args) {
  const output = {};
  for (const key of ["intent", "agentId", "preferredProvider", "wallet", "amountUsd", "asset", "url", "method", "headers", "body", "recipientAddress", "amount"]) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

function knowledgeArgs(args) {
  const output = {};
  for (const key of ["domain", "vaultPath", "slug", "title", "content", "summary", "sourcePath", "tags", "entities", "concepts", "collaborationMode", "optedInDomain", "issueId", "query", "limit", "types"]) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

function expandHome(value) {
  const text = String(value || "");
  if (text === "~") return os.homedir();
  if (text.startsWith("~/") || text.startsWith("~\\")) return path.join(os.homedir(), text.slice(2));
  return text;
}

function respond(id, result) {
  process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", id, result })}\n`);
}

function respondError(id, error) {
  process.stdout.write(`${JSON.stringify({
    jsonrpc: "2.0",
    id,
    error: {
      code: -32000,
      message: error?.payload?.error || error?.message || String(error),
      data: error?.payload,
    },
  })}\n`);
}

async function handle(message) {
  const id = message.id;
  try {
    if (message.method === "initialize") {
      respond(id, {
        protocolVersion: "2024-11-05",
        serverInfo: { name: "hivemindos", version: "0.1.0" },
        capabilities: { tools: {} },
      });
      return;
    }
    if (message.method === "tools/list") {
      respond(id, { tools: TOOLS });
      return;
    }
    if (message.method === "tools/call") {
      const result = await callTool(message.params?.name, message.params?.arguments || {});
      respond(id, {
        content: [{ type: "text", text: JSON.stringify(result, null, 2) }],
        structuredContent: result,
      });
      return;
    }
    if (message.method === "ping") {
      respond(id, {});
      return;
    }
    if (id !== undefined) respondError(id, new Error(`Unsupported method: ${message.method}`));
  } catch (error) {
    respondError(id, error);
  }
}

const rl = readline.createInterface({ input: process.stdin, terminal: false });
rl.on("line", (line) => {
  if (!line.trim()) return;
  let message = null;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  void handle(message);
});
