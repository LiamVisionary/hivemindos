      marketType: { type: "string", enum: ["perp", "spot"] },
      assetId: { type: "number" },
      side: { type: "string", enum: ["long", "short", "buy", "sell"] },
      orderType: { type: "string", enum: ["market", "limit", "trigger"] },
      notionalUsd: { type: "number" },
      size: { type: "number" },
      limitPrice: { type: "number" },
      timeInForce: { type: "string" },
      triggerPx: { type: "number" },
      triggerType: { type: "string", enum: ["tp", "sl"] },
      triggerIsMarket: { type: "boolean" },
      grouping: { type: "string" },
      clientOrderId: { type: "string" },
      reduceOnly: { type: "boolean" },
      slippageBps: { type: "number" },
      orderId: {},
      oid: {},
      cloid: { type: "string" },
      fastCancel: { type: "boolean" },
      alwaysPlace: { type: "boolean" },
      scheduleCancelTime: {},
      leverage: { type: "number" },
      marginMode: { type: "string", enum: ["cross", "isolated"] },
      marginDeltaUsd: { type: "number" },
      transferType: { type: "string" },
      amount: { type: "number" },
      amountUsd: { type: "number" },
      destination: { type: "string" },
      token: { type: "string" },
      toPerp: { type: "boolean" },
      twapMinutes: { type: "number" },
      twapRandomize: { type: "boolean" },
      twapId: {},
      confirmation: { type: "string" },
      approvalToken: { type: "string" },
    },
  };
}

