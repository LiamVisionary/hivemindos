const TOOLS = mergeToolDescriptors(
  MANUAL_TOOLS,
  await loadHiveActionMcpTools(),
);
const HIVE_ACTION_MCP_TOOL_BY_NAME = new Map(TOOLS.map((tool) => [tool.name, tool]));
const EXECUTION_TOOL_NAMES = new Set(["send_usdc", "dex_swap", "stock_trade", "hyperliquid_trade", "clawbank_send_usdc", "clawbank_trade", "clawbank_money_transfer", "clawbank_call"]);
const HYPERLIQUID_READ_ACTIONS = new Set(["", "quote", "status", "positions", "open-orders", "fills", "fees", "order-status"]);
const HYPERLIQUID_CONFIRMATION_BY_ACTION = new Map([
  ["approve-builder", "CONFIRM_HYPERLIQUID_BUILDER"],
  ["order", "CONFIRM_HYPERLIQUID_ORDER"],
  ["modify", "CONFIRM_HYPERLIQUID_ORDER"],
  ["cancel", "CONFIRM_HYPERLIQUID_CANCEL"],
  ["cancel-by-cloid", "CONFIRM_HYPERLIQUID_CANCEL"],
  ["schedule-cancel", "CONFIRM_HYPERLIQUID_CANCEL"],
  ["leverage", "CONFIRM_HYPERLIQUID_ACCOUNT"],
  ["margin", "CONFIRM_HYPERLIQUID_ACCOUNT"],
  ["usd-class", "CONFIRM_HYPERLIQUID_TRANSFER"],
  ["usd-send", "CONFIRM_HYPERLIQUID_TRANSFER"],
  ["spot-send", "CONFIRM_HYPERLIQUID_TRANSFER"],
  ["withdraw", "CONFIRM_HYPERLIQUID_TRANSFER"],
  ["twap-order", "CONFIRM_HYPERLIQUID_TWAP"],
  ["twap-cancel", "CONFIRM_HYPERLIQUID_TWAP"],
]);

async function loadHiveActionMcpTools() {
  if (process.env.HIVE_MCP_DISABLE_HIVE_ACTION_IMPORT === "1") {
    return [];
  }
  try {
    const { listHiveActions, listMcpHiveActions } = await import(
      new URL("../src/lib/services/hive-actions/index.ts", import.meta.url).href
    );
    return listMcpHiveActions(listHiveActions());
  } catch {
    return [];
  }
}

function mergeToolDescriptors(manualTools, hiveActionTools) {
  const hiveActionByName = new Map(
    hiveActionTools.map((tool) => [tool.name, tool]),
  );
  const manualNames = new Set(manualTools.map((tool) => tool.name));
  return [
    ...manualTools.map((tool) => hiveActionByName.get(tool.name) || tool),
    ...hiveActionTools.filter((tool) => !manualNames.has(tool.name)),
  ];
}

function requireHiveActionExecutionPreflight(name, args = {}) {
  if (!EXECUTION_TOOL_NAMES.has(name)) return;
  if (name === "hyperliquid_trade" && HYPERLIQUID_READ_ACTIONS.has(String(args.action || "").toLowerCase())) return;
  const tool = HIVE_ACTION_MCP_TOOL_BY_NAME.get(name);
  const annotations = tool?.annotations || {};
  const sideEffects = Array.isArray(annotations["hivemindos/sideEffects"])
    ? annotations["hivemindos/sideEffects"]
    : [];
  const hasWalletPaymentMetadata = sideEffects.includes("wallet") && sideEffects.includes("payment");
  const isCriticalDestructive =
    annotations.destructiveHint === true && annotations["hivemindos/risk"] === "critical";
  if (!tool || !hasWalletPaymentMetadata || !isCriticalDestructive) {
    throw new Error(
      `${name} is missing critical wallet/payment Hive action metadata; refusing MCP execution.`,
    );
  }

  const expected = expectedConfirmationsForExecutionTool(name, args, annotations["hivemindos/confirmation"]);
  const supplied = typeof args.confirmation === "string" ? args.confirmation.trim() : "";
  if (!expected.includes(supplied)) {
    throw new Error(
      `${name} requires confirmation ${formatConfirmationTokens(expected)} before MCP execution.`,
    );
  }
}

function expectedConfirmationsForExecutionTool(name, args, confirmation) {
  if (!confirmation || confirmation === true) {
    throw new Error(`${name} is missing Hive action confirmation metadata; refusing MCP execution.`);
  }
  const tokens = [
    typeof confirmation.token === "string" ? confirmation.token : null,
    ...(Array.isArray(confirmation.tokens) ? confirmation.tokens : []),
  ].filter((token) => typeof token === "string" && token.length > 0);
  if (tokens.length === 0) {
    throw new Error(`${name} has no valid Hive action confirmation token; refusing MCP execution.`);
  }
  if (name === "hyperliquid_trade") {
    const action = typeof args.action === "string" ? args.action.toLowerCase() : "";
    const expected = HYPERLIQUID_CONFIRMATION_BY_ACTION.get(action);
    if (expected && tokens.includes(expected)) return [expected];
    return tokens;
  }
  if (name !== "stock_trade") return tokens;

  const side = typeof args.side === "string" ? args.side.toLowerCase() : "";
  if (side === "buy" && tokens.includes("CONFIRM_BUY")) return ["CONFIRM_BUY"];
  if (side === "sell" && tokens.includes("CONFIRM_SELL")) return ["CONFIRM_SELL"];
  return tokens;
}

function formatConfirmationTokens(tokens) {
  if (tokens.length === 1) return `"${tokens[0]}"`;
  return tokens.map((token) => `"${token}"`).join(" or ");
}

function handoffSchema(required) {
  return {
    type: "object",
    required,
    properties: {
      target: { type: "string", description: "Fuzzy machine name, such as ubuntu." },
      files: { type: "array", items: { type: "string" }, description: "Local file paths available to the dashboard host." },
      task: { type: "string", description: "Work the receiving agent should perform." },
      note: { type: "string" },
      allowAmbiguous: { type: "boolean" },
    },
  };
}

function cryptoSchema(required) {
  return {
    type: "object",
    required,
    properties: {
      intent: {
        type: "string",
        enum: ["status", "portfolio", "receive", "send", "private-transfer", "paid-api", "private-paid-api", "trade", "crosschain-swap", "bridge", "crosschain-payment", "token-launch", "polymarket", "hyperliquid", "automation", "nft", "agent-job", "card-payment", "fund-llm-credits"],
        description: "Natural payment intent to route.",
      },
      agentId: { type: "string", description: "Agent wallet/profile id, when the action belongs to a specific agent." },
      preferredProvider: { type: "string", enum: ["bankr", "moneyclaw", "x402", "usepod", "venice", "veil", "hyperliquid"], description: "Optional explicit provider preference." },
      wallet: { type: "object", description: "Current agent wallet policy from the dashboard, including provider, Spend, caps, network, and auto-use settings." },
      amountUsd: { type: "number", description: "USD-denominated amount or cap for the intended action." },
      asset: { type: "string", enum: ["USDC", "ETH"], description: "Asset for private transfers." },
      url: { type: "string", description: "Paid API/x402 URL." },
      method: { type: "string", description: "HTTP method for paid API/x402 requests." },
      headers: { type: "object", description: "HTTP headers for paid API/x402 requests." },
      body: { description: "JSON body for paid API/x402 requests." },
      recipientAddress: { type: "string", description: "Recipient wallet address for send/private-transfer intents." },
      amount: { description: "Asset amount for private transfer intents." },
      fromChain: { type: "string", description: "Source chain/network for bridge or crosschain swap intents." },
      toChain: { type: "string", description: "Destination chain/network for bridge or crosschain swap intents." },
      fromAsset: { type: "string", description: "Source asset for crosschain intents." },
      toAsset: { type: "string", description: "Destination asset for crosschain intents." },
    },
  };
}

