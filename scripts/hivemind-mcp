function readEnvValue(filePath, key) {
  const raw = fs.existsSync(filePath) ? fs.readFileSync(filePath, "utf8") : "";
  const escapedKey = key.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = raw.match(new RegExp(`^${escapedKey}=(.*)$`, "m"));
  return match?.[1]?.trim().replace(/^['"]|['"]$/g, "") || "";
}

// The launcher (~/.local/bin/hivemind-mcp) execs this script with
// HIVE_ENV_PROJECT_ROOT pointing at the checkout. When a harness (Claude Code,
// Codex, Gemini, …) starts the MCP server its cwd is the user's project, not the
// checkout, so token/URL discovery must use the repo root the launcher passes
// rather than cwd. This keeps the device token OUT of each harness's MCP config.
function projectRoot() {
  return process.env.HIVE_ENV_PROJECT_ROOT || process.cwd();
}

function dashboardToken() {
  return process.env.HIVEMINDOS_DASHBOARD_DEVICE_TOKEN
    || process.env.HIVE_E2E_DASHBOARD_TOKEN
    || readEnvValue(path.join(projectRoot(), ".env.local"), "HIVEMINDOS_DASHBOARD_DEVICE_TOKEN")
    || readEnvValue(path.join(process.cwd(), ".env.local"), "HIVEMINDOS_DASHBOARD_DEVICE_TOKEN");
}

function candidateApiBases() {
  const values = [];
  if (process.env.HIVEMINDOS_APP_URL) values.push(process.env.HIVEMINDOS_APP_URL);
  if (process.env.NEXT_PUBLIC_APP_URL) values.push(process.env.NEXT_PUBLIC_APP_URL);
  if (process.env.DASHBOARD_URL) values.push(process.env.DASHBOARD_URL);
  if (process.env.PORT) values.push(`http://127.0.0.1:${process.env.PORT}`);
  // Honor a custom URL/port persisted in the checkout's .env.local.
  const rootEnv = path.join(projectRoot(), ".env.local");
  const rootUrl = readEnvValue(rootEnv, "HIVEMINDOS_APP_URL") || readEnvValue(rootEnv, "NEXT_PUBLIC_APP_URL");
  if (rootUrl) values.push(rootUrl);
  const rootPort = readEnvValue(rootEnv, "PORT");
  if (rootPort) values.push(`http://127.0.0.1:${rootPort}`);
  for (const port of [5020, 5021, 5022, 5023, 5024, 5025]) values.push(`http://127.0.0.1:${port}`);
  return [...new Set(values.map((value) => String(value).replace(/\/+$/, "")))];
}

function requestJson(base, route, method = "GET", body) {
  return new Promise((resolve, reject) => {
    const url = new URL(route, base);
    const payload = body ? JSON.stringify(body) : "";
    const token = dashboardToken();
    const headers = {
      ...(payload ? { "content-type": "application/json", "content-length": Buffer.byteLength(payload) } : {}),
      ...(token ? { "x-hivemindos-device-token": token } : {}),
    };
    const req = http.request(url, { method, headers, timeout: 190_000 }, (res) => {
      let data = "";
      res.setEncoding("utf8");
      res.on("data", (chunk) => { data += chunk; });
      res.on("end", () => {
        let parsed = null;
        try {
          parsed = data ? JSON.parse(data) : {};
        } catch {
          reject(new Error(`${base} returned non-JSON response`));
          return;
        }
        if (res.statusCode < 200 || res.statusCode >= 300 || parsed?.ok === false) {
          const error = new Error(parsed?.error || `${base} returned HTTP ${res.statusCode}`);
          error.payload = parsed;
          error.statusCode = res.statusCode;
          reject(error);
          return;
        }
        resolve(parsed);
      });
    });
    req.on("timeout", () => req.destroy(new Error(`${base} timed out`)));
    req.on("error", reject);
    if (payload) req.write(payload);
    req.end();
  });
}

async function callDashboard(route, method, body) {
  let lastError = null;
  for (const base of candidateApiBases()) {
    try {
      return await requestJson(base, route, method, body);
    } catch (error) {
      lastError = error;
      // An explicit JSON {ok:false} from a reachable base is authoritative — the
      // request reached the real dashboard and was rejected for a business reason
      // (validation, governance, a broker rejection). Surface it immediately rather
      // than sweeping to the next port and masking it with a connection error.
      // Only 5xx / non-JSON / connection failures mean "wrong or sick base, try next".
      const status = error?.statusCode;
      const reachedRealApi = error?.payload?.ok === false && (status === undefined || status < 500);
      if (error?.payload?.needsUserInput || reachedRealApi) throw error;
    }
  }
  throw lastError || new Error("No HivemindOS dashboard API could be reached.");
}

function localCollectorBase() {
  const port = Number(process.env.AGENT_TELEMETRY_PORT || 8787);
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error("AGENT_TELEMETRY_PORT must be a valid local collector port.");
  }
  return `http://127.0.0.1:${port}`;
}

async function callAppBuilder(args = {}) {
  try {
    return await callDashboard("/api/app-builder", "POST", args);
  } catch (error) {
    if (String(args.backend || "local") !== "local" || error?.payload) throw error;
    return requestJson(localCollectorBase(), "/app-builder", "POST", args);
  }
}

const WORK_BOARD_CREATE_KEYS = [
  "title",
  "body",
  "status",
  "priority",
  "assignee",
  "tenant",
  "workspace",
  "skills",
  "attachments",
  "linkedDirectories",
  "deliverables",
  "targetMachine",
  "projectId",
  "proofs",
  "loop",
  "loopReceipts",
  "parents",
  "idempotencyKey",
  "maxRuntimeMs",
  "maxAttempts",
  "vaultPath",
  "kanbanFolder",
];

const WORK_BOARD_FINISH_KEYS = [
  "taskId",
  "summary",
  "result",
  "metadata",
  "loopReceipts",
  "error",
  "reason",
  "failureReason",
  "runId",
  "vaultPath",
  "kanbanFolder",
];

async function callWorkBoard(args = {}) {
  const action = String(args.action || "list");
  if (action === "list") {
    return callDashboard(
      routeWithQuery("/api/kanban", {
        board: args.board,
        include_archived: args.includeArchived,
        include_boards: args.includeBoards,
        boards_only: args.boardsOnly,
        tenant: args.tenant,
        assignee: args.assignee,
        q: args.query,
        vaultPath: args.vaultPath,
        kanbanFolder: args.kanbanFolder,
      }),
      "GET",
    );
  }
  if (action === "create-task") {
    return callDashboard(
      routeWithQuery("/api/kanban", { board: args.board }),
      "POST",
      {
        board: args.board,
        source: args.source || "mcp:work-board",
        ...definedArgs(args, WORK_BOARD_CREATE_KEYS),
      },
    );
  }
  if (action === "claim-next") {
    return callDashboard(routeWithQuery("/api/kanban", { board: args.board }), "POST", {
      action: "claim-next",
      board: args.board,
      assignee: args.assignee,
      runtime: args.runtime,
      ttlMs: args.ttlMs,
      claimer: args.claimer,
      tenant: args.tenant,
      targetMachineKey: args.targetMachineKey,
      vaultPath: args.vaultPath,
      kanbanFolder: args.kanbanFolder,
    });
  }
  if (action === "heartbeat") {
    return callDashboard(routeWithQuery("/api/kanban", { board: args.board }), "POST", {
      action: "heartbeat",
      board: args.board,
      taskId: args.taskId,
      note: args.note,
      claimLock: args.claimLock,
      vaultPath: args.vaultPath,
      kanbanFolder: args.kanbanFolder,
    });
  }
  if (action === "comment") {
    return callDashboard(routeWithQuery("/api/kanban", { board: args.board }), "POST", {
      action: "comment",
      board: args.board,
      taskId: args.taskId,
      body: args.body || args.note,
      author: args.author || args.claimer || "mcp-agent",
      vaultPath: args.vaultPath,
      kanbanFolder: args.kanbanFolder,
    });
  }
  if (action === "complete" || action === "fail") {
    return callDashboard(routeWithQuery("/api/kanban", { board: args.board }), "POST", {
      action,
      board: args.board,
      ...definedArgs(args, WORK_BOARD_FINISH_KEYS),
    });
  }
  if (action === "block") {
    return callDashboard(routeWithQuery("/api/kanban", { board: args.board }), "POST", {
      action: "block",
      board: args.board,
      taskId: args.taskId,
      reason: args.reason || args.summary || args.body || "Blocked pending human input.",
      vaultPath: args.vaultPath,
      kanbanFolder: args.kanbanFolder,
    });
  }
  if (action === "promote") {
    return callDashboard(routeWithQuery("/api/kanban", { board: args.board }), "POST", {
      action: "promote",
      board: args.board,
      taskId: args.taskId,
      force: args.force,
      dryRun: args.dryRun,
      reason: args.reason,
      // Agents call work_board; a parked Needs-You card can only be released by a human.
      actor: "agent",
      vaultPath: args.vaultPath,
      kanbanFolder: args.kanbanFolder,
    });
  }
  throw new Error(`Unknown work_board action: ${action}`);
}

async function callQueenBee(args = {}) {
  const action = String(args.action || "state");
  if (action === "state") {
    return callDashboard(
      routeWithQuery("/api/queen-bee", {
        vaultPath: args.vaultPath,
        brainServicesFolder: args.brainServicesFolder,
        kanbanFolder: args.kanbanFolder,
      }),
      "GET",
    );
  }
  if (action === "queue-task") {
    return callDashboard("/api/queen-bee", "POST", {
      message: args.message,
      source: args.source || "mcp:queen-bee",
      mode: args.mode,
      priority: args.priority,
      loop: args.loop,
      taskTitle: args.taskTitle || args.title,
      agentId: args.agentId,
      machineId: args.machineId,
      skills: args.skills,
      vaultPath: args.vaultPath,
      brainServicesFolder: args.brainServicesFolder,
      kanbanFolder: args.kanbanFolder,
    });
  }
  if (action === "decompose-prd") {
    return callDashboard("/api/queen-bee", "POST", {
      action: "decompose-prd",
      prd: args.prd || args.message,
      title: args.title || args.taskTitle,
      source: args.source || "mcp:queen-bee",
      priority: args.priority,
      projectId: args.projectId,
      maxTasks: args.maxTasks,
      preview: args.preview,
      vaultPath: args.vaultPath,
      brainServicesFolder: args.brainServicesFolder,
      kanbanFolder: args.kanbanFolder,
    });
  }
  if (action === "flow") return callQueenBeeFlow(args);
  throw new Error(`Unknown queen_bee action: ${action}`);
}

async function callQueenBeeFlow(args = {}) {
  const flowAction = String(args.flowAction || "list-templates");
  const readActions = new Set(["list-templates", "get-template", "list-runs", "get-run"]);
  if (readActions.has(flowAction)) {
    return callDashboard(
      routeWithQuery("/api/queen-bee/flow", {
        action: flowAction,
        id: args.templateId,
        runId: args.runId,
        vaultPath: args.vaultPath,
      }),
      "GET",
    );
  }
  return callDashboard("/api/queen-bee/flow", "POST", {
    action: flowAction,
    templateId: args.templateId,
    runId: args.runId,
    spec: args.spec,
    state: args.state,
    result: args.result,
    approved: args.approved,
    vaultPath: args.vaultPath,
  });
}

async function callWorkEvent(args = {}) {
  const action = String(args.action || "list");
  if (action === "list") return callDashboard("/api/work-events", "GET");
  if (action === "create-event") {
    return callDashboard("/api/work-events", "POST", {
      action: "create-event",
      name: args.eventName || args.name,
      payloadGuidelines: args.payloadGuidelines,
    });
  }
  if (action === "create-trigger") {
    return callDashboard("/api/work-events", "POST", {
      action: "create-trigger",
      eventName: args.eventName || args.name,
      board: args.board,
      title: args.title,
      body: args.body,
      assignee: args.assignee,
      tenant: args.tenant,
      priority: args.priority,
      status: args.status,
      skills: args.skills,
      targetMachine: args.targetMachine,
      emitEventName: args.emitEventName,
      enabled: args.enabled,
      idempotencyKey: args.idempotencyKey,
    });
  }
  if (action === "publish") {
    return callDashboard("/api/work-events", "POST", {
      action: "publish",
      eventName: args.eventName || args.name,
      payload: args.payload,
      faq: args.faq,
      source: args.source || "mcp:work-event",
      vaultPath: args.vaultPath,
      kanbanFolder: args.kanbanFolder,
    });
  }
  throw new Error(`Unknown work_event action: ${action}`);
}

async function callAgentChallenge(args = {}) {
  const action = String(args.action || "list");
  if (action === "list") {
    return callDashboard(
      routeWithQuery("/api/agent-challenges", {
        vaultPath: args.vaultPath,
        challengesFolder: args.challengesFolder,
      }),
      "GET",
    );
  }
  if (action === "get") {
    return callDashboard(
      routeWithQuery("/api/agent-challenges", {
        id: args.challengeId || args.id,
        vaultPath: args.vaultPath,
        challengesFolder: args.challengesFolder,
      }),
      "GET",
    );
  }
  return callDashboard("/api/agent-challenges", "POST", {
    source: args.source || "mcp:agent-challenge",
    ...args,
    action,
  });
}

async function requestHumanApproval(args = {}) {
  const title = String(args.title || "Human approval requested").trim();
  const body = formatApprovalRequest(args);
  return callDashboard(routeWithQuery("/api/kanban", { board: args.board }), "POST", {
    board: args.board,
    title,
    body,
    status: "needs-human",
    priority: args.priority || "high",
    assignee: "human",
    source: "mcp:human-approval",
    idempotencyKey: args.idempotencyKey,
    vaultPath: args.vaultPath,
    kanbanFolder: args.kanbanFolder,
  });
}

function routeWithQuery(route, params = {}) {
  const search = new URLSearchParams();
  for (const [key, value] of Object.entries(params)) {
    if (value === undefined || value === null || value === "") continue;
    search.set(key, String(value));
  }
  const query = search.toString();
  return query ? `${route}?${query}` : route;
}

function definedArgs(args, keys) {
  const output = {};
  for (const key of keys) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

const NANSEN_ROUTE_BY_ACTION = {
  "token-brief": "/api/nansen/token-brief",
  "wallet-brief": "/api/nansen/wallet-brief",
  "hyperliquid-brief": "/api/nansen/hyperliquid-brief",
  "market-scout": "/api/nansen/market-scout",
  "simple-template": "/api/nansen/simple-template",
  "complex-template": "/api/nansen/complex-template",
  agent: "/api/nansen/agent",
};

const NANSEN_BODY_KEYS = [
  "template",
  "chain",
  "chains",
  "tokenAddress",
  "tokenSymbol",
  "address",
  "entityName",
  "date",
  "timeframe",
  "filters",
  "includeLabels",
  "includeTransactions",
  "includeHistoricalBalances",
  "includePnlSummary",
  "aggregateByEntity",
  "labelType",
  "premiumLabels",
  "includeTrades",
  "includeIndicators",
  "includeLeaderboard",
  "text",
  "mode",
  "conversationId",
];

async function callNansenIntelligence(args = {}) {
  const action = String(args.action || "status");
  if (action === "status") return callDashboard("/api/nansen/status", "GET");
  const route = NANSEN_ROUTE_BY_ACTION[action];
  if (!route) throw new Error(`Unknown nansen_intelligence action: ${action}`);
  const body = definedArgs(args, NANSEN_BODY_KEYS);
  const billing = nansenBillingContext(args);
  if (billing) body.billing = billing;
  return callDashboard(route, "POST", body);
}

function nansenBillingContext(args = {}) {
  const billing = isObject(args.billing) ? { ...args.billing } : {};
  for (const key of ["creditSlug", "idempotencyKey", "legacyAccountIds"]) {
    if (args[key] !== undefined && billing[key] === undefined) billing[key] = args[key];
  }
  return Object.keys(billing).length ? billing : null;
}

function isObject(value) {
  return Boolean(value && typeof value === "object" && !Array.isArray(value));
}

function formatApprovalRequest(args = {}) {
  const lines = [
    args.request || "An agent requested human approval.",
    args.context ? `\nContext:\n${args.context}` : "",
    args.approvalKind ? `\nApproval kind: ${args.approvalKind}` : "",
    args.relatedTaskId ? `Related Work Board task: ${args.relatedTaskId}` : "",
    Array.isArray(args.options) && args.options.length
      ? `\nOptions:\n${args.options.map((option) => `- ${option}`).join("\n")}`
      : "",
    args.requestedBy ? `\nRequested by: ${args.requestedBy}` : "",
    "\nThis card records a requested decision only. It does not grant approval, execute the action, or bypass HivemindOS policy gates.",
  ];
  return lines.filter(Boolean).join("\n");
}

async function callTool(name, args = {}) {
  if (name === "app_builder") {
    const requiredConfirmation = {
      create: APP_BUILDER_CONFIRMATIONS.createProject,
      adopt: APP_BUILDER_CONFIRMATIONS.createProject,
      files_write: APP_BUILDER_CONFIRMATIONS.writeFile,
      files_rename: APP_BUILDER_CONFIRMATIONS.renameFile,
      files_delete: APP_BUILDER_CONFIRMATIONS.deleteFile,
      install: APP_BUILDER_CONFIRMATIONS.installDependencies,
      start: APP_BUILDER_CONFIRMATIONS.startRuntime,
      stop: APP_BUILDER_CONFIRMATIONS.stopRuntime,
      test_deploy: APP_BUILDER_CONFIRMATIONS.temporaryDeploy,
      hosting_publish: APP_BUILDER_CONFIRMATIONS.publishHosting,
      hosting_create: APP_BUILDER_CONFIRMATIONS.createHostingSite,
      hosting_save_version: APP_BUILDER_CONFIRMATIONS.saveHostingVersion,
      hosting_deploy_version: APP_BUILDER_CONFIRMATIONS.deployHostingVersion,
      hosting_rollback: APP_BUILDER_CONFIRMATIONS.rollbackHosting,
      hosting_access_set: APP_BUILDER_CONFIRMATIONS.changeHostingAccess,
      hosting_access_token: APP_BUILDER_CONFIRMATIONS.changeHostingAccess,
      hosting_bindings_set: APP_BUILDER_CONFIRMATIONS.changeHostingBindings,
      hosting_environment_set: APP_BUILDER_CONFIRMATIONS.changeHostingEnvironment,
      hosting_renew: APP_BUILDER_CONFIRMATIONS.renewHosting,
      hosting_unpublish: APP_BUILDER_CONFIRMATIONS.unpublishHosting,
    }[String(args.action || "")];
    if (requiredConfirmation && args.confirmation !== requiredConfirmation) {
      throw new Error(`app_builder ${args.action} requires confirmation ${requiredConfirmation}.`);
    }
    return callAppBuilder(args);
  }
  if (name === "list_hivemind_machines") {
    const data = await callDashboard("/api/fleet/discover?includeSnapshots=0&fresh=1", "GET");
    return {
      ok: true,
      machines: (data.machines || []).filter((machine) => machine.collector === "ready").map((machine) => ({
        key: machine.key,
        name: machine.device?.name || machine.key,
        collectorUrl: machine.device?.collectorUrl,
        os: machine.device?.os,
        self: machine.device?.self === true,
        runtimes: machine.capabilities?.runtimes || [],
        agents: (machine.agents || []).map((agent) => ({
          name: agent.name,
          runtime: agent.runtime,
          workerClass: agent.workerClass || "general",
          beeRole: agent.beeRole || "worker",
        })),
      })),
    };
  }
  if (name === "work_board") {
    return callWorkBoard(args);
  }
  if (name === "queen_bee") {
    return callQueenBee(args);
  }
  if (name === "work_event") {
    return callWorkEvent(args);
  }
  if (name === "agent_challenge") {
    return callAgentChallenge(args);
  }
  if (name === "request_human_approval") {
    return requestHumanApproval(args);
  }
  if (name === "crypto_capabilities") {
    return callDashboard("/api/crypto/capabilities", "POST", {
      action: "status",
      ...cryptoArgs(args),
    });
  }
  if (name === "x_api") {
    const method = String(args.method || "GET").toUpperCase(); if (method !== "GET" && args.confirmation !== "CONFIRM_X_API_CALL") throw new Error("x_api write calls require confirmation CONFIRM_X_API_CALL.");
    return callDashboard("/api/integrations/x-managed", "POST", { action: "proxy", creditAccountId: args.creditAccountId, connectionId: args.connectionId, slug: args.slug, method, path: args.path, query: args.query, json: args.json, confirmation: args.confirmation }); }
  if (name === "slack_send_message") {
    if (args.confirmation !== "CONFIRM_SLACK_SEND") throw new Error("slack_send_message requires confirmation CONFIRM_SLACK_SEND.");
    return callDashboard("/api/integrations/slack/send", "POST", { text: args.text, channel: args.channel, confirmation: args.confirmation }); }
  if (name === "google_slides_read") {
    return callDashboard("/api/integrations/google/slides", "POST", { mode: "read", ...args }); }
  if (name === "google_slides_edit") {
    if (args.confirmation !== "CONFIRM_GOOGLE_SLIDES_EDIT") throw new Error("google_slides_edit requires confirmation CONFIRM_GOOGLE_SLIDES_EDIT.");
    return callDashboard("/api/integrations/google/slides", "POST", { mode: "edit", ...args }); }
  if (name === "azure_resources") {
    return callDashboard("/api/integrations/azure/resources", "POST", {
      action: args.action || "subscriptions",
      subscriptionId: args.subscriptionId,
      resourceGroup: args.resourceGroup,
      resourceId: args.resourceId,
      apiVersion: args.apiVersion,
      top: args.top,
    });
  }
  if (name === "select_crypto_rail") {
    return callDashboard("/api/crypto/capabilities", "POST", {
      action: "select",
      ...cryptoArgs(args),
    });
  }
  if (name === "prepare_crypto_action") {
    return callDashboard("/api/crypto/capabilities", "POST", {
      action: "prepare",
      ...cryptoArgs(args),
    });
  }
  if (name === "nansen_intelligence") {
    return callNansenIntelligence(args);
  }
  if (name === "robinhood_agentic_read") {
    return callDashboard("/api/integrations/robinhood-mcp", "POST", {
      action: "read",
      tool: args.tool,
      arguments: args.arguments,
    });
  }
  if (name === "review_crypto_action") {
    return callDashboard("/api/crypto/clear-signing", "POST", clearSigningArgs(args));
  }
  if (name === "agent_crypto_identity") {
    return callDashboard("/api/crypto/agent-identity", "POST", agentIdentityArgs(args));
  }
  if (name === "crypto_risk_monitor") {
    return callDashboard("/api/crypto/risk-monitor", "POST", cryptoRiskArgs(args));
  }
  if (name === "send_usdc") {
    requireHiveActionExecutionPreflight(name, args);
    return callDashboard("/api/wallet/send", "POST", {
      agentId: args.agentId,
      toAddress: args.toAddress,
      amountUsd: args.amountUsd,
      confirmation: args.confirmation,
      approvalToken: args.approvalToken,
    });
  }
  if (name === "dex_swap") {
    requireHiveActionExecutionPreflight(name, args);
    return callDashboard("/api/trading/swap", "POST", {
      action: "execute",
      agentId: args.agentId,
      sellToken: args.sellToken,
      buyToken: args.buyToken,
      amountHuman: args.amountHuman,
      confirmation: args.confirmation,
      approvalToken: args.approvalToken,
    });
  }
  if (name === "stock_trade") {
    requireHiveActionExecutionPreflight(name, args);
    return callDashboard("/api/trading", "POST", {
      action: "execute",
      agentId: args.agentId,
      side: args.side,
      ticker: args.ticker || args.symbol,
      notionalUsd: args.notionalUsd ?? args.amountUsd,
      qty: args.qty ?? args.quantity,
      confirmation: args.confirmation,
      approvalToken: args.approvalToken,
    });
  }
  if (name === "hyperliquid_trade") {
    const action = args.action || (args.confirmation === "CONFIRM_HYPERLIQUID_BUILDER" ? "approve-builder" : args.confirmation === "CONFIRM_HYPERLIQUID_ORDER" ? "order" : "quote");
    requireHiveActionExecutionPreflight(name, { ...args, action });
    return callDashboard("/api/trading/hyperliquid", "POST", {
      action,
      agentId: args.agentId,
      coin: args.coin,
      marketType: args.marketType,
      assetId: args.assetId,
      side: args.side,
      orderType: args.orderType,
      notionalUsd: args.notionalUsd,
      size: args.size,
      limitPrice: args.limitPrice,
      timeInForce: args.timeInForce,
      triggerPx: args.triggerPx,
      triggerType: args.triggerType,
      triggerIsMarket: args.triggerIsMarket,
      grouping: args.grouping,
      clientOrderId: args.clientOrderId,
      reduceOnly: args.reduceOnly,
      slippageBps: args.slippageBps,
      orderId: args.orderId,
      oid: args.oid,
      cloid: args.cloid,
      fastCancel: args.fastCancel,
      alwaysPlace: args.alwaysPlace,
      scheduleCancelTime: args.scheduleCancelTime,
      leverage: args.leverage,
      marginMode: args.marginMode,
      marginDeltaUsd: args.marginDeltaUsd,
      transferType: args.transferType,
      amount: args.amount,
      amountUsd: args.amountUsd,
      destination: args.destination,
      token: args.token,
      toPerp: args.toPerp,
      twapMinutes: args.twapMinutes,
      twapRandomize: args.twapRandomize,
      twapId: args.twapId,
      aggregateByTime: args.aggregateByTime,
      confirmation: args.confirmation,
      approvalToken: args.approvalToken,
    });
  }
  if (name === "compile_brain_knowledge") {
    return callDashboard("/api/brain/knowledge", "POST", {
      action: "compile",
      actorKind: "agent",
      collaborationMode: args.collaborationMode || "agent-to-agent",
      ...knowledgeArgs(args),
    });
  }
  if (name === "brain_graph_overview") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "graph-overview", ...knowledgeArgs(args) });
  }
  if (name === "brain_search_knowledge") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "search", ...knowledgeArgs(args) });
  }
  if (name === "brain_get_node") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "get-node", ...knowledgeArgs(args) });
  }
  if (name === "brain_get_backlinks") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "get-backlinks", ...knowledgeArgs(args) });
  }
  if (name === "scan_brain_wiki_health") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "scan-health", ...knowledgeArgs(args) });
  }
  if (name === "fix_brain_wiki_issue") {
    return callDashboard("/api/brain/knowledge", "POST", { action: "fix-health", ...knowledgeArgs(args) });
  }
  if (name === "shared_brain_contract") {
    return callDashboard("/api/brain/knowledge", "POST", {
      action: "shared-contract",
      domain: args.domain,
      actorKind: args.actorKind,
      collaborationMode: args.collaborationMode,
      operation: args.operation,
      readonly: args.readonly,
      optedInDomain: args.optedInDomain,
    });
  }
  if (name === "clawbank_status") {
    return callDashboard("/api/clawbank", "GET");
  }
  if (name === "clawbank_list_tools") {
    return callDashboard("/api/clawbank/run", "GET");
  }
  if (name === "clawbank_read") {
    return callDashboard("/api/clawbank/run", "POST", {
      tool: args.tool,
      args: clawbankToolArgs(args.args),
      mode: "read",
    });
  }
  if (name === "clawbank_send_usdc") {
    requireHiveActionExecutionPreflight(name, args);
    return callDashboard("/api/clawbank/wallet", "POST", {
      action: "send_usdc",
      toAddress: args.toAddress,
      amount: args.amount,
      confirmation: args.confirmation,
    });
  }
  if (name === "clawbank_trade") {
    requireHiveActionExecutionPreflight(name, args);
    return callDashboard("/api/clawbank/trading", "POST", {
      action: "swap",
      baseToken: args.baseToken,
      side: args.side,
      amountUsdc: args.amountUsdc,
      maxSlippageBps: args.maxSlippageBps,
      confirmation: args.confirmation,
    });
  }
  if (name === "clawbank_money_transfer") {
    requireHiveActionExecutionPreflight(name, args);
    return callDashboard("/api/clawbank/money", "POST", {
      action: "transfer",
      chain: args.chain,
      toAddress: args.toAddress,
      amount: args.amount,
      confirmation: args.confirmation,
    });
  }
  if (name === "clawbank_call") {
    requireHiveActionExecutionPreflight(name, args);
    return callDashboard("/api/clawbank/run", "POST", {
      tool: args.tool,
      args: clawbankToolArgs(args.args),
      confirmation: args.confirmation,
    });
  }
  if (name === "code_search_graph") {
    return callDashboard("/api/code-intelligence", "POST", {
      action: "search-graph",
      query: args.query,
      namePattern: args.namePattern,
      label: args.label,
      filePattern: args.filePattern,
      limit: args.limit,
      repoPath: args.repoPath,
    });
  }
  if (name === "code_trace_path") {
    return callDashboard("/api/code-intelligence", "POST", {
      action: "trace-path",
      functionName: args.functionName,
      direction: args.direction,
      depth: args.depth,
      repoPath: args.repoPath,
    });
  }
  if (name === "code_get_architecture") {
    return callDashboard("/api/code-intelligence", "POST", {
      action: "get-architecture",
      path: args.path,
      aspects: args.aspects,
      repoPath: args.repoPath,
    });
  }
  if (name === "code_get_snippet") {
    return callDashboard("/api/code-intelligence", "POST", {
      action: "get-code-snippet",
      qualifiedName: args.qualifiedName,
      filePath: args.filePath,
      startLine: args.startLine,
      endLine: args.endLine,
      includeNeighbors: args.includeNeighbors,
      repoPath: args.repoPath,
    });
  }
  if (name === "code_detect_changes") {
    return callDashboard("/api/code-intelligence", "POST", {
      action: "detect-changes",
      baseRef: args.baseRef,
      since: args.since,
      scope: args.scope,
      depth: args.depth,
      repoPath: args.repoPath,
    });
  }
  if (name === "code_index_repository") {
    return callDashboard("/api/code-intelligence", "POST", {
      action: "index-repository",
      repoPath: args.repoPath,
      mode: args.mode,
      persistence: args.persistence,
    });
  }
  const actionByTool = {
    plan_handoff: "plan",
    handoff_file: "send-file",
    handoff_file_task: "send-file-task",
    handoff_task: "send-task",
  };
  const action = actionByTool[name];
  if (!action) throw new Error(`Unknown tool: ${name}`);
  return callDashboard("/api/handoff", "POST", {
    action,
    target: args.target,
    files: Array.isArray(args.files) ? args.files.map(expandHome) : [],
    task: args.task,
    note: args.note,
    dryRun: name === "plan_handoff",
    allowAmbiguous: args.allowAmbiguous === true,
  });
}

function cryptoArgs(args) {
  const output = {};
  for (const key of ["intent", "agentId", "preferredProvider", "wallet", "amountUsd", "asset", "url", "method", "headers", "body", "recipientAddress", "amount", "fromChain", "toChain", "fromAsset", "toAsset"]) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

function clearSigningArgs(args) {
  const output = {};
  for (const key of ["kind", "intent", "provider", "agentId", "network", "asset", "amount", "amountUsd", "recipientAddress", "toAddress", "url", "method", "prompt", "confirmation", "policy", "paymentRequirement", "metadata"]) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

function agentIdentityArgs(args) {
  const output = {};
  for (const key of ["action", "id", "agentId", "displayName", "handle", "walletAddress", "network", "chainId", "ensName", "erc8004EntityId", "serviceEndpoint", "x402Endpoint", "capabilities", "proofs", "status"]) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

function cryptoRiskArgs(args) {
  const output = {};
  for (const key of ["agentId", "wallet", "identity", "env", "repo", "dns", "multisig", "infrastructure"]) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

function knowledgeArgs(args) {
  const output = {};
  for (const key of ["domain", "vaultPath", "slug", "title", "content", "summary", "sourcePath", "tags", "entities", "concepts", "collaborationMode", "optedInDomain", "issueId", "query", "limit", "types"]) {
    if (args[key] !== undefined) output[key] = args[key];
  }
  return output;
}

function clawbankToolArgs(value) {
  return value && typeof value === "object" && !Array.isArray(value) ? value : {};
}

function expandHome(value) {
  const text = String(value || "");
  if (text === "~") return os.homedir();
  if (text.startsWith("~/") || text.startsWith("~\\")) return path.join(os.homedir(), text.slice(2));
  return text;
}

function respond(id, result) {
  process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", id, result })}\n`);
}

function respondError(id, error) {
  process.stdout.write(`${JSON.stringify({
    jsonrpc: "2.0",
    id,
    error: {
      code: -32000,
      message: error?.payload?.error || error?.message || String(error),
      data: error?.payload,
    },
  })}\n`);
}

async function handle(message) {
  const id = message.id;
  try {
    if (message.method === "initialize") {
      respond(id, {
        protocolVersion: "2024-11-05",
        serverInfo: { name: "hivemindos", version: "0.1.0" },
        capabilities: { tools: {} },
      });
      return;
    }
    if (message.method === "tools/list") {
      respond(id, { tools: TOOLS });
      return;
    }
    if (message.method === "tools/call") {
      const result = await callTool(message.params?.name, message.params?.arguments || {});
      respond(id, {
        content: [{ type: "text", text: JSON.stringify(result, null, 2) }],
        structuredContent: result,
      });
      return;
    }
    if (message.method === "ping") {
      respond(id, {});
      return;
    }
    if (id !== undefined) respondError(id, new Error(`Unsupported method: ${message.method}`));
  } catch (error) {
    respondError(id, error);
  }
}

const rl = readline.createInterface({ input: process.stdin, terminal: false });
rl.on("line", (line) => {
  if (!line.trim()) return;
  let message = null;
  try {
    message = JSON.parse(line);
  } catch {
    return;
  }
  void handle(message);
});
