#!/usr/bin/env node
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import http from "node:http";
import { spawnSync } from "node:child_process";

const MEMORY_FOLDER = "Memory/Distillations/Agent Memory";
const INDEX_PATH = "Operations/Brain Services/Agent Memory Index.jsonl";
const FULL_VAULT_INDEX_PATH = "Operations/Brain Services/Full Vault Search Index.jsonl";
const WORKSPACES_FILE = path.join(os.homedir(), ".hivemindos", "workspaces.json");
const MAX_VAULT_FILES = 50000;
const MAX_VAULT_BYTES = 1024 * 1024;
const MAX_INDEX_TERMS_PER_NOTE = 900;
const LOW_SIGNAL_WORDS = new Set(["agent", "agents", "brain", "hivemindos", "memory", "memories", "note", "notes", "shared", "vault"]);
const EXCLUDE_PARTS = new Set([".git", ".obsidian", ".trash", ".hivemindos-transfers", "node_modules"]);
const EXCLUDE_PREFIXES = [
  "Operations/Runtime Mirrors/",
  "Operations/Brain Services/Agent Memory Index.jsonl",
  "Operations/Brain Services/Agent Memory Proofs.jsonl",
  FULL_VAULT_INDEX_PATH,
  "Operations/Vault Migrations/",
  "Archive/",
];

function usage() {
  console.error(`Usage:
  hive-brain answer "query" [--limit N] [--scope tiered|agent-memory|full-vault] [--workspace ID] [--json]
  hive-brain recall "query" [--limit N] [--scope tiered|agent-memory|full-vault] [--workspace ID] [--json]
  hive-brain remember --type TYPE --title TITLE --content TEXT [--workspace ID] [--tag TAG] [--source TEXT]
  hive-brain evolve --memory-id ID --content TEXT [--workspace ID] [--title TITLE] [--reason TEXT]

Examples:
  hive-brain answer "what fruit does liam like?"
  hive-brain recall "BYOK Agent Calls" --scope full-vault --limit 5
  hive-brain evolve --memory-id mem-... --content "Updated durable memory"
  hive-brain answer "query" --no-api
`);
}

function expandHome(value) {
  if (!value) return value;
  if (value === "~") return os.homedir();
  if (value.startsWith("~/") || value.startsWith("~\\")) return path.join(os.homedir(), value.slice(2));
  return value;
}

function readWorkspaces() {
  try {
    const data = JSON.parse(fs.readFileSync(process.env.HIVE_WORKSPACES_FILE ? expandHome(process.env.HIVE_WORKSPACES_FILE) : WORKSPACES_FILE, "utf8"));
    return Array.isArray(data.workspaces) ? data : null;
  } catch {
    return null;
  }
}

function workspaceById(id) {
  const store = readWorkspaces();
  if (!store) return null;
  const requested = id || process.env.HIVE_WORKSPACE_ID || process.env.NEXT_PUBLIC_HIVE_WORKSPACE_ID || store.activeWorkspaceId || "main";
  return store.workspaces.find((workspace) => workspace?.id === requested)
    || store.workspaces.find((workspace) => workspace?.id === "main")
    || null;
}

function defaultVaultPath(workspaceId) {
  const workspace = workspaceById(workspaceId);
  if (workspace?.vaultPath) return expandHome(workspace.vaultPath);
  return expandHome(process.env.NEXT_PUBLIC_OBSIDIAN_VAULT_PATH)
    || path.join(os.homedir(), "Documents", "Obsidian", "hivemindos-vault");
}

function parseArgs(argv) {
  const input = {
    action: argv[2] || "answer",
    queryParts: [],
    tags: [],
    limit: 5,
    scope: undefined,
    json: false,
    workspaceId: process.env.HIVE_WORKSPACE_ID || process.env.NEXT_PUBLIC_HIVE_WORKSPACE_ID || "",
    vaultPath: defaultVaultPath(),
    vaultExplicit: false,
  };
  for (let index = 3; index < argv.length; index += 1) {
    const arg = argv[index];
    const next = argv[index + 1];
    if (arg === "--help" || arg === "-h") {
      input.help = true;
    } else if (arg === "--json") {
      input.json = true;
    } else if (arg === "--no-api") {
      input.noApi = true;
    } else if (arg === "--limit" || arg === "-n") {
      input.limit = Number(next || input.limit);
      index += 1;
    } else if (arg === "--scope") {
      input.scope = next;
      index += 1;
    } else if (arg === "--vault") {
      input.vaultPath = expandHome(next);
      input.vaultExplicit = true;
      index += 1;
    } else if (arg === "--workspace") {
      input.workspaceId = next || "";
      index += 1;
    } else if (arg === "--type") {
      input.type = next;
      index += 1;
    } else if (arg === "--title") {
      input.title = next;
      index += 1;
    } else if (arg === "--content") {
      input.content = next;
      index += 1;
    } else if (arg === "--memory-id") {
      input.memoryId = next;
      index += 1;
    } else if (arg === "--supersedes") {
      input.supersedes = String(next || "").split(",").map((id) => id.trim()).filter(Boolean);
      index += 1;
    } else if (arg === "--reason" || arg === "--evolution-reason") {
      input.evolutionReason = next;
      index += 1;
    } else if (arg === "--evolution-type") {
      input.evolutionType = next;
      index += 1;
    } else if (arg === "--cognitive-stage") {
      input.cognitiveStage = next;
      index += 1;
    } else if (arg === "--source-type") {
      input.sourceType = next;
      index += 1;
    } else if (arg === "--evidence-count") {
      input.evidenceCount = Number(next || "");
      index += 1;
    } else if (arg === "--source") {
      input.source = next;
      index += 1;
    } else if (arg === "--agent-name") {
      input.agentName = next;
      index += 1;
    } else if (arg === "--agent-id") {
      input.agentId = next;
      index += 1;
    } else if (arg === "--runtime") {
      input.runtime = next;
      index += 1;
    } else if (arg === "--machine-name") {
      input.machineName = next;
      index += 1;
    } else if (arg === "--machine-id") {
      input.machineId = next;
      index += 1;
    } else if (arg === "--tailnet-id") {
      input.tailnetId = next;
      index += 1;
    } else if (arg === "--tailnet-name") {
      input.tailnetName = next;
      index += 1;
    } else if (arg === "--tailnet-dns-name") {
      input.tailnetDnsName = next;
      index += 1;
    } else if (arg === "--collector-url") {
      input.collectorUrl = next;
      index += 1;
    } else if (arg === "--session-id") {
      input.sessionId = next;
      index += 1;
    } else if (arg === "--project") {
      input.project = next;
      index += 1;
    } else if (arg === "--tag" || arg === "--tags") {
      input.tags.push(...String(next || "").split(",").map((tag) => tag.trim()).filter(Boolean));
      index += 1;
    } else if (arg.startsWith("--")) {
      throw new Error(`Unknown option: ${arg}`);
    } else {
      input.queryParts.push(arg);
    }
  }
  input.query = input.queryParts.join(" ").trim();
  if (!input.vaultExplicit) input.vaultPath = defaultVaultPath(input.workspaceId);
  return input;
}

function candidateApiBases() {
  const values = [];
  if (process.env.HIVEMINDOS_BRAIN_URL) values.push(process.env.HIVEMINDOS_BRAIN_URL);
  if (process.env.HIVEMINDOS_APP_URL) values.push(process.env.HIVEMINDOS_APP_URL);
  if (process.env.NEXT_PUBLIC_APP_URL) values.push(process.env.NEXT_PUBLIC_APP_URL);
  if (process.env.PORT) values.push(`http://127.0.0.1:${process.env.PORT}`);
  for (const port of [5020, 5021, 5022, 5023, 5024, 5025]) values.push(`http://127.0.0.1:${port}`);
  return [...new Set(values.map((value) => value.replace(/\/+$/, "")))];
}

function requestJson(base, method, body, searchParams) {
  return new Promise((resolve, reject) => {
    const url = new URL("/api/brain/memory", base);
    for (const [key, value] of Object.entries(searchParams || {})) {
      if (value !== undefined && value !== "") url.searchParams.set(key, String(value));
    }
    const payload = body ? JSON.stringify(body) : "";
    const req = http.request(url, {
      method,
      headers: payload ? {
        "content-type": "application/json",
        "content-length": Buffer.byteLength(payload),
      } : undefined,
      timeout: 4500,
    }, (res) => {
      let data = "";
      res.setEncoding("utf8");
      res.on("data", (chunk) => { data += chunk; });
      res.on("end", () => {
        if (res.statusCode < 200 || res.statusCode >= 300) {
          reject(new Error(`${base} returned HTTP ${res.statusCode}`));
          return;
        }
        try {
          resolve(JSON.parse(data));
        } catch {
          reject(new Error(`${base} returned non-JSON memory response`));
        }
      });
    });
    req.on("timeout", () => req.destroy(new Error(`${base} timed out`)));
    req.on("error", reject);
    if (payload) req.write(payload);
    req.end();
  });
}

async function callApi(input) {
  if (input.noApi || /^(1|true|yes|on)$/i.test(process.env.HIVE_BRAIN_NO_API || "")) {
    throw new Error("API disabled by --no-api/HIVE_BRAIN_NO_API.");
  }
  const bases = candidateApiBases();
  let lastError = null;
  for (const base of bases) {
    try {
      if (input.action === "remember") {
        return await requestJson(base, "POST", {
          action: "remember",
          type: input.type,
          title: input.title,
          content: input.content,
          tags: input.tags,
          source: input.source || "hive-brain cli",
          vaultPath: input.vaultPath,
          agentName: input.agentName,
          agentId: input.agentId,
          runtime: input.runtime,
          machineName: input.machineName,
          machineId: input.machineId,
          tailnetId: input.tailnetId,
          tailnetName: input.tailnetName,
          tailnetDnsName: input.tailnetDnsName,
          collectorUrl: input.collectorUrl,
          sessionId: input.sessionId,
          project: input.project,
          proof: "auto",
        });
      }
      if (input.action === "evolve") {
        return await requestJson(base, "POST", {
          action: "evolve",
          memoryId: input.memoryId,
          supersedes: input.supersedes,
          type: input.type,
          title: input.title,
          content: input.content,
          tags: input.tags,
          source: input.source || "hive-brain cli",
          cognitiveStage: input.cognitiveStage,
          evidenceCount: input.evidenceCount,
          sourceType: input.sourceType,
          evolutionType: input.evolutionType,
          evolutionReason: input.evolutionReason,
          vaultPath: input.vaultPath,
          agentName: input.agentName,
          agentId: input.agentId,
          runtime: input.runtime,
          machineName: input.machineName,
          machineId: input.machineId,
          tailnetId: input.tailnetId,
          tailnetName: input.tailnetName,
          tailnetDnsName: input.tailnetDnsName,
          collectorUrl: input.collectorUrl,
          sessionId: input.sessionId,
          project: input.project,
          proof: "auto",
        });
      }
      return await requestJson(base, "GET", null, {
        mode: input.action === "recall" ? "recall" : "answer",
        q: input.query,
        limit: input.limit,
        scope: input.scope,
        vaultPath: input.vaultPath,
      });
    } catch (error) {
      lastError = error;
    }
  }
  throw lastError || new Error("No HivemindOS memory API base could be reached.");
}

function parseFrontmatter(markdown) {
  const match = markdown.match(/^---\n([\s\S]*?)\n---\n?/);
  const fields = new Map();
  if (!match) return { fields, body: markdown };
  for (const line of match[1].split("\n")) {
    const field = line.match(/^([A-Za-z0-9_-]+):\s*(.*)$/);
    if (!field) continue;
    const raw = field[2].trim();
    try {
      fields.set(field[1], JSON.parse(raw));
    } catch {
      fields.set(field[1], raw.replace(/^["']|["']$/g, ""));
    }
  }
  return { fields, body: markdown.slice(match[0].length) };
}

function bodyContent(body) {
  return body.replace(/^#\s+.+$/m, "").replace(/^## Metadata[\s\S]*$/m, "").trim();
}

function compact(value, max = 260) {
  const redacted = redactSecrets(String(value || "").replace(/\s+/g, " ").trim());
  if (redacted.length <= max) return redacted;
  return `${redacted.slice(0, Math.max(0, max - 3)).trim()}...`;
}

function redactSecrets(text) {
  return text
    .replace(/\b(sk|pk|rk|ak)-[A-Za-z0-9]{20,}\b/g, "[REDACTED_API_KEY]")
    .replace(/Bearer\s+[A-Za-z0-9\-._~+/]{20,}/gi, "Bearer [REDACTED]")
    .replace(/eyJ[A-Za-z0-9\-_]{10,}\.[A-Za-z0-9\-_]{10,}\.[A-Za-z0-9\-_]{10,}/g, "[REDACTED_JWT]")
    .replace(/-----BEGIN\s+(RSA\s+)?PRIVATE\s+KEY-----[\s\S]+?-----END\s+(RSA\s+)?PRIVATE\s+KEY-----/g, "[REDACTED_PRIVATE_KEY]")
    .replace(/(password|passwd|secret|api_key|apikey|token)\s*[:=]\s*["']?[A-Za-z0-9!@#$%^&*\-_+]{8,}["']?/gi, "$1=[REDACTED]")
    .replace(/https?:\/\/100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])(?:\.\d{1,3}){2}(?::\d+)?(?:\/[^\s"'`<>)\]]*)?/g, "[REDACTED_TAILNET_URL]")
    .replace(/\b100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])(?:\.\d{1,3}){2}\b/g, "[REDACTED_TAILNET_IP]");
}

function words(value) {
  return String(value || "")
    .toLowerCase()
    .split(/[^a-z0-9_-]+/)
    .filter((word) => word.length > 2 && !LOW_SIGNAL_WORDS.has(word));
}

function score(record, query) {
  const queryText = query.trim().toLowerCase();
  const queryWords = words(query);
  const haystack = [record.title, record.content, record.type, record.tags?.join(" "), record.source, record.notePath].filter(Boolean).join(" ").toLowerCase();
  const title = record.title.toLowerCase();
  const content = record.content.toLowerCase();
  const matched = new Set();
  let value = 0;
  if (queryText && haystack.includes(queryText)) {
    value += 30;
    matched.add("exact-query");
  }
  for (const word of queryWords) {
    if (title.includes(word)) { value += 8; matched.add(word); }
    if ((record.tags || []).some((tag) => tag.includes(word))) { value += 6; matched.add(word); }
    if (content.includes(word)) { value += 4; matched.add(word); }
    if ((record.source || "").toLowerCase().includes(word) || record.notePath.toLowerCase().includes(word)) { value += 2; matched.add(word); }
  }
  if (record.searchScore) value += Math.min(30, Math.max(0, Math.round(record.searchScore)));
  value += Math.round((record.confidence || 0.62) * 10);
  if (record.notePath.startsWith(`${MEMORY_FOLDER}/`)) value += 4;
  return { score: value, matched: [...matched] };
}

function rel(root, file) {
  return path.relative(root, file).split(path.sep).join("/");
}

function shouldSkip(root, file, isDir) {
  const notePath = rel(root, file);
  const name = path.basename(file);
  if (EXCLUDE_PARTS.has(name)) return true;
  if (name.startsWith(".")) return true;
  if (isDir && EXCLUDE_PREFIXES.some((prefix) => prefix.endsWith("/") && (notePath === prefix.slice(0, -1) || notePath.startsWith(prefix)))) return true;
  if (!isDir && EXCLUDE_PREFIXES.some((prefix) => notePath === prefix || notePath.startsWith(prefix))) return true;
  return false;
}

function walk(root, dir = root, output = []) {
  if (output.length >= MAX_VAULT_FILES) return output;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (output.length >= MAX_VAULT_FILES) break;
    const file = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!shouldSkip(root, file, true)) walk(root, file, output);
    } else if (entry.isFile() && entry.name.endsWith(".md") && !shouldSkip(root, file, false)) {
      output.push(file);
    }
  }
  return output;
}

// Strict search policy: ripgrep first, plain grep fallback, full fs walk only
// when neither binary is available.
let contentSearchBinary;

function detectContentSearchBinary() {
  if (contentSearchBinary !== undefined) return contentSearchBinary;
  contentSearchBinary = null;
  for (const binary of ["rg", "grep"]) {
    const probe = spawnSync(binary, ["--version"], { stdio: "ignore" });
    if (!probe.error && probe.status === 0) {
      contentSearchBinary = binary;
      break;
    }
  }
  return contentSearchBinary;
}

function searchTerms(query) {
  return [...new Set(String(query || "").toLowerCase().split(/[^a-z0-9]+/).filter((word) => word.length >= 3))].slice(0, 16);
}

function escapeRegex(term) {
  return term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function searchVaultFiles(root, query) {
  const terms = searchTerms(query);
  if (!terms.length) return null;
  const binary = detectContentSearchBinary();
  if (!binary) return null;
  const pattern = terms.map(escapeRegex).join("|");
  const args = binary === "rg"
    ? ["-li", "--no-messages", "--no-ignore-vcs", "-g", "*.md", ...[...EXCLUDE_PARTS].flatMap((dir) => ["-g", `!${dir}/**`]), "-e", pattern, "."]
    : ["-rli", "-E", pattern, "--include=*.md", ...[...EXCLUDE_PARTS].map((dir) => `--exclude-dir=${dir}`), "."];
  const result = spawnSync(binary, args, { cwd: root, encoding: "utf8", maxBuffer: 16 * 1024 * 1024, timeout: 10000 });
  // Exit status 1 means "no matches" for both rg and grep.
  if (result.error || (result.status !== 0 && result.status !== 1)) return null;
  return String(result.stdout || "")
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean)
    .map((file) => path.join(root, file))
    .filter((file) => !shouldSkip(root, file, false))
    .slice(0, MAX_VAULT_FILES);
}

function collectionForPath(notePath) {
  const first = notePath.split("/")[0]?.toLowerCase() || "root";
  return ["intake", "memory", "projects", "synthesis", "ideas", "operations", "skills", "templates"].includes(first) ? first : "root";
}

function termCounts(terms) {
  const counts = new Map();
  for (const term of terms) counts.set(term, (counts.get(term) || 0) + 1);
  return Object.fromEntries([...counts.entries()]
    .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]))
    .slice(0, MAX_INDEX_TERMS_PER_NOTE));
}

function fullVaultIndexRecord(root, file) {
  const st = fs.statSync(file);
  if (st.size > MAX_VAULT_BYTES) return null;
  const markdown = fs.readFileSync(file, "utf8");
  const { fields, body } = parseFrontmatter(markdown);
  const notePath = rel(root, file);
  const title = String(fields.get("title") || (body.match(/^#\s+(.+)$/m) || [])[1] || path.basename(file, ".md")).trim();
  const headings = [...body.matchAll(/^#{1,4}\s+(.+)$/gm)].map((match) => match[1].trim()).slice(0, 32);
  const tags = Array.isArray(fields.get("tags")) ? fields.get("tags").map((tag) => String(tag).toLowerCase()) : [];
  const frontmatterType = typeof fields.get("type") === "string" ? String(fields.get("type")) : undefined;
  const tokens = words([title, headings.join(" "), tags.join(" "), frontmatterType, body.replace(/^#\s+.+$/gm, " ")].filter(Boolean).join("\n"));
  if (!tokens.length) return null;
  return {
    schema: "hivemindos.full-vault-search.v1",
    path: notePath,
    collection: collectionForPath(notePath),
    title,
    headings,
    tags,
    frontmatterType,
    mtimeMs: st.mtimeMs,
    size: st.size,
    indexedByteLimit: MAX_VAULT_BYTES,
    documentLength: tokens.length,
    terms: termCounts(tokens),
    excerpt: compact(body.replace(/^#\s+.+$/gm, " ")),
  };
}

function rebuildFullVaultIndex(root) {
  const records = [];
  for (const file of walk(root)) {
    if (rel(root, file).startsWith(`${MEMORY_FOLDER}/`)) continue;
    const record = fullVaultIndexRecord(root, file);
    if (record) records.push(record);
  }
  const file = path.join(root, FULL_VAULT_INDEX_PATH);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, records.map((record) => JSON.stringify(record)).join("\n") + (records.length ? "\n" : ""), "utf8");
  return records;
}

function readFullVaultIndex(root) {
  const file = path.join(root, FULL_VAULT_INDEX_PATH);
  if (!fs.existsSync(file)) return rebuildFullVaultIndex(root);
  const records = [];
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    if (!line.trim()) continue;
    try {
      const parsed = JSON.parse(line);
      if (
        parsed.schema === "hivemindos.full-vault-search.v1" &&
        parsed.path &&
        parsed.terms &&
        parsed.indexedByteLimit === MAX_VAULT_BYTES
      ) records.push(parsed);
    } catch {
      // Ignore corrupt generated rows; explicit rebuild repairs the index.
    }
  }
  return records.length ? records : rebuildFullVaultIndex(root);
}

function parseFullVaultQuery(query) {
  const lexLines = String(query || "").split("\n")
    .map((line) => line.trim())
    .filter((line) => /^lex:/i.test(line))
    .map((line) => line.replace(/^lex:\s*/i, ""));
  const source = lexLines.length ? lexLines.join(" ") : String(query || "");
  const phrases = [...source.matchAll(/"([^"]+)"/g)].map((match) => match[1].toLowerCase()).filter(Boolean);
  const terms = [];
  const negativeTerms = [];
  const collections = [];
  const pathPrefixes = [];
  for (const raw of source.replace(/"([^"]+)"/g, " ").split(/\s+/).filter(Boolean)) {
    const value = raw.toLowerCase().replace(/^["']|["']$/g, "");
    const [key, ...rest] = value.split(":");
    const filter = rest.join(":");
    if (rest.length && filter) {
      if (key === "collection" || key === "c") collections.push(filter);
      else if (key === "path") pathPrefixes.push(filter.replace(/^\/+/, ""));
      else terms.push(...words(filter));
    } else if (value.startsWith("-")) {
      negativeTerms.push(...words(value.slice(1)));
    } else {
      terms.push(...words(value));
    }
  }
  return { terms: [...new Set(terms)], negativeTerms: [...new Set(negativeTerms)], phrases, collections, pathPrefixes };
}

function searchFullVaultIndex(root, query, limit = 400) {
  const parsed = parseFullVaultQuery(query);
  const records = readFullVaultIndex(root).filter((record) => {
    if (parsed.collections.length && !parsed.collections.includes(record.collection)) return false;
    if (parsed.pathPrefixes.length && !parsed.pathPrefixes.some((prefix) => record.path.toLowerCase().startsWith(prefix))) return false;
    if (parsed.negativeTerms.some((term) => record.terms[term])) return false;
    return true;
  });
  const averageLength = records.reduce((sum, record) => sum + record.documentLength, 0) / Math.max(1, records.length);
  const docFreq = new Map(parsed.terms.map((term) => [term, records.reduce((count, record) => count + (record.terms[term] ? 1 : 0), 0)]));
  const hasSearchTerms = parsed.terms.length || parsed.phrases.length;
  function coverageScore(matched) {
    if (parsed.terms.length <= 1) return 0;
    const matchedTermCount = parsed.terms.filter((term) => matched.has(term)).length;
    if (!matchedTermCount) return 0;
    const coverage = matchedTermCount / parsed.terms.length;
    let score = coverage * 6;
    if (matchedTermCount === parsed.terms.length) score += 3;
    if (parsed.terms.length >= 4 && coverage < 0.5) score -= (parsed.terms.length - matchedTermCount) * 0.75;
    return score;
  }
  return records.map((record) => {
    const matched = new Set();
    let searchScore = 0;
    const title = record.title.toLowerCase();
    const headings = (record.headings || []).join(" ").toLowerCase();
    const haystack = `${title} ${headings} ${record.path.toLowerCase()} ${record.excerpt.toLowerCase()}`;
    for (const term of parsed.terms) {
      const frequency = record.terms[term] || 0;
      if (!frequency) continue;
      const df = docFreq.get(term) || 1;
      const idf = Math.log(1 + (records.length - df + 0.5) / (df + 0.5));
      const denominator = frequency + 1.2 * (1 - 0.75 + 0.75 * (record.documentLength / Math.max(1, averageLength)));
      searchScore += idf * ((frequency * 2.2) / denominator);
      if (title.includes(term)) searchScore += 3;
      if (headings.includes(term)) searchScore += 1.5;
      if (record.path.toLowerCase().includes(term)) searchScore += 1;
      matched.add(term);
    }
    for (const phrase of parsed.phrases) {
      if (haystack.includes(phrase)) {
        searchScore += title.includes(phrase) ? 8 : 4;
        matched.add(`"${phrase}"`);
      }
    }
    searchScore += coverageScore(matched);
    return { ...record, searchScore: Math.round(searchScore * 100) / 10, matched: [...matched] };
  }).filter((hit) => !hasSearchTerms || hit.matched.length)
    .sort((left, right) => right.searchScore - left.searchScore || right.mtimeMs - left.mtimeMs)
    .slice(0, limit);
}

function recordsFromIndex(root) {
  const file = path.join(root, INDEX_PATH);
  if (!fs.existsSync(file)) return [];
  const byId = new Map();
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    if (!line.trim()) continue;
    try {
      const entry = JSON.parse(line);
      if (entry.action !== "remember" || !entry.id || !entry.title || !entry.content || !entry.notePath) continue;
      byId.set(entry.id, {
        id: entry.id,
        title: entry.title,
        content: entry.content,
        type: entry.memoryType || "context",
        status: entry.status || "active",
        cognitiveStage: entry.cognitiveStage,
        supersedes: Array.isArray(entry.supersedes) ? entry.supersedes : [],
        supersededBy: Array.isArray(entry.supersededBy) ? entry.supersededBy : [],
        evolutionRootId: entry.evolutionRootId,
        evolutionType: entry.evolutionType,
        evolutionReason: entry.evolutionReason,
        confidence: Number(entry.confidence || 0.7),
        tags: Array.isArray(entry.tags) ? entry.tags : [],
        metaTags: Array.isArray(entry.metaTags) ? entry.metaTags : [],
        source: entry.source,
        createdAt: entry.createdAt,
        updatedAt: entry.updatedAt,
        notePath: entry.notePath,
      });
    } catch {
      // Ignore corrupt JSONL rows.
    }
  }
  return [...byId.values()];
}

function recordFromMarkdown(root, file, typedOnly = false) {
  const st = fs.statSync(file);
  if (st.size > MAX_VAULT_BYTES) return null;
  const markdown = fs.readFileSync(file, "utf8");
  const { fields, body } = parseFrontmatter(markdown);
  const notePath = rel(root, file);
  if (typedOnly && fields.get("type") !== "agent-memory") return null;
  const title = String(fields.get("title") || (body.match(/^#\s+(.+)$/m) || [])[1] || path.basename(file, ".md")).trim();
  const content = bodyContent(body) || markdown.replace(/^---\n[\s\S]*?\n---\n?/, "").trim();
  if (!content) return null;
  return {
    id: notePath,
    title,
    content,
    type: fields.get("memoryType") || fields.get("type") || "context",
    status: fields.get("status") || "active",
    cognitiveStage: fields.get("cognitiveStage"),
    supersedes: Array.isArray(fields.get("supersedes")) ? fields.get("supersedes") : [],
    supersededBy: Array.isArray(fields.get("supersededBy")) ? fields.get("supersededBy") : [],
    evolutionRootId: fields.get("evolutionRootId"),
    evolutionType: fields.get("evolutionType"),
    evolutionReason: fields.get("evolutionReason"),
    confidence: typedOnly ? Number(fields.get("confidence") || 0.7) : 0.62,
    tags: Array.isArray(fields.get("tags")) ? fields.get("tags") : notePath.split("/").slice(0, 3).map((part) => part.toLowerCase()),
    metaTags: Array.isArray(fields.get("metaTags")) ? fields.get("metaTags") : [],
    source: `Vault note: ${notePath}`,
    createdAt: fields.get("createdAt"),
    updatedAt: fields.get("updatedAt"),
    notePath,
  };
}

function fallbackRecall(input) {
  const root = path.resolve(input.vaultPath);
  if (!fs.existsSync(root)) throw new Error(`Vault path not found: ${root}`);
  const limit = Math.min(Math.max(Math.trunc(Number(input.limit || 5)), 1), 50);
  const scope = String(input.scope || "tiered").toLowerCase();
  let memoryRecords = recordsFromIndex(root);
  if (!memoryRecords.length) {
    const folder = path.join(root, MEMORY_FOLDER);
    if (fs.existsSync(folder)) memoryRecords = walk(folder).map((file) => recordFromMarkdown(root, file, true)).filter(Boolean);
  }
  const activeMemoryRecords = memoryRecords.filter((record) => !record.status || record.status === "active");
  const memoryHits = attachEvolutionChains(rank(activeMemoryRecords, input.query, limit), memoryRecords);
  const strong = memoryHits[0] && (memoryHits[0].score >= 32 || (memoryHits[0].score >= 24 && memoryHits[0].confidence >= 0.85 && memoryHits[0].matched.length >= 2));
  if (scope === "agent-memory" || (scope !== "full-vault" && strong)) {
    return { ok: true, source: "local-fallback", recallScope: "agent-memory", augmentedFromVault: false, hits: memoryHits };
  }
  const byPath = new Map();
  const indexedHits = input.query?.trim() ? searchFullVaultIndex(root, input.query, 400) : [];
  const fullVaultFiles = indexedHits.length ? indexedHits.map((hit) => path.join(root, hit.path)) : searchVaultFiles(root, input.query) ?? walk(root);
  const scoreByPath = new Map(indexedHits.map((hit) => [hit.path, hit.searchScore]));
  const collectionByPath = new Map(indexedHits.map((hit) => [hit.path, hit.collection]));
  for (const file of fullVaultFiles) {
    if (rel(root, file).startsWith(`${MEMORY_FOLDER}/`)) continue;
    if (!fs.existsSync(file)) continue;
    let record = null;
    try {
      record = recordFromMarkdown(root, file, false);
    } catch {
      continue;
    }
    if (record) {
      record.searchScore = scoreByPath.get(record.notePath);
      record.searchCollection = collectionByPath.get(record.notePath);
      byPath.set(record.notePath, record);
    }
  }
  for (const record of activeMemoryRecords) byPath.set(record.notePath, record);
  return {
    ok: true,
    source: "local-fallback",
    recallScope: "full-vault",
    augmentedFromVault: scope !== "full-vault",
    memoryHitCount: memoryHits.length,
    hits: attachEvolutionChains(rank([...byPath.values()], input.query, limit), memoryRecords),
  };
}

function chainItem(record) {
  return {
    id: record.id,
    title: record.title,
    content: record.content,
    status: record.status || "active",
    notePath: record.notePath,
    cognitiveStage: record.cognitiveStage,
    evolutionType: record.evolutionType,
    evolutionReason: record.evolutionReason,
  };
}

function traceEvolutionChain(record, byId, seen = new Set()) {
  if (!record || seen.has(record.id)) return [];
  seen.add(record.id);
  const ancestors = (record.supersedes || [])
    .map((id) => byId.get(id))
    .filter(Boolean)
    .sort((left, right) => String(right.createdAt || "").localeCompare(String(left.createdAt || "")))
    .flatMap((ancestor) => traceEvolutionChain(ancestor, byId, seen));
  return [record, ...ancestors];
}

function attachEvolutionChains(hits, allMemoryRecords) {
  const byId = new Map(allMemoryRecords.map((record) => [record.id, record]));
  return hits.map((hit) => {
    const source = byId.get(hit.id);
    if (!source) return hit;
    const chain = traceEvolutionChain(source, byId);
    if (chain.length <= 1) return hit;
    return { ...hit, evolutionChain: chain.map(chainItem) };
  });
}

function rank(records, query, limit) {
  return records
    .map((record) => {
      const scored = score(record, query);
      return { ...record, score: scored.score, matched: scored.matched, excerpt: compact(record.content) };
    })
    .filter((hit) => !query.trim() || hit.matched.length)
    .sort((left, right) => right.score - left.score)
    .slice(0, limit);
}

function formatResult(result, action) {
  if (action === "recall") {
    return result.hits.map((hit, index) => {
      const chain = formatEvolutionChain(hit);
      return `${index + 1}. ${hit.title}\n   path: ${hit.notePath}\n   score: ${hit.score}; matched: ${(hit.matched || []).join(", ") || "none"}${hit.evolutionChain?.length > 1 ? `; evolved: ${hit.evolutionChain.length} versions` : ""}\n   ${hit.excerpt}${chain ? `\n${chain}` : ""}`;
    }).join("\n\n")
      || "No matching shared-brain memories or vault notes were found.";
  }
  return [
    `Recall scope: ${result.recallScope || "unknown"}${result.augmentedFromVault ? " (augmented from full vault)" : ""}`,
    ...(result.hits || []).slice(0, 6).map((hit, index) => {
      const evolved = hit.evolutionChain?.length > 1 ? `, evolved ${hit.evolutionChain.length} versions` : "";
      const chain = formatEvolutionChain(hit);
      return `${index + 1}. ${hit.title} (${hit.type || "context"}, score ${hit.score}${evolved})\n   Path: ${hit.notePath}\n   ${hit.excerpt}${chain ? `\n${chain}` : ""}`;
    }),
  ].join("\n") || "No matching shared-brain memories or vault notes were found.";
}

function formatEvolutionChain(hit) {
  if (!hit.evolutionChain || hit.evolutionChain.length <= 1) return "";
  return [
    "   Evolution:",
    ...hit.evolutionChain.map((item, index) => {
      const label = index === 0 ? "Latest" : `Previous ${index}`;
      const reason = item.evolutionReason ? `; reason: ${item.evolutionReason}` : "";
      const stage = item.cognitiveStage ? `; stage: ${item.cognitiveStage}` : "";
      return `   - ${label}: ${item.title} (${item.status || "active"}${stage}${reason}) - ${compact(item.content, 180)}`;
    }),
  ].join("\n");
}

async function main() {
  const input = parseArgs(process.argv);
  if (input.help || !["answer", "recall", "remember", "evolve"].includes(input.action)) {
    usage();
    process.exit(input.help ? 0 : 2);
  }
  if (!["remember", "evolve"].includes(input.action) && !input.query) throw new Error("A query is required.");
  if (input.action === "remember" && !input.content) throw new Error("remember requires --content.");
  if (input.action === "evolve" && !input.content) throw new Error("evolve requires --content.");
  if (input.action === "evolve" && !input.memoryId && !input.supersedes?.length) throw new Error("evolve requires --memory-id or --supersedes.");
  let result;
  try {
    result = await callApi(input);
    result.source = result.source || "api";
  } catch (error) {
    if (input.action === "remember" || input.action === "evolve") throw error;
    result = fallbackRecall(input);
    result.apiError = error instanceof Error ? error.message : String(error);
  }
  if (input.json) {
    console.log(JSON.stringify(result, null, 2));
  } else if (input.action === "remember") {
    console.log(`Remembered: ${result.record?.title || input.title || compact(input.content, 80)}`);
    if (result.record?.notePath) console.log(`Path: ${result.record.notePath}`);
  } else if (input.action === "evolve") {
    console.log(`Evolved: ${result.record?.title || input.title || compact(input.content, 80)}`);
    if (result.record?.notePath) console.log(`Path: ${result.record.notePath}`);
    if (result.superseded?.length) console.log(`Superseded: ${result.superseded.map((record) => record.id).join(", ")}`);
  } else {
    console.log(formatResult(result, input.action));
  }
}

main().catch((error) => {
  console.error(`hive-brain: ${error instanceof Error ? error.message : String(error)}`);
  process.exit(1);
});
