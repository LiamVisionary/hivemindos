function usage() {
  console.error(`Usage:
  hive-brain answer "query" [--limit N] [--min-score N] [--scope tiered|agent-memory|full-vault] [--workspace ID] [--json]
  hive-brain recall "query" [--limit N] [--scope tiered|agent-memory|full-vault] [--include-operational] [--workspace ID] [--json]
  hive-brain remember --type TYPE --title TITLE --content TEXT [--memory-key KEY] [--tag TAG] [--source TEXT] [--allow-duplicate]
  hive-brain evolve --memory-id ID --content TEXT [--title TITLE] [--reason TEXT]
  hive-brain record-operation --title TITLE --content TEXT [--operation-key KEY] [--outcome success|failure|blocked|cancelled] [--task-id ID] [--failure-key KEY]
  hive-brain mine-patterns [--since ISO_DATE] [--project PROJECT] [--enqueue] [--json]
  hive-brain record-usage --memory-ids ID[,ID...] [--usage-type retrieved|final-answer] [--query TEXT] [--context TEXT]
  hive-brain health [--json]
  hive-brain consolidate [--apply-archives] [--json]
  hive-brain rebuild-index [--json]
  hive-brain flush-pending

Examples:
  hive-brain answer "what fruit does liam like?"
  hive-brain recall "BYOK Agent Calls" --scope full-vault --limit 5
  hive-brain evolve --memory-id mem-... --content "Updated durable memory"
  hive-brain record-operation --title "Provider request" --content "Request timed out" --outcome failure --failure-key provider-timeout --task-id task-123
  hive-brain mine-patterns --json
  hive-brain record-usage --memory-ids mem-abc --usage-type final-answer --context "cited in reply"
  hive-brain answer "query" --no-api

Writes that cannot reach the app API are queued to ~/.hivemindos/brain-write-pending.jsonl
and delivered on the next successful contact (or via flush-pending).
`);
}

function expandHome(value) {
  if (!value) return value;
  if (value === "~") return os.homedir();
  if (value.startsWith("~/") || value.startsWith("~\\")) return path.join(os.homedir(), value.slice(2));
  return value;
}

function readWorkspaces() {
  try {
    const data = JSON.parse(fs.readFileSync(process.env.HIVE_WORKSPACES_FILE ? expandHome(process.env.HIVE_WORKSPACES_FILE) : WORKSPACES_FILE, "utf8"));
    return Array.isArray(data.workspaces) ? data : null;
  } catch {
    return null;
  }
}

function workspaceById(id) {
  const store = readWorkspaces();
  if (!store) return null;
  const requested = id || process.env.HIVE_WORKSPACE_ID || process.env.NEXT_PUBLIC_HIVE_WORKSPACE_ID || store.activeWorkspaceId || "main";
  return store.workspaces.find((workspace) => workspace?.id === requested)
    || store.workspaces.find((workspace) => workspace?.id === "main")
    || null;
}

function defaultVaultPath(workspaceId) {
  const workspace = workspaceById(workspaceId);
  if (workspace?.vaultPath) return expandHome(workspace.vaultPath);
  return expandHome(process.env.NEXT_PUBLIC_OBSIDIAN_VAULT_PATH)
    || path.join(os.homedir(), "Documents", "Obsidian", "hivemindos-vault");
}

// Provenance autofill: the contract asks writers to attach agent/machine
// context, but almost no CLI callers pass the flags — detect what we can.
function detectRuntime() {
  if (process.env.HIVE_BRAIN_RUNTIME) return process.env.HIVE_BRAIN_RUNTIME;
  if (process.env.CLAUDECODE || process.env.CLAUDE_CODE_ENTRYPOINT) return "claude-code";
  if (process.env.CODEX_SANDBOX || process.env.CODEX_HOME) return "codex";
  return "cli";
}

function applyProvenanceDefaults(input) {
  if (!input.machineName) input.machineName = os.hostname().replace(/\.local$/i, "");
  if (!input.runtime) input.runtime = detectRuntime();
  if (!input.agentName && process.env.HIVE_AGENT_NAME) input.agentName = process.env.HIVE_AGENT_NAME;
  if (!input.sessionId) input.sessionId = process.env.CLAUDE_SESSION_ID || process.env.HIVE_SESSION_ID || undefined;
  return input;
}

function parseArgs(argv) {
  const input = {
    action: argv[2] || "answer",
    queryParts: [],
    tags: [],
    memoryIds: [],
    limit: 5,
    scope: undefined,
    json: false,
    workspaceId: process.env.HIVE_WORKSPACE_ID || process.env.NEXT_PUBLIC_HIVE_WORKSPACE_ID || "",
    vaultPath: defaultVaultPath(),
    vaultExplicit: false,
  };
  for (let index = 3; index < argv.length; index += 1) {
    const arg = argv[index];
    const next = argv[index + 1];
    if (arg === "--help" || arg === "-h") {
      input.help = true;
    } else if (arg === "--json") {
      input.json = true;
    } else if (arg === "--no-api") {
      input.noApi = true;
    } else if (arg === "--no-queue") {
      input.noQueue = true;
    } else if (arg === "--allow-duplicate") {
      input.allowDuplicate = true;
    } else if (arg === "--retry-blocked") {
      input.retryBlocked = true;
    } else if (arg === "--allow-sensitive") {
      input.allowSensitiveContent = true;
    } else if (arg === "--apply-archives") {
      input.applyArchives = true;
    } else if (arg === "--enqueue") {
      input.enqueueProposals = true;
    } else if (arg === "--include-operational") {
      input.includeOperational = true;
    } else if (arg === "--limit" || arg === "-n") {
      input.limit = Number(next || input.limit);
      index += 1;
    } else if (arg === "--min-score") {
      input.minScore = Number(next);
      index += 1;
    } else if (arg === "--scope") {
      input.scope = next;
      index += 1;
    } else if (arg === "--vault") {
      input.vaultPath = expandHome(next);
      input.vaultExplicit = true;
      index += 1;
    } else if (arg === "--workspace") {
      input.workspaceId = next || "";
      index += 1;
    } else if (arg === "--type") {
      input.type = next;
      index += 1;
    } else if (arg === "--title") {
      input.title = next;
      index += 1;
    } else if (arg === "--content") {
      input.content = next;
      index += 1;
    } else if (arg === "--memory-id") {
      input.memoryId = next;
      index += 1;
    } else if (arg === "--memory-key") {
      input.memoryKey = next;
      index += 1;
    } else if (arg === "--operation-key") {
      input.operationKey = next;
      index += 1;
    } else if (arg === "--failure-key") {
      input.failureKey = next;
      index += 1;
    } else if (arg === "--outcome") {
      input.outcome = next;
      index += 1;
    } else if (arg === "--task-id") {
      input.taskId = next;
      index += 1;
    } else if (arg === "--since") {
      input.since = next;
      index += 1;
    } else if (arg === "--memory-ids") {
      input.memoryIds.push(...String(next || "").split(",").map((id) => id.trim()).filter(Boolean));
      index += 1;
    } else if (arg === "--usage-type") {
      input.usageType = next;
      index += 1;
    } else if (arg === "--context" || arg === "--usage-context") {
      input.usageContext = next;
      index += 1;
    } else if (arg === "--query") {
      input.usageQuery = next;
      index += 1;
    } else if (arg === "--supersedes") {
      input.supersedes = String(next || "").split(",").map((id) => id.trim()).filter(Boolean);
      index += 1;
    } else if (arg === "--reason" || arg === "--evolution-reason") {
      input.evolutionReason = next;
      index += 1;
    } else if (arg === "--evolution-type") {
      input.evolutionType = next;
      index += 1;
    } else if (arg === "--cognitive-stage") {
      input.cognitiveStage = next;
      index += 1;
    } else if (arg === "--source-type") {
      input.sourceType = next;
      index += 1;
    } else if (arg === "--evidence-count") {
      input.evidenceCount = Number(next || "");
      index += 1;
    } else if (arg === "--source") {
      input.source = next;
      index += 1;
    } else if (arg === "--agent-name") {
      input.agentName = next;
      index += 1;
    } else if (arg === "--agent-id") {
      input.agentId = next;
      index += 1;
    } else if (arg === "--runtime") {
      input.runtime = next;
      index += 1;
    } else if (arg === "--machine-name") {
      input.machineName = next;
      index += 1;
    } else if (arg === "--machine-id") {
      input.machineId = next;
      index += 1;
    } else if (arg === "--tailnet-id") {
      input.tailnetId = next;
      index += 1;
    } else if (arg === "--tailnet-name") {
      input.tailnetName = next;
      index += 1;
    } else if (arg === "--tailnet-dns-name") {
      input.tailnetDnsName = next;
      index += 1;
    } else if (arg === "--collector-url") {
      input.collectorUrl = next;
      index += 1;
    } else if (arg === "--session-id") {
      input.sessionId = next;
      index += 1;
    } else if (arg === "--project") {
      input.project = next;
      index += 1;
    } else if (arg === "--tag" || arg === "--tags") {
      input.tags.push(...String(next || "").split(",").map((tag) => tag.trim()).filter(Boolean));
      index += 1;
    } else if (arg.startsWith("--")) {
      throw new Error(`Unknown option: ${arg}`);
    } else {
      input.queryParts.push(arg);
    }
  }
  input.query = input.queryParts.join(" ").trim();
  if (!input.vaultExplicit) input.vaultPath = defaultVaultPath(input.workspaceId);
  return input;
}

function candidateApiBases() {
  const values = [];
  if (process.env.HIVEMINDOS_BRAIN_URL) values.push(process.env.HIVEMINDOS_BRAIN_URL);
  if (process.env.HIVEMINDOS_APP_URL) values.push(process.env.HIVEMINDOS_APP_URL);
  if (process.env.NEXT_PUBLIC_APP_URL) values.push(process.env.NEXT_PUBLIC_APP_URL);
  if (process.env.PORT) values.push(`http://127.0.0.1:${process.env.PORT}`);
  // Dev servers auto-increment past busy ports; probe the whole 5020-5030 range.
  for (let port = 5020; port <= 5030; port += 1) values.push(`http://127.0.0.1:${port}`);
  return [...new Set(values.map((value) => value.replace(/\/+$/, "")))];
}

const DEVICE_TOKEN_KEY = "HIVEMINDOS_DASHBOARD_DEVICE_TOKEN";
let cachedDeviceTokens = null;
let activeDeviceToken = "";

function envFileValue(filePath, key) {
  try {
    const line = fs.readFileSync(filePath, "utf8").split(/\r?\n/).find((entry) => entry.startsWith(`${key}=`));
    return line?.slice(key.length + 1).trim() ?? "";
  } catch {
    return "";
  }
}

// The dashboard API is auth-gated (src/proxy.ts), and the server's expected
// token depends on how it was launched: a plainly launched dev server loads
// the checkout's .env.local, while one launched from a shared-env shell keeps
// that shell's token. Collect every known source — explicit env first, then
// the checkout's .env.local, then the shared hive env — and let callApi try
// each on an auth rejection.
function candidateDeviceTokens() {
  if (cachedDeviceTokens) return cachedDeviceTokens;
  const scriptRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
  const roots = [process.env.HIVE_ENV_PROJECT_ROOT, scriptRoot].filter(Boolean);
  const values = [
    process.env[DEVICE_TOKEN_KEY]?.trim(),
    ...roots.map((root) => envFileValue(path.join(root, ".env.local"), DEVICE_TOKEN_KEY)),
    envFileValue(path.join(os.homedir(), ".hivemindos", ".env"), DEVICE_TOKEN_KEY),
  ].filter((value) => value && value.length >= 24);
  cachedDeviceTokens = [...new Set(values)];
  return cachedDeviceTokens;
}

function requestJson(base, method, body, searchParams) {
  return new Promise((resolve, reject) => {
    const url = new URL("/api/brain/memory", base);
    for (const [key, value] of Object.entries(searchParams || {})) {
      if (value !== undefined && value !== "") url.searchParams.set(key, String(value));
    }
    const payload = body ? JSON.stringify(body) : "";
    const req = http.request(url, {
      method,
      headers: {
        ...(activeDeviceToken ? { "x-hivemindos-device-token": activeDeviceToken } : {}),
        ...(payload ? {
          "content-type": "application/json",
          "content-length": Buffer.byteLength(payload),
        } : {}),
      },
      timeout: 4500,
    }, (res) => {
      let data = "";
      res.setEncoding("utf8");
      res.on("data", (chunk) => { data += chunk; });
      res.on("end", () => {
        let parsed = null;
        try {
          parsed = data ? JSON.parse(data) : null;
        } catch {
          parsed = null;
        }
        if (res.statusCode < 200 || res.statusCode >= 300) {
          const error = new Error(parsed?.blockReason || parsed?.error || `${base} returned HTTP ${res.statusCode}`);
          error.status = res.statusCode;
          error.body = parsed;
          reject(error);
          return;
        }
        if (parsed === null) {
          reject(new Error(`${base} returned non-JSON memory response`));
          return;
        }
        resolve(parsed);
      });
    });
    req.on("timeout", () => req.destroy(new Error(`${base} timed out`)));
    req.on("error", reject);
    if (payload) req.write(payload);
    req.end();
  });
}

function writePayload(input, action) {
  applyProvenanceDefaults(input);
  return {
    action,
    type: input.type,
    title: input.title,
    content: input.content,
    tags: input.tags,
    source: input.source || "hive-brain cli",
    vaultPath: input.vaultPath,
    memoryId: input.memoryId,
    memoryKey: input.memoryKey,
    operationKey: input.operationKey,
    failureKey: input.failureKey,
    outcome: input.outcome,
    taskId: input.taskId,
    supersedes: input.supersedes,
    cognitiveStage: input.cognitiveStage,
    evidenceCount: input.evidenceCount,
    sourceType: input.sourceType,
    evolutionType: input.evolutionType,
    evolutionReason: input.evolutionReason,
    allowDuplicate: input.allowDuplicate,
    allowSensitiveContent: input.allowSensitiveContent,
    agentName: input.agentName,
    agentId: input.agentId,
    runtime: input.runtime,
    machineName: input.machineName,
    machineId: input.machineId,
    tailnetId: input.tailnetId,
    tailnetName: input.tailnetName,
    tailnetDnsName: input.tailnetDnsName,
    collectorUrl: input.collectorUrl,
    sessionId: input.sessionId,
    project: input.project,
    proof: "auto",
  };
}

async function callApi(input) {
  if (input.noApi || /^(1|true|yes|on)$/i.test(process.env.HIVE_BRAIN_NO_API || "")) {
    const error = new Error("API disabled by --no-api/HIVE_BRAIN_NO_API.");
    error.apiDisabled = true;
    throw error;
  }
  const bases = candidateApiBases();
  const tokens = candidateDeviceTokens();
  // Empty string = one unauthenticated attempt (older or ungated servers).
  const tokenAttempts = tokens.length ? tokens : [""];
  let lastError = null;
  let lastHttpError = null;
  for (const base of bases) {
    for (const token of tokenAttempts) {
      activeDeviceToken = token;
      try {
        let result;
        if (input.action === "remember" || input.action === "evolve" || input.action === "record-operation") {
          result = await requestJson(base, "POST", writePayload(input, input.action));
        } else if (input.action === "mine-patterns") {
          result = await requestJson(base, "POST", {
            action: "mine-patterns",
            enqueueProposals: Boolean(input.enqueueProposals),
            since: input.since,
            project: input.project,
            query: input.usageQuery,
            limit: input.limit,
          });
        } else if (input.action === "record-usage") {
          result = await requestJson(base, "POST", {
            action: "record-usage",
            vaultPath: input.vaultPath,
            memoryIds: input.memoryIds,
            usageType: input.usageType,
            query: input.usageQuery,
            usageContext: input.usageContext,
            agentName: input.agentName,
            runtime: input.runtime,
            sessionId: input.sessionId,
          });
        } else if (input.action === "health") {
          result = await requestJson(base, "GET", null, { mode: "health", vaultPath: input.vaultPath });
        } else if (input.action === "consolidate") {
          result = await requestJson(base, "POST", {
            action: "consolidate",
            vaultPath: input.vaultPath,
            applyArchives: Boolean(input.applyArchives),
          });
        } else if (input.action === "rebuild-index") {
          result = await requestJson(base, "POST", { action: "rebuild-index", vaultPath: input.vaultPath });
        } else {
          result = await requestJson(base, "GET", null, {
            mode: input.action === "recall" ? "recall" : "answer",
            q: input.query,
            limit: input.limit,
            minScore: input.minScore,
            scope: input.scope,
            includeOperational: input.includeOperational ? 1 : undefined,
            vaultPath: input.vaultPath,
          });
        }
        result.apiBase = base;
        await flushPendingWrites(base).catch(() => undefined);
        return result;
      } catch (error) {
        // An authoritative application-level rejection (duplicate gate,
        // validation) must surface, not fall back or try other ports.
        if (error?.status && error.body && (error.body.blocked || error.status === 400 || error.status === 409)) throw error;
        if (error?.status) lastHttpError = error;
        lastError = error;
        // Only an auth rejection is worth retrying with another token; any
        // other failure moves on to the next base.
        if (error?.status !== 401 && error?.status !== 403) break;
      }
    }
  }
  throw lastHttpError || lastError || new Error("No HivemindOS memory API base could be reached.");
}

// --- offline write queue -----------------------------------------------------

function readPendingWrites() {
  try {
    const raw = fs.readFileSync(PENDING_WRITES_FILE, "utf8");
    const cutoff = Date.now() - PENDING_WRITE_TTL_MS;
    return raw.split("\n").filter(Boolean).map((line) => {
      try {
        return JSON.parse(line);
      } catch {
        return null;
      }
    }).filter((entry) => entry?.payload && Date.parse(entry.queuedAt || "") > cutoff);
  } catch {
    return [];
  }
}

function writePendingWrites(entries) {
  fs.mkdirSync(path.dirname(PENDING_WRITES_FILE), { recursive: true });
  fs.writeFileSync(PENDING_WRITES_FILE, entries.length ? `${entries.map((entry) => JSON.stringify(entry)).join("\n")}\n` : "", "utf8");
}

function enqueuePendingWrite(payload) {
  const entries = readPendingWrites();
  entries.push({ queuedAt: new Date().toISOString(), payload });
  writePendingWrites(entries);
  return entries.length;
}

async function flushPendingWrites(base, { retryBlocked = false } = {}) {
  const entries = readPendingWrites();
  if (!entries.length) return { flushed: 0, blocked: 0, remaining: 0, blockedEntries: [] };
  const remaining = [];
  let flushed = 0;
  let blocked = 0;
  for (const [index, entry] of entries.entries()) {
    if (flushed >= MAX_PENDING_FLUSH_PER_RUN) {
      remaining.push(...entries.slice(index));
      break;
    }
    // Entries the app rejected (duplicate gate/validation) are NEVER silently
    // dropped: they stay in the queue marked blocked until reviewed,
    // retried with --retry-blocked, or expired by the queue TTL.
    if (entry.blockedAt && !retryBlocked) {
      blocked += 1;
      remaining.push(entry);
      continue;
    }
    try {
      await requestJson(base, "POST", retryBlocked && entry.blockedAt ? { ...entry.payload, allowDuplicate: true } : entry.payload);
      flushed += 1;
    } catch (error) {
      if (process.env.HIVE_BRAIN_DEBUG) console.error(`flush error via ${base}: ${error?.status ?? ""} ${error?.message}`);
      if (error?.status && (error.status === 400 || error.status === 409)) {
        blocked += 1;
        remaining.push({
          ...entry,
          blockedAt: new Date().toISOString(),
          blockedStatus: error.status,
          blockedReason: error.body?.blockReason || error.body?.error || error.message,
        });
        continue;
      }
      remaining.push(entry);
    }
  }
  writePendingWrites(remaining);
  return {
    flushed,
    blocked,
    remaining: remaining.length,
    blockedEntries: remaining.filter((entry) => entry.blockedAt),
  };
}

// --- local fallback: shared parsing helpers ----------------------------------

function parseFrontmatter(markdown) {
  const match = markdown.match(/^---\n([\s\S]*?)\n---\n?/);
  const fields = new Map();
  if (!match) return { fields, body: markdown };
  for (const line of match[1].split("\n")) {
    const field = line.match(/^([A-Za-z0-9_-]+):\s*(.*)$/);
    if (!field) continue;
    const raw = field[2].trim();
    try {
      fields.set(field[1], JSON.parse(raw));
    } catch {
      fields.set(field[1], raw.replace(/^["']|["']$/g, ""));
    }
  }
  return { fields, body: markdown.slice(match[0].length) };
}

function bodyContent(body) {
  return body.replace(/^#\s+.+$/m, "").replace(/^## Metadata[\s\S]*$/m, "").trim();
}

function compact(value, max = 260) {
  const redacted = redactSecrets(String(value || "").replace(/\s+/g, " ").trim());
  if (redacted.length <= max) return redacted;
  return `${redacted.slice(0, Math.max(0, max - 3)).trim()}...`;
}

function words(value) {
  return queryWordsForRecall(value, LOW_SIGNAL_WORDS);
}

function rel(root, file) {
  return path.relative(root, file).split(path.sep).join("/");
}

function shouldSkip(root, file, isDir) {
  const notePath = rel(root, file);
  const name = path.basename(file);
  if (EXCLUDE_PARTS.has(name)) return true;
  if (name.startsWith(".")) return true;
  // Sync-conflict copies are unresolved duplicates, not knowledge.
  if (name.includes(".sync-conflict-")) return true;
  if (isDir && EXCLUDE_PREFIXES.some((prefix) => prefix.endsWith("/") && (notePath === prefix.slice(0, -1) || notePath.startsWith(prefix)))) return true;
  if (!isDir && EXCLUDE_PREFIXES.some((prefix) => notePath === prefix || notePath.startsWith(prefix))) return true;
  return false;
}

function walk(root, dir = root, output = []) {
  if (output.length >= MAX_VAULT_FILES) return output;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (output.length >= MAX_VAULT_FILES) break;
    const file = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!shouldSkip(root, file, true)) walk(root, file, output);
    } else if (entry.isFile() && entry.name.endsWith(".md") && !shouldSkip(root, file, false)) {
      output.push(file);
    }
  }
  return output;
}

// Strict search policy: ripgrep first, plain grep fallback, full fs walk only
// when neither binary is available.
let contentSearchBinary;

function detectContentSearchBinary() {
  if (contentSearchBinary !== undefined) return contentSearchBinary;
  contentSearchBinary = null;
  for (const binary of ["rg", "grep"]) {
    const probe = spawnSync(binary, ["--version"], { stdio: "ignore" });
    if (!probe.error && probe.status === 0) {
      contentSearchBinary = binary;
      break;
    }
  }
  return contentSearchBinary;
}

function searchTerms(query) {
  return [...new Set(String(query || "").toLowerCase().split(/[^a-z0-9]+/).filter((word) => word.length >= 3))].slice(0, 16);
}

function escapeRegex(term) {
  return term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function searchVaultFiles(root, query) {
  const terms = searchTerms(query);
  if (!terms.length) return null;
  const binary = detectContentSearchBinary();
  if (!binary) return null;
  const pattern = terms.map(escapeRegex).join("|");
  const args = binary === "rg"
    ? ["-li", "--no-messages", "--no-ignore-vcs", "-g", "*.md", ...[...EXCLUDE_PARTS].flatMap((dir) => ["-g", `!${dir}/**`]), "-e", pattern, "."]
    : ["-rli", "-E", pattern, "--include=*.md", ...[...EXCLUDE_PARTS].map((dir) => `--exclude-dir=${dir}`), "."];
  const result = spawnSync(binary, args, { cwd: root, encoding: "utf8", maxBuffer: 16 * 1024 * 1024, timeout: 10000 });
  // Exit status 1 means "no matches" for both rg and grep.
  if (result.error || (result.status !== 0 && result.status !== 1)) return null;
  return String(result.stdout || "")
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean)
    .map((file) => path.join(root, file))
    .filter((file) => !shouldSkip(root, file, false))
    .slice(0, MAX_VAULT_FILES);
}

function collectionForPath(notePath) {
  const first = notePath.split("/")[0]?.toLowerCase() || "root";
  return ["intake", "memory", "projects", "synthesis", "ideas", "operations", "skills", "templates"].includes(first) ? first : "root";
}

function termCounts(terms) {
  const counts = new Map();
  for (const term of terms) counts.set(term, (counts.get(term) || 0) + 1);
  return Object.fromEntries([...counts.entries()]
    .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]))
    .slice(0, MAX_INDEX_TERMS_PER_NOTE));
}

function fullVaultIndexRecord(root, file) {
  const st = fs.statSync(file);
  if (st.size > MAX_VAULT_BYTES) return null;
  const markdown = fs.readFileSync(file, "utf8");
  const { fields, body } = parseFrontmatter(markdown);
  const notePath = rel(root, file);
  const title = String(fields.get("title") || (body.match(/^#\s+(.+)$/m) || [])[1] || path.basename(file, ".md")).trim();
  const headings = [...body.matchAll(/^#{1,4}\s+(.+)$/gm)].map((match) => match[1].trim()).slice(0, 32);
  const tags = Array.isArray(fields.get("tags")) ? fields.get("tags").map((tag) => String(tag).toLowerCase()) : [];
  const frontmatterType = typeof fields.get("type") === "string" ? String(fields.get("type")) : undefined;
  const tokens = words([title, headings.join(" "), tags.join(" "), frontmatterType, body.replace(/^#\s+.+$/gm, " ")].filter(Boolean).join("\n"));
  if (!tokens.length) return null;
  return {
    schema: "hivemindos.full-vault-search.v1",
    path: notePath,
    collection: collectionForPath(notePath),
    title,
    headings,
    tags,
    frontmatterType,
    mtimeMs: st.mtimeMs,
    size: st.size,
    indexedByteLimit: MAX_VAULT_BYTES,
    documentLength: tokens.length,
    terms: termCounts(tokens),
    excerpt: compact(body.replace(/^#\s+.+$/gm, " ")),
  };
}

function rebuildFullVaultIndex(root) {
  const records = [];
  for (const file of walk(root)) {
    if (rel(root, file).startsWith(`${MEMORY_FOLDER}/`)) continue;
    const record = fullVaultIndexRecord(root, file);
    if (record) records.push(record);
  }
  const file = path.join(root, FULL_VAULT_INDEX_PATH);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const payload = records.map((record) => JSON.stringify(record)).join("\n") + (records.length ? "\n" : "");
  atomicWriteFileSync(file, payload);
  return records;
}

function readFullVaultIndex(root) {
  const file = path.join(root, FULL_VAULT_INDEX_PATH);
  if (!fs.existsSync(file)) return rebuildFullVaultIndex(root);
  // Staleness guard: notes written after the last rebuild would otherwise be
  // invisible to indexed recall.
  if (FULL_VAULT_INDEX_TTL_MS > 0) {
    try {
      const st = fs.statSync(file);
      if (Date.now() - st.mtimeMs > FULL_VAULT_INDEX_TTL_MS) return rebuildFullVaultIndex(root);
    } catch {
      return rebuildFullVaultIndex(root);
    }
  }
  const records = [];
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    if (!line.trim()) continue;
    try {
      const parsed = JSON.parse(line);
      if (
        parsed.schema === "hivemindos.full-vault-search.v1" &&
        parsed.path &&
        parsed.terms &&
        parsed.indexedByteLimit === MAX_VAULT_BYTES &&
        !parsed.path.includes(".sync-conflict-")
      ) records.push(parsed);
    } catch {
      // Ignore corrupt generated rows; explicit rebuild repairs the index.
    }
  }
  return records.length ? records : rebuildFullVaultIndex(root);
}

function parseFullVaultQuery(query) {
  const lexLines = String(query || "").split("\n")
    .map((line) => line.trim())
    .filter((line) => /^lex:/i.test(line))
    .map((line) => line.replace(/^lex:\s*/i, ""));
  const source = lexLines.length ? lexLines.join(" ") : String(query || "");
  const phrases = [...source.matchAll(/"([^"]+)"/g)].map((match) => match[1].toLowerCase()).filter(Boolean);
  const terms = [];
  const negativeTerms = [];
  const collections = [];
  const pathPrefixes = [];
  for (const raw of source.replace(/"([^"]+)"/g, " ").split(/\s+/).filter(Boolean)) {
    const value = raw.toLowerCase().replace(/^["']|["']$/g, "");
    const [key, ...rest] = value.split(":");
    const filter = rest.join(":");
    if (rest.length && filter) {
      if (key === "collection" || key === "c") collections.push(filter);
      else if (key === "path") pathPrefixes.push(filter.replace(/^\/+/, ""));
      else terms.push(...words(filter));
    } else if (value.startsWith("-")) {
      negativeTerms.push(...words(value.slice(1)));
    } else {
      terms.push(...words(value));
    }
  }
  return { terms: [...new Set(terms)], negativeTerms: [...new Set(negativeTerms)], phrases, collections, pathPrefixes };
}

function searchFullVaultIndex(root, query, limit = 400) {
  const parsed = parseFullVaultQuery(query);
  const records = readFullVaultIndex(root).filter((record) => {
    if (parsed.collections.length && !parsed.collections.includes(record.collection)) return false;
    if (parsed.pathPrefixes.length && !parsed.pathPrefixes.some((prefix) => record.path.toLowerCase().startsWith(prefix))) return false;
    if (parsed.negativeTerms.some((term) => record.terms[term])) return false;
    return true;
  });
  const averageLength = records.reduce((sum, record) => sum + record.documentLength, 0) / Math.max(1, records.length);
  const docFreq = new Map(parsed.terms.map((term) => [term, records.reduce((count, record) => count + (record.terms[term] ? 1 : 0), 0)]));
  const hasSearchTerms = parsed.terms.length || parsed.phrases.length;
  function coverageScore(matched) {
    if (parsed.terms.length <= 1) return 0;
    const matchedTermCount = parsed.terms.filter((term) => matched.has(term)).length;
    if (!matchedTermCount) return 0;
    const coverage = matchedTermCount / parsed.terms.length;
    let score = coverage * 6;
    if (matchedTermCount === parsed.terms.length) score += 3;
    if (parsed.terms.length >= 4 && coverage < 0.5) score -= (parsed.terms.length - matchedTermCount) * 0.75;
    return score;
  }
  return records.map((record) => {
    const matched = new Set();
    let searchScore = 0;
    const title = record.title.toLowerCase();
    const headings = (record.headings || []).join(" ").toLowerCase();
    const haystack = `${title} ${headings} ${record.path.toLowerCase()} ${record.excerpt.toLowerCase()}`;
    for (const term of parsed.terms) {
      const frequency = record.terms[term] || 0;
      if (!frequency) continue;
      const df = docFreq.get(term) || 1;
      const idf = Math.log(1 + (records.length - df + 0.5) / (df + 0.5));
      const denominator = frequency + 1.2 * (1 - 0.75 + 0.75 * (record.documentLength / Math.max(1, averageLength)));
      searchScore += idf * ((frequency * 2.2) / denominator);
      if (title.includes(term)) searchScore += 3;
      if (headings.includes(term)) searchScore += 1.5;
      if (record.path.toLowerCase().includes(term)) searchScore += 1;
      matched.add(term);
    }
    for (const phrase of parsed.phrases) {
      if (haystack.includes(phrase)) {
        searchScore += title.includes(phrase) ? 8 : 4;
        matched.add(`"${phrase}"`);
      }
    }
    searchScore += coverageScore(matched);
    return { ...record, searchScore: Math.round(searchScore * 100) / 10, matched: [...matched] };
  }).filter((hit) => !hasSearchTerms || hit.matched.length)
    .sort((left, right) => right.searchScore - left.searchScore || right.mtimeMs - left.mtimeMs)
    .slice(0, limit);
}

// --- local fallback: typed memory records ------------------------------------

// Retrieval rows older than this stop counting toward the ranking nudge
// (mirrors the app's usage window).
const RETRIEVAL_SIGNAL_WINDOW_MS = 45 * 86_400_000;

function readUsageSummaries(root) {
  const file = path.join(root, RETRIEVALS_PATH);
  const summary = new Map();
  let raw = "";
  try {
    raw = fs.readFileSync(file, "utf8");
  } catch {
    return summary;
  }
  const retrievalCutoff = new Date(Date.now() - RETRIEVAL_SIGNAL_WINDOW_MS).toISOString();
  for (const line of raw.split("\n")) {
    if (!line.trim()) continue;
    try {
      const row = JSON.parse(line);
      if (!row.memoryId) continue;
      const current = summary.get(row.memoryId) ?? {};
      if (row.usageType === "final-answer") {
        current.finalAnswerCount = (current.finalAnswerCount ?? 0) + 1;
        if (row.timestamp && (!current.lastUsedAt || row.timestamp > current.lastUsedAt)) current.lastUsedAt = row.timestamp;
      } else {
        if (!row.timestamp || row.timestamp >= retrievalCutoff) {
          current.retrievalCount = (current.retrievalCount ?? 0) + 1;
        }
        if (row.timestamp && (!current.lastRetrievedAt || row.timestamp > current.lastRetrievedAt)) current.lastRetrievedAt = row.timestamp;
      }
      summary.set(row.memoryId, current);
    } catch {
      // Ignore corrupt rows.
    }
  }
  return summary;
}

function recordsFromIndex(root) {
  const file = path.join(root, INDEX_PATH);
  if (!fs.existsSync(file)) return [];
  const byId = new Map();
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    if (!line.trim()) continue;
    try {
      const entry = JSON.parse(line);
      if (entry.action !== "remember" || !entry.id || !entry.title || !entry.content || !entry.notePath) continue;
      byId.set(entry.id, {
        id: entry.id,
        title: entry.title,
        content: entry.content,
        type: entry.memoryType || "context",
        memoryKey: canonicalMemoryKey({
          explicitKey: entry.memoryKey,
          type: entry.memoryType || "context",
          title: entry.title,
          project: entry.project,
        }),
        status: entry.status || "active",
        cognitiveStage: entry.cognitiveStage,
        supersedes: Array.isArray(entry.supersedes) ? entry.supersedes : [],
        supersededBy: Array.isArray(entry.supersededBy) ? entry.supersededBy : [],
        evolutionRootId: entry.evolutionRootId,
        evolutionType: entry.evolutionType,
        evolutionReason: entry.evolutionReason,
        confidence: Number(entry.confidence || 0.7),
        tags: Array.isArray(entry.tags) ? entry.tags : [],
        metaTags: Array.isArray(entry.metaTags) ? entry.metaTags : [],
        entities: Array.isArray(entry.entities) ? entry.entities : [],
        aliases: Array.isArray(entry.aliases) ? entry.aliases : [],
        source: entry.source,
        project: entry.project,
        agentName: entry.agentName,
        agentId: entry.agentId,
        runtime: entry.runtime,
        machineName: entry.machineName,
        machineId: entry.machineId,
        createdAt: entry.createdAt,
        updatedAt: entry.updatedAt,
        notePath: entry.notePath,
      });
    } catch {
      // Ignore corrupt JSONL rows.
    }
  }
  return [...byId.values()];
}

function recordFromMarkdown(root, file, typedOnly = false) {
  const st = fs.statSync(file);
  if (st.size > MAX_VAULT_BYTES) return null;
  const markdown = fs.readFileSync(file, "utf8");
  const { fields, body } = parseFrontmatter(markdown);
  const notePath = rel(root, file);
  if (typedOnly && fields.get("type") !== "agent-memory") return null;
  const title = String(fields.get("title") || (body.match(/^#\s+(.+)$/m) || [])[1] || path.basename(file, ".md")).trim();
  const content = bodyContent(body) || markdown.replace(/^---\n[\s\S]*?\n---\n?/, "").trim();
  if (!content) return null;
  return {
    id: notePath,
    title,
    content,
    type: fields.get("memoryType") || fields.get("type") || "context",
    memoryKey: typedOnly ? canonicalMemoryKey({
      explicitKey: fields.get("memoryKey"),
      type: fields.get("memoryType") || fields.get("type") || "context",
      title,
      project: fields.get("project"),
    }) : undefined,
    status: fields.get("status") || "active",
    cognitiveStage: fields.get("cognitiveStage"),
    supersedes: Array.isArray(fields.get("supersedes")) ? fields.get("supersedes") : [],
    supersededBy: Array.isArray(fields.get("supersededBy")) ? fields.get("supersededBy") : [],
    evolutionRootId: fields.get("evolutionRootId"),
    evolutionType: fields.get("evolutionType"),
    evolutionReason: fields.get("evolutionReason"),
    confidence: typedOnly ? Number(fields.get("confidence") || 0.7) : 0.62,
    tags: Array.isArray(fields.get("tags")) ? fields.get("tags") : notePath.split("/").slice(0, 3).map((part) => part.toLowerCase()),
    metaTags: Array.isArray(fields.get("metaTags")) ? fields.get("metaTags") : [],
    entities: Array.isArray(fields.get("entities")) ? fields.get("entities") : [],
    aliases: Array.isArray(fields.get("aliases")) ? fields.get("aliases") : [],
    source: `Vault note: ${notePath}`,
    createdAt: fields.get("createdAt"),
    updatedAt: fields.get("updatedAt"),
    notePath,
  };
}

// --- local fallback: optional semantic augmentation ---------------------------

function embeddingsConfig() {
  const url = process.env.HIVEMINDOS_EMBEDDINGS_URL?.trim();
  return {
    enabled: Boolean(url),
    url: url || undefined,
    model: process.env.HIVEMINDOS_EMBEDDINGS_MODEL?.trim() || "text-embedding-3-small",
    dimensions: Math.max(16, Math.trunc(Number(process.env.HIVEMINDOS_EMBEDDINGS_DIMENSIONS || 256)) || 256),
    apiKey: process.env.HIVEMINDOS_EMBEDDINGS_API_KEY?.trim() || "",
  };
}

function readEmbeddingRows(root) {
  const rows = new Map();
  try {
    const raw = fs.readFileSync(path.join(root, EMBEDDINGS_PATH), "utf8");
    for (const line of raw.split("\n")) {
      if (!line.trim()) continue;
      try {
        const parsed = JSON.parse(line);
        if (parsed.schema === "hivemindos.agent-memory-embedding.v1" && parsed.memoryId && Array.isArray(parsed.vector)) {
          rows.set(parsed.memoryId, parsed.vector);
        }
      } catch {
        // Ignore corrupt rows.
      }
    }
  } catch {
    // Missing file -> no semantic layer locally.
  }
  return rows;
}

async function embedQuery(query) {
  const config = embeddingsConfig();
  if (!config.enabled || typeof fetch !== "function") return null;
  const endpoint = /\/embeddings\/?$/.test(config.url) ? config.url : `${config.url.replace(/\/+$/, "")}/embeddings`;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 3500);
  try {
    const response = await fetch(endpoint, {
      method: "POST",
      signal: controller.signal,
      headers: {
        "content-type": "application/json",
        ...(config.apiKey ? { authorization: `Bearer ${config.apiKey}` } : {}),
      },
      body: JSON.stringify({ model: config.model, input: [query.slice(0, 6000)], dimensions: config.dimensions }),
    });
    if (!response.ok) return null;
    const payload = await response.json();
    const vector = payload?.data?.[0]?.embedding;
    return Array.isArray(vector) ? vector : null;
  } catch {
    return null;
  } finally {
    clearTimeout(timer);
  }
}

function cosineSimilarity(left, right) {
  const length = Math.min(left.length, right.length);
  if (!length) return 0;
  let dot = 0;
  let leftNorm = 0;
  let rightNorm = 0;
  for (let index = 0; index < length; index += 1) {
    dot += left[index] * right[index];
    leftNorm += left[index] * left[index];
    rightNorm += right[index] * right[index];
  }
  if (!leftNorm || !rightNorm) return 0;
  return dot / (Math.sqrt(leftNorm) * Math.sqrt(rightNorm));
}

async function semanticScores(root, query) {
  const scores = new Map();
  if (!embeddingsConfig().enabled || !query.trim()) return scores;
  const rows = readEmbeddingRows(root);
  if (!rows.size) return scores;
  const queryVector = await embedQuery(query);
  if (!queryVector) return scores;
  for (const [memoryId, vector] of rows) {
    const similarity = cosineSimilarity(queryVector, vector);
    if (similarity > 0) scores.set(memoryId, Math.max(0, Math.min(1, similarity)));
  }
  return scores;
}

// --- local fallback: recall --------------------------------------------------

async function fallbackRecall(input) {
  const root = path.resolve(input.vaultPath);
  if (!fs.existsSync(root)) throw new Error(`Vault path not found: ${root}`);
  const limit = Math.min(Math.max(Math.trunc(Number(input.limit || 5)), 1), 50);
  const scope = String(input.scope || "tiered").toLowerCase();
  const { query: effectiveQuery, derived } = extractRecallQuery(input.query);
  const scoringInput = { query: effectiveQuery, type: input.type, includeOperational: input.includeOperational };
  let memoryRecords = recordsFromIndex(root);
  if (!memoryRecords.length) {
    const folder = path.join(root, MEMORY_FOLDER);
    if (fs.existsSync(folder)) memoryRecords = walk(folder).map((file) => recordFromMarkdown(root, file, true)).filter(Boolean);
  }
  const usage = readUsageSummaries(root);
  for (const record of memoryRecords) {
    const summary = usage.get(record.id);
    if (summary) record.usage = summary;
  }
  const semantic = await semanticScores(root, effectiveQuery).catch(() => new Map());
  const visibleMemoryRecords = memoryRecords.filter((record) => recordVisibleForRecall(record, scoringInput));
  const activeMemoryRecords = temporalRecallMode(scoringInput) === "current"
    ? selectCanonicalMemoryHeads(visibleMemoryRecords).records
    : visibleMemoryRecords;
  const memoryHits = attachEvolutionChains(rank(activeMemoryRecords, scoringInput, limit, semantic), memoryRecords);
  if (scope === "agent-memory" || (scope !== "full-vault" && shouldUseDistilledMemoryOnly(scoringInput, memoryHits))) {
    return {
      ok: true,
      source: "local-fallback",
      recallScope: "agent-memory",
      augmentedFromVault: false,
      query: effectiveQuery,
      queryDerived: derived || undefined,
      hits: memoryHits,
    };
  }
  const byPath = new Map();
  const indexedHits = effectiveQuery.trim() ? searchFullVaultIndex(root, effectiveQuery, 400) : [];
  const fullVaultFiles = indexedHits.length ? indexedHits.map((hit) => path.join(root, hit.path)) : searchVaultFiles(root, effectiveQuery) ?? walk(root);
  const scoreByPath = new Map(indexedHits.map((hit) => [hit.path, hit.searchScore]));
  const topSearchScore = Math.max(0, indexedHits[0]?.searchScore ?? 0);
  const collectionByPath = new Map(indexedHits.map((hit) => [hit.path, hit.collection]));
  for (const file of fullVaultFiles) {
    if (rel(root, file).startsWith(`${MEMORY_FOLDER}/`)) continue;
    if (!fs.existsSync(file)) continue;
    let record = null;
    try {
      record = recordFromMarkdown(root, file, false);
    } catch {
      continue;
    }
    if (record) {
      record.searchScore = scoreByPath.get(record.notePath);
      record.searchScoreNormalized = topSearchScore > 0 ? Math.max(0, record.searchScore ?? 0) / topSearchScore : undefined;
      record.searchCollection = collectionByPath.get(record.notePath);
      byPath.set(record.notePath, record);
    }
  }
  for (const record of activeMemoryRecords) byPath.set(record.notePath, record);
  return {
    ok: true,
    source: "local-fallback",
    recallScope: "full-vault",
    augmentedFromVault: scope !== "full-vault",
    memoryHitCount: memoryHits.length,
    query: effectiveQuery,
    queryDerived: derived || undefined,
    hits: attachEvolutionChains(rank([...byPath.values()], scoringInput, limit, semantic), memoryRecords),
  };
}

function chainItem(record) {
  return {
    id: record.id,
    title: record.title,
    content: record.content,
    status: record.status || "active",
    notePath: record.notePath,
    cognitiveStage: record.cognitiveStage,
    evolutionType: record.evolutionType,
    evolutionReason: record.evolutionReason,
  };
}

function traceEvolutionChain(record, byId, seen = new Set()) {
  if (!record || seen.has(record.id)) return [];
  seen.add(record.id);
  const ancestors = (record.supersedes || [])
    .map((id) => byId.get(id))
    .filter(Boolean)
    .sort((left, right) => String(right.createdAt || "").localeCompare(String(left.createdAt || "")))
    .flatMap((ancestor) => traceEvolutionChain(ancestor, byId, seen));
  return [record, ...ancestors];
}

function attachEvolutionChains(hits, allMemoryRecords) {
  const byId = new Map(allMemoryRecords.map((record) => [record.id, record]));
  return hits.map((hit) => {
    const source = byId.get(hit.id);
    if (!source) return hit;
    const chain = traceEvolutionChain(source, byId);
    if (chain.length <= 1) return hit;
    return { ...hit, evolutionChain: chain.map(chainItem) };
  });
}

function rank(records, scoringInput, limit, semantic) {
  const lexicalScores = bm25ScoresForRecords(records, scoringInput);
  return records
    .map((record) => {
      const scored = scoreAgentMemory(record, scoringInput, lexicalScores.get(record.id), semantic?.get(record.id));
      return { ...record, score: scored.score, matched: scored.matched, scoreDetails: scored.scoreDetails, excerpt: compact(record.content) };
    })
    .filter((hit) => !(scoringInput.query ?? "").trim() || hit.matched.length)
    .sort((left, right) => right.score - left.score)
    .slice(0, limit);
}

// --- local fallback: usage + health ------------------------------------------

function fallbackRecordUsage(input) {
  const root = path.resolve(input.vaultPath);
  const memoryIds = [...new Set(input.memoryIds.map((id) => id.trim()).filter(Boolean))].slice(0, 50);
  if (!memoryIds.length) throw new Error("record-usage requires --memory-ids.");
  const timestamp = new Date().toISOString();
  const query = input.usageQuery ? redactSecrets(String(input.usageQuery).replace(/\s+/g, " ").trim()).slice(0, 200) : undefined;
  const rows = memoryIds.map((memoryId) => ({
    timestamp,
    schema: "hivemindos.agent-memory-retrieval.v1",
    memoryId,
    usageType: input.usageType === "final-answer" ? "final-answer" : "retrieved",
    query,
    usageContext: input.usageContext || undefined,
    agentName: input.agentName || undefined,
    runtime: input.runtime || undefined,
    sessionId: input.sessionId || undefined,
  }));
  const file = path.join(root, RETRIEVALS_PATH);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.appendFileSync(file, `${rows.map((row) => JSON.stringify(row)).join("\n")}\n`, "utf8");
  return { ok: true, source: "local-fallback", recorded: rows.length };
}

function fileStats(root, relPath) {
  const file = path.join(root, relPath);
  try {
    const st = fs.statSync(file);
    const lines = fs.readFileSync(file, "utf8").split("\n").filter(Boolean).length;
    return { exists: true, bytes: st.size, lines, ageMs: Math.max(0, Date.now() - st.mtimeMs) };
  } catch {
    return { exists: false, bytes: 0, lines: 0 };
  }
}

function fallbackHealth(input) {
  const root = path.resolve(input.vaultPath);
  const records = recordsFromIndex(root);
  const durableRecords = records.filter((record) => record.type !== "action");
  const legacyOperational = records.filter((record) => record.type === "action" && record.status === "active");
  const byType = {};
  const byStatus = {};
  for (const record of durableRecords) {
    byType[record.type] = (byType[record.type] ?? 0) + 1;
    byStatus[record.status] = (byStatus[record.status] ?? 0) + 1;
  }
  const canonicalHeads = selectCanonicalMemoryHeads(durableRecords.filter((record) => record.status === "active"));
  const indexStats = fileStats(root, INDEX_PATH);
  return {
    ok: true,
    source: "local-fallback",
    generatedAt: new Date().toISOString(),
    note: "Local health is a subset; run against the app API for duplicate pressure, embeddings coverage, and proof status.",
    memories: {
      total: durableRecords.length,
      active: durableRecords.filter((record) => record.status === "active").length,
      byType,
      byStatus,
      legacyOperationalActive: legacyOperational.length,
    },
    canonicalHeads: {
      active: canonicalHeads.records.length,
      conflicts: canonicalHeads.conflicts.length,
      conflictGroups: canonicalHeads.conflicts.slice(0, 20),
    },
    indexes: {
      memoryIndex: { ...indexStats, uniqueRecords: records.length, bloatFactor: records.length ? Math.round((indexStats.lines / records.length) * 100) / 100 : 0 },
      entityIndex: fileStats(root, "Operations/Brain Services/Agent Memory Entity Index.jsonl"),
      retrievals: fileStats(root, RETRIEVALS_PATH),
      fullVaultIndex: fileStats(root, FULL_VAULT_INDEX_PATH),
      embeddings: fileStats(root, EMBEDDINGS_PATH),
    },
    pendingWrites: readPendingWrites().length,
  };
}

// --- output formatting ---------------------------------------------------------

function formatResult(result, action, input) {
  if (action === "recall") {
    return result.hits.map((hit, index) => {
      const chain = formatEvolutionChain(hit);
      return `${index + 1}. ${hit.title}\n   path: ${hit.notePath}\n   score: ${hit.score}; matched: ${(hit.matched || []).join(", ") || "none"}${hit.evolutionChain?.length > 1 ? `; evolved: ${hit.evolutionChain.length} versions` : ""}\n   ${hit.excerpt}${chain ? `\n${chain}` : ""}`;
    }).join("\n\n")
      || "No matching shared-brain memories or vault notes were found.";
  }
  const minScore = Number.isFinite(Number(input?.minScore)) ? Number(input.minScore) : AGENT_MEMORY_ANSWER_MIN_SCORE;
  const hits = (result.hits || []).filter((hit) => result.source !== "local-fallback" || !minScore || hit.score >= minScore);
  return [
    `Recall scope: ${result.recallScope || "unknown"}${result.augmentedFromVault ? " (augmented from full vault)" : ""}${result.queryDerived ? "; query condensed from long prompt" : ""}`,
    ...(hits.slice(0, 6).map((hit, index) => {
      const evolved = hit.evolutionChain?.length > 1 ? `, evolved ${hit.evolutionChain.length} versions` : "";
      const chain = formatEvolutionChain(hit);
      return `${index + 1}. ${hit.title} (${hit.type || "context"}, score ${hit.score}${evolved})\n   Path: ${hit.notePath}\n   ${hit.excerpt}${chain ? `\n${chain}` : ""}`;
    })),
  ].join("\n") || "No matching shared-brain memories or vault notes were found.";
}

function formatEvolutionChain(hit) {
  if (!hit.evolutionChain || hit.evolutionChain.length <= 1) return "";
  return [
    "   Evolution:",
    ...hit.evolutionChain.map((item, index) => {
      const label = index === 0 ? "Latest" : `Previous ${index}`;
      const reason = item.evolutionReason ? `; reason: ${item.evolutionReason}` : "";
      const stage = item.cognitiveStage ? `; stage: ${item.cognitiveStage}` : "";
      return `   - ${label}: ${item.title} (${item.status || "active"}${stage}${reason}) - ${compact(item.content, 180)}`;
    }),
  ].join("\n");
}

function formatConflicts(conflicts) {
  return (conflicts || []).slice(0, 3).map((hit, index) =>
    `   ${index + 1}. ${hit.title} (${hit.id}, score ${hit.score})\n      ${compact(hit.content || hit.excerpt || "", 180)}`).join("\n");
}

function applyAnswerFloor(result, input) {
  // API responses already floor answer hits; local fallback floors here.
  if (result.source !== "local-fallback") return result;
  if (!(input.query ?? "").trim()) return result;
  const minScore = Number.isFinite(Number(input.minScore)) ? Math.max(0, Number(input.minScore)) : AGENT_MEMORY_ANSWER_MIN_SCORE;
  if (!minScore) return result;
  // Mirrors answerFromAgentMemory: informational queries (4+ meaningful terms)
  // need 2+ meaningful matches or a strong signal, not one incidental word.
  const meaningfulQueryTerms = [...new Set(queryWordsForRecall(result.query ?? ""))];
  const requireMultiMatch = meaningfulQueryTerms.length >= 4;
  const requiredDirectMatches = result.queryDerived
    ? 2
    : Math.max(2, Math.ceil(meaningfulQueryTerms.length * 0.3));
  const hits = result.hits.filter((hit) => {
    if (hit.score < minScore) return false;
    if (!requireMultiMatch) return true;
    return meaningfulMatchCount(hit.matched) >= requiredDirectMatches || hit.matched.includes("exact-query") || hit.matched.includes("semantic");
  });
  return { ...result, hits, minScore, droppedBelowMinScore: result.hits.length - hits.length };
}

async function main() {
  const input = parseArgs(process.argv);
  const actions = ["answer", "recall", "remember", "evolve", "record-operation", "mine-patterns", "record-usage", "health", "consolidate", "rebuild-index", "flush-pending"];
  if (input.help || !actions.includes(input.action)) {
    usage();
    process.exit(input.help ? 0 : 2);
  }
  if (["answer", "recall"].includes(input.action) && !input.query) throw new Error("A query is required.");
  if (input.action === "remember" && !input.content) throw new Error("remember requires --content.");
  if (input.action === "evolve" && !input.content) throw new Error("evolve requires --content.");
  if (input.action === "evolve" && !input.memoryId && !input.supersedes?.length) throw new Error("evolve requires --memory-id or --supersedes.");
  if (input.action === "record-operation" && (!input.title || !input.content)) throw new Error("record-operation requires --title and --content.");
  if (input.action === "record-usage" && !input.memoryIds.length) throw new Error("record-usage requires --memory-ids.");

  if (input.action === "flush-pending") {
    let flushedTotal = 0;
    let remaining = readPendingWrites().length;
    let blockedEntries = readPendingWrites().filter((entry) => entry.blockedAt);
    if (remaining) {
      for (const base of candidateApiBases()) {
        try {
          const result = await flushPendingWrites(base, { retryBlocked: Boolean(input.retryBlocked) });
          flushedTotal += result.flushed;
          remaining = result.remaining;
          blockedEntries = result.blockedEntries;
          if (!remaining) break;
          if (remaining === blockedEntries.length && !input.retryBlocked) break;
        } catch {
          // Try the next base.
        }
      }
    }
    console.log(`Pending shared-brain writes flushed: ${flushedTotal}; remaining: ${remaining}${blockedEntries.length ? ` (${blockedEntries.length} blocked)` : ""}.`);
    for (const entry of blockedEntries.slice(0, 5)) {
      console.log(`- BLOCKED ${entry.payload?.action ?? "write"} "${entry.payload?.title ?? ""}": ${compact(entry.blockedReason ?? "rejected", 220)}`);
    }
    if (blockedEntries.length) console.log("Review each blocked entry: evolve the conflicting memory, or re-deliver with: hive-brain flush-pending --retry-blocked (sends allowDuplicate).");
    return;
  }

  let result;
  try {
    result = await callApi(input);
    result.source = result.source || "api";
  } catch (error) {
    // Authoritative app rejection (duplicate gate / validation): surface it.
    if (error?.status && error.body) {
      if (error.body.blocked) {
        console.error(`hive-brain: memory write blocked as a suspected duplicate.`);
        console.error(`Reason: ${error.body.blockReason || "similar active memory exists."}`);
        if (error.body.possibleConflicts?.length) {
          console.error("Conflicting memories:");
          console.error(formatConflicts(error.body.possibleConflicts));
        }
        console.error("Evolve the existing memory (hive-brain evolve --memory-id <id> --content ... --reason ...) or retry with --allow-duplicate.");
        process.exit(3);
      }
      // Auth rejections are an environment problem, not a verdict on the
      // memory operation: warn and degrade to the queue/local-fallback paths
      // below so fleet recall keeps working while credentials get repaired.
      if (error.status === 401 || error.status === 403) {
        console.error(`hive-brain: dashboard API rejected every known device token (HTTP ${error.status}). Check ${DEVICE_TOKEN_KEY} in the app's .env.local and ~/.hivemindos/.env; continuing offline.`);
      } else {
        throw error;
      }
    }
    if (input.action === "remember" || input.action === "evolve") {
      if (input.noQueue) throw error;
      // The app API is unreachable: queue the write for durable delivery
      // instead of losing the memory.
      const pending = enqueuePendingWrite(writePayload(input, input.action));
      console.log(`HivemindOS memory API unreachable; queued ${input.action} for later delivery (${pending} pending in ${PENDING_WRITES_FILE}).`);
      console.log("It will flush automatically on the next successful API contact, or run: hive-brain flush-pending");
      return;
    }
    if (input.action === "record-operation") {
      result = recordLocalOperationalEvent(applyProvenanceDefaults(input));
    } else if (input.action === "record-usage") {
      result = fallbackRecordUsage(applyProvenanceDefaults(input));
    } else if (input.action === "health") {
      result = fallbackHealth(input);
    } else if (["mine-patterns", "consolidate", "rebuild-index"].includes(input.action)) {
      throw new Error(`${input.action} needs the HivemindOS app API (start the app or set HIVEMINDOS_BRAIN_URL). ${error instanceof Error ? error.message : ""}`.trim());
    } else {
      result = await fallbackRecall(input);
      result.apiError = error instanceof Error ? error.message : String(error);
    }
  }

  if (input.action === "answer") result = applyAnswerFloor(result, input);

  if (input.json) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }
  if (input.action === "remember") {
    console.log(`Remembered: ${result.record?.title || input.title || compact(input.content, 80)}`);
    if (result.record?.notePath) console.log(`Path: ${result.record.notePath}`);
    if (result.sensitiveWarnings?.length) console.log(`Warnings: ${result.sensitiveWarnings.join("; ")}`);
    if (result.possibleConflicts?.length) {
      console.log("Similar existing memories (consider evolve next time):");
      console.log(formatConflicts(result.possibleConflicts));
    }
    return;
  }
  if (input.action === "evolve") {
    console.log(`Evolved: ${result.record?.title || input.title || compact(input.content, 80)}`);
    if (result.record?.notePath) console.log(`Path: ${result.record.notePath}`);
    if (result.superseded?.length) console.log(`Superseded: ${result.superseded.map((record) => record.id).join(", ")}`);
    return;
  }
  if (input.action === "record-operation") {
    console.log(`Recorded operational event: ${result.event?.title || input.title}`);
    console.log("Durable memory written: no.");
    return;
  }
  if (input.action === "mine-patterns") {
    console.log(`Pattern mining reviewed ${result.mining?.scanned ?? 0} operational events and found ${result.mining?.candidates?.length ?? 0} candidate(s).`);
    console.log(input.enqueueProposals
      ? `Queued ${result.enqueued?.length ?? 0} proposal(s) for Brain Review.`
      : "Dry run only; use --enqueue to add reviewed candidates to Brain Review.");
    for (const candidate of (result.mining?.candidates || []).slice(0, 8)) {
      console.log(`- [${candidate.reviewKind}] ${candidate.title} (${candidate.confidence})`);
    }
    return;
  }
  if (input.action === "record-usage") {
    console.log(`Recorded ${result.recorded ?? 0} usage row(s) (${input.usageType || "retrieved"}).`);
    return;
  }
  if (input.action === "health") {
    console.log(JSON.stringify(result, null, 2));
    return;
  }
  if (input.action === "consolidate") {
    console.log(`Consolidation report for ${result.vaultPath}:`);
    console.log(`- Active memories: ${result.active}/${result.scanned}`);
    if (result.legacyOperationalIgnored) console.log(`- Legacy operational receipts ignored: ${result.legacyOperationalIgnored}`);
    console.log(`- Near-duplicate groups: ${result.duplicateGroups?.length ?? 0}`);
    for (const group of (result.duplicateGroups || []).slice(0, 8)) {
      console.log(`  * [${group.type}] ${group.size}x "${group.canonicalTitle}"`);
      console.log(`    ${group.evolveHint}`);
    }
    console.log(`- Explicit correction candidates: ${result.correctionCandidates?.length ?? 0}`);
    for (const candidate of (result.correctionCandidates || []).slice(0, 8)) {
      console.log(`  * "${candidate.newerTitle}" replaces "${candidate.olderTitle}"`);
      console.log(`    ${candidate.evolveHint}`);
    }
    console.log(`- Stale archive candidates: ${result.archiveCandidates?.length ?? 0}${result.archivedCount ? ` (archived ${result.archivedCount})` : " (report only; use --apply-archives)"}`);
    console.log(`- Compiled-wiki candidates: ${(result.wikiCandidates || []).map((candidate) => `${candidate.entity} (${candidate.memoryCount})`).join(", ") || "none"}`);
    if (result.embeddings) console.log(`- Embeddings: ${JSON.stringify(result.embeddings)}`);
    return;
  }
  if (input.action === "rebuild-index") {
    console.log(`Rebuilt memory index: ${result.scanned} memories, full-vault ${result.fullVaultIndex ? `${result.fullVaultIndex.indexed} notes` : "skipped"}.`);
    return;
  }
  console.log(formatResult(result, input.action, input));
}

main().catch((error) => {
  console.error(`hive-brain: ${error instanceof Error ? error.message : String(error)}`);
  process.exit(1);
});
