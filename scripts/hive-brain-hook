#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import os from "node:os";
import path from "node:path";

const MAX_CONTEXT_CHARS = 5000;

function hiveBrainCommand() {
  const localBin = path.join(os.homedir(), ".local", "bin", process.platform === "win32" ? "hive-brain.cmd" : "hive-brain");
  return process.env.HIVE_BRAIN_COMMAND || localBin;
}

function readStdin() {
  return new Promise((resolve) => {
    let data = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", (chunk) => { data += chunk; });
    process.stdin.on("end", () => resolve(data));
  });
}

function compact(value, max = 360) {
  const text = String(value || "").replace(/\s+/g, " ").trim();
  if (text.length <= max) return text;
  return `${text.slice(0, Math.max(0, max - 3)).trim()}...`;
}

function formatHit(hit, index) {
  const title = hit.title || hit.notePath || `Hit ${index + 1}`;
  const type = hit.type ? `; type: ${hit.type}` : "";
  const score = Number.isFinite(Number(hit.score)) ? `; score: ${hit.score}` : "";
  const pathText = hit.notePath ? `; path: ${hit.notePath}` : "";
  const excerpt = compact(hit.content || hit.excerpt || "", index === 0 ? 900 : 420);
  return `${index + 1}. ${title}${type}${score}${pathText}\n   ${excerpt}`;
}

function buildContext(result) {
  const hits = Array.isArray(result?.hits) ? result.hits.filter(Boolean) : [];
  if (!hits.length) return "";
  const scope = result.recallScope || "unknown";
  const source = result.source || "unknown";
  const header = [
    "HivemindOS shared brain recall was run automatically for this prompt.",
    `Use these private local notes as relevant context. Source: ${source}. Scope: ${scope}.`,
    "Do not mention the hook unless asked. Do not reveal secrets or raw Tailnet IPs.",
  ].join("\n");
  return `${header}\n\n${hits.slice(0, 6).map(formatHit).join("\n\n")}`.slice(0, MAX_CONTEXT_CHARS);
}

function outputAdditionalContext(hookEventName, additionalContext) {
  if (!additionalContext.trim()) return;
  console.log(JSON.stringify({
    hookSpecificOutput: {
      hookEventName,
      additionalContext,
    },
  }));
}

async function main() {
  const mode = process.argv[2] || "claude-user-prompt";
  const rawInput = await readStdin();
  let payload = {};
  try {
    payload = rawInput.trim() ? JSON.parse(rawInput) : {};
  } catch {
    payload = {};
  }

  const prompt = String(payload.prompt || "").trim();
  if (!prompt || prompt.length < 3) return;

  const command = hiveBrainCommand();
  const result = spawnSync(command, ["answer", prompt, "--json", "--limit", process.env.HIVE_BRAIN_HOOK_LIMIT || "6"], {
    encoding: "utf8",
    timeout: Number(process.env.HIVE_BRAIN_HOOK_TIMEOUT_MS || 20000),
    env: process.env,
    maxBuffer: 1024 * 1024,
  });
  if (result.error || result.status !== 0) return;

  let parsed;
  try {
    parsed = JSON.parse(result.stdout || "{}");
  } catch {
    return;
  }

  const hookEventName = mode === "claude-session-start" ? "SessionStart" : "UserPromptSubmit";
  outputAdditionalContext(hookEventName, buildContext(parsed));
}

main().catch(() => {
  process.exit(0);
});
