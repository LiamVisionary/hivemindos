COLLECTORLESS_PEER_OS = {"ios", "android"}

KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
LOCAL_ONLY_KEYS = {
    # The dashboard auth token + secret are PER-MACHINE credentials: each hub
    # generates its own in its checkout .env.local (scripts/dashboard-auth.mjs),
    # and each hub verifies against its own. Fleet-replicating them makes one
    # machine's push clobber another's, which breaks that machine's phone
    # pairing / API auth (observed 2026-07-05: a peer scope-all push overwrote
    # this machine's shared-env copy, so its gateway served a token the local
    # hub rejected). They must never sync — inbound OR outbound.
    "HIVEMINDOS_DASHBOARD_AUTH_SECRET",
    "HIVEMINDOS_DASHBOARD_DEVICE_TOKEN",
    "HIVE_AGENT_ENV_FILE",
    "HIVE_ENV_BACKUP_DIR",
    "HIVE_ENV_COLLECTOR_PORT",
    "HIVE_ENV_COLLECTOR_PORTS",
    "HIVE_ENV_FILE",
    "HIVE_ENV_GPG_RECIPIENT",
    "HIVE_ENV_PROJECT_ROOT",
    "HIVE_ENV_PUBLIC_KEY",
    "HIVE_ENV_TAILNET_SYNC",
    "HIVE_ENV_TAILNET_TARGETS",
    "HIVE_ENV_TAILNET_USER",
    "HIVE_ENV_TAILNET_VERBOSE",
    "HIVE_NOTE_ROOT",
    "HIVE_NOTE_SECURE_FOLDER",
    "HIVE_SHARED_BRAIN_PATH",
    "NEXT_ALLOWED_DEV_ORIGINS",
    "NEXT_PUBLIC_OBSIDIAN_VAULT_PATH",
    "NEXT_PUBLIC_TAILNET_SYNC_ENABLED",
}

# Per-machine credential FAMILIES (prefix match) that must never sync fleet-wide.
# The UsePod host credentials — token, wallet address, bond signature — are this
# machine's OWN provider identity: a peer's copy would hijack this machine's host
# wallet/payout. They are written machine-scoped (USEPOD_HOST_TOKEN__<MACHINE>)
# AND kept as the bare key for compat, so the whole prefix is local-only.
LOCAL_ONLY_PREFIXES = ("USEPOD_HOST_",)


def is_local_only(key: str) -> bool:
    """A key that must never sync (inbound or outbound): exact per-machine keys
    plus per-machine credential families matched by prefix."""
    return key in LOCAL_ONLY_KEYS or key.startswith(LOCAL_ONLY_PREFIXES)


_DOUBLE_QUOTE_ESCAPES = {
    "\\": "\\", "'": "'", '"': '"', "a": "\a", "b": "\b",
    "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v",
}
_DOUBLE_QUOTE_ESCAPE_RE = re.compile(r"\\(u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)", re.DOTALL)


def _decode_double_quoted(text: str) -> str:
    """Decode backslash escapes in a double-quoted env value.

    Matches python-dotenv's escape set (plus \\xNN/\\uNNNN, which the
    collector's JSON.stringify import payloads can carry for control chars);
    unknown escapes keep their backslash. Replaces the old unicode_escape
    round-trip, which mangled non-ASCII text and raises DeprecationWarning
    on unknown escapes under modern Python.
    """
    def replace(match: re.Match[str]) -> str:
        token = match.group(1)
        if len(token) == 5 and token[0] == "u":
            return chr(int(token[1:], 16))
        if len(token) == 3 and token[0] == "x":
            return chr(int(token[1:], 16))
        return _DOUBLE_QUOTE_ESCAPES.get(token, "\\" + token)

    return _DOUBLE_QUOTE_ESCAPE_RE.sub(replace, text)


def parse_env_text(data: str) -> dict[str, str]:
    parsed: dict[str, str] = {}
    for raw_line in data.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.startswith("export "):
            key = key.split(" ", 1)[1]
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            value = _decode_double_quoted(value[1:-1])
        elif len(value) >= 2 and value[0] == value[-1] == "'":
            inner = value[1:-1]
            if "'" in inner:
                # Legacy shlex.quote concatenation ('don'"'"'t'): pre-fix
                # quote_env wrote single-quote values this way; undo it so
                # already-written values stop reading back corrupted.
                try:
                    parts = shlex.split(value)
                    if len(parts) == 1:
                        inner = parts[0]
                except ValueError:
                    pass
            value = inner
        parsed[key] = value
    return parsed


def parse_env_file(path: pathlib.Path) -> dict[str, str]:
    try:
        data = path.read_text()
    except FileNotFoundError:
        return {}
    return parse_env_text(data)


def local_setting(key: str) -> str:
    for path in (ROOT / ".env.local", ROOT / ".env"):
        value = parse_env_file(path).get(key)
        if value:
            return value
    return ""


def active_workspace() -> dict[str, str]:
    try:
        data = json.loads(WORKSPACES_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}
    workspaces = data.get("workspaces") if isinstance(data, dict) else None
    if not isinstance(workspaces, list):
        return {}
    requested = os.environ.get("HIVE_WORKSPACE_ID") or os.environ.get("NEXT_PUBLIC_HIVE_WORKSPACE_ID") or data.get("activeWorkspaceId") or "main"
    for workspace in workspaces:
        if isinstance(workspace, dict) and workspace.get("id") == requested:
            return workspace
    for workspace in workspaces:
        if isinstance(workspace, dict) and workspace.get("id") == "main":
            return workspace
    return {}


def workspace_path(key: str) -> str:
    value = active_workspace().get(key)
    return str(value or "")


def hive_collector_setting(key: str) -> str:
    value = parse_env_file(pathlib.Path.home() / ".hivemindos" / "collector.env").get(key)
    return value or ""


def valid_port(value: str) -> bool:
    if not re.match(r"^\d+$", value):
        return False
    port = int(value)
    return 0 < port < 65536


def collector_ports() -> list[str]:
    raw_ports = os.environ.get("HIVE_ENV_COLLECTOR_PORTS") or local_setting("HIVE_ENV_COLLECTOR_PORTS")
    candidates: list[str] = []
    if raw_ports:
        # An explicit port list is authoritative; do not fall back to defaults.
        explicit = [part.strip() for part in raw_ports.split(",") if valid_port(part.strip())]
        if explicit:
            return list(dict.fromkeys(explicit))
        candidates.extend(part.strip() for part in raw_ports.split(","))
    candidates.extend([
        os.environ.get("HIVE_ENV_COLLECTOR_PORT", ""),
        local_setting("HIVE_ENV_COLLECTOR_PORT"),
        hive_collector_setting("AGENT_TELEMETRY_PORT"),
    ])
    # Match fleet discovery's probe range (8787-8810): collectors relocate when
    # their preferred port is taken, and a narrower list here silently strands
    # env updates for those peers in the retry queue.
    candidates.extend(str(port) for port in range(8787, 8811))
    ports: list[str] = []
    seen: set[str] = set()
    for candidate in candidates:
        if valid_port(candidate) and candidate not in seen:
            ports.append(candidate)
            seen.add(candidate)
    return ports


def tailscale_cli() -> str:
    path_cli = shutil.which("tailscale")
    candidates = [
        path_cli or "",
        os.environ.get("HIVE_TAILSCALE_CLI", ""),
        "/opt/homebrew/opt/tailscale/bin/tailscale",
        "/opt/homebrew/bin/tailscale",
        "/usr/local/opt/tailscale/bin/tailscale",
        "/usr/local/bin/tailscale",
        "/Applications/Tailscale.app/Contents/MacOS/tailscale",
        "/Applications/Tailscale.app/Contents/MacOS/Tailscale",
    ]
    for candidate in candidates:
        if candidate and pathlib.Path(candidate).exists():
            return candidate
    return path_cli or ""


def truthy(value: str | None) -> bool:
    return (value or "").strip().lower() in {"1", "true", "yes", "on"}


class Spinner:
    """A tiny stderr spinner for slow, otherwise-silent CLI phases.

    Only animates on a real TTY, so piped/app callers (which drive
    hive-env-add with captured stdio) are byte-for-byte unaffected. Set
    HIVE_ENV_NO_SPINNER=1 to force it off.
    """

    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, message: str, stream=None):
        self._message = message
        self._stream = stream if stream is not None else sys.stderr
        self._enabled = (
            hasattr(self._stream, "isatty")
            and self._stream.isatty()
            and not truthy(os.environ.get("HIVE_ENV_NO_SPINNER"))
        )
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._width = 0

    def set_message(self, message: str) -> None:
        self._message = message

    def _draw(self, text: str) -> None:
        # Pad to the widest line ever drawn so a shorter message can't leave
        # stale characters from a previous, longer frame on screen.
        self._width = max(self._width, len(text))
        self._stream.write("\r" + text.ljust(self._width))
        self._stream.flush()

    def _run(self) -> None:
        index = 0
        while not self._stop.is_set():
            frame = self.FRAMES[index % len(self.FRAMES)]
            self._draw(f"{frame} {self._message}")
            index += 1
            self._stop.wait(0.1)

    def __enter__(self) -> "Spinner":
        if self._enabled:
            self._thread = threading.Thread(target=self._run, daemon=True)
            self._thread.start()
        return self

    def __exit__(self, *exc) -> bool:
        self._stop.set()
        if self._thread is not None:
            self._thread.join()
        if self._enabled and self._width:
            self._stream.write("\r" + " " * self._width + "\r")
            self._stream.flush()
        return False


def prompt_secret(prompt: str, mask: str = "•") -> str:
    """Read a secret from the terminal, echoing one mask glyph per character.

    getpass.getpass echoes nothing, so a user can't tell whether a typed or
    pasted value registered (the reported "nothing shows when I type or
    paste"). This shows a bullet per character and supports backspace /
    Ctrl-U / Ctrl-C, while keeping the secret off stdout. Falls back to
    getpass when stdin is not a real TTY (pipes, the desktop app, dumb
    terminals) or if putting the terminal into character mode fails.
    """
    try:
        interactive = sys.stdin.isatty()
    except (AttributeError, ValueError):
        interactive = False
    if not interactive:
        return getpass.getpass(prompt)
    reader = _prompt_secret_windows if os.name == "nt" else _prompt_secret_posix
    try:
        return reader(prompt, mask)
    except (KeyboardInterrupt, EOFError):
        raise
    except Exception:
        # Any terminal-mode failure: degrade to the stdlib silent prompt
        # rather than dropping the interactive flow entirely.
        return getpass.getpass(prompt)


def _prompt_secret_posix(prompt: str, mask: str) -> str:
    import codecs
    import termios
    import tty

    # Prefer the controlling terminal (like getpass) so the mask echo is
    # visible even when stdin/stderr are redirected.
    try:
        tty_fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
        read_fd = write_fd = tty_fd
        opened = True
    except OSError:
        read_fd = sys.stdin.fileno()
        write_fd = sys.stderr.fileno()
        opened = False

    def emit(text: str) -> None:
        os.write(write_fd, text.encode("utf-8", "replace"))

    old = termios.tcgetattr(read_fd)
    chars: list[str] = []
    emit(prompt)
    try:
        tty.setcbreak(read_fd)  # leaves ISIG on so Ctrl-C still raises SIGINT
        decoder = codecs.getincrementaldecoder("utf-8")()
        escape = False
        done = False
        while not done:
            data = os.read(read_fd, 64)
            if not data:  # EOF (Ctrl-D on an empty line closes the fd)
                break
            for ch in decoder.decode(data):
                if escape:
                    # Swallow the rest of an ANSI sequence (arrows, Home, …)
                    # so its bytes aren't captured as secret characters.
                    if ch.isalpha() or ch == "~":
                        escape = False
                    continue
                if ch == "\x1b":
                    escape = True
                    continue
                if ch in ("\r", "\n"):
                    done = True
                    break
                if ch in ("\x7f", "\x08"):  # DEL / Backspace
                    if chars:
                        chars.pop()
                        emit("\b \b")
                    continue
                if ch == "\x15":  # Ctrl-U clears the whole line
                    if chars:
                        emit("\b \b" * len(chars))
                        chars.clear()
                    continue
                if ch == "\x03":  # Ctrl-C (in case ISIG is off)
                    raise KeyboardInterrupt
                if ch == "\x04":  # Ctrl-D
                    done = True
                    break
                if not ch.isprintable():
                    continue  # ignore stray control bytes
                chars.append(ch)
                emit(mask)
    finally:
        termios.tcsetattr(read_fd, termios.TCSADRAIN, old)
        emit("\n")
        if opened:
            os.close(tty_fd)
    return "".join(chars)


def _prompt_secret_windows(prompt: str, mask: str) -> str:
    import msvcrt

    sys.stderr.write(prompt)
    sys.stderr.flush()
    chars: list[str] = []
    while True:
        ch = msvcrt.getwch()
        if ch in ("\r", "\n"):
            break
        if ch == "\x03":  # Ctrl-C
            raise KeyboardInterrupt
        if ch in ("\x00", "\xe0"):  # function/arrow key prefix
            msvcrt.getwch()  # discard the scan code that follows
            continue
        if ch == "\b":  # Backspace
            if chars:
                chars.pop()
                sys.stderr.write("\b \b")
                sys.stderr.flush()
            continue
        chars.append(ch)
        sys.stderr.write(mask)
        sys.stderr.flush()
    sys.stderr.write("\n")
    sys.stderr.flush()
    return "".join(chars)


def quote_env(value: str) -> str:
    if "'" in value or "\n" in value or "\r" in value:
        # shlex.quote encodes an embedded single quote as shell concatenation
        # ('don'"'"'t'), which no dotenv-style reader (parse_env_text,
        # python-dotenv, @next/env, the JS fleet parsers) can decode. Emit
        # double quotes with backslash escapes instead — the format the
        # collector's --import-stdin payloads already use.
        escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r")
        return f'"{escaped}"'
    if value == "" or any(ch.isspace() or ch in "#'\"\\$`" for ch in value):
        return shlex.quote(value)
    return value


def legacy_concat_value(raw_value: str) -> bool:
    """True when a raw line value is pre-fix shlex.quote concatenation."""
    value = raw_value.strip()
    return len(value) >= 2 and value[0] == value[-1] == "'" and "'" in value[1:-1]


@contextlib.contextmanager
def env_file_lock(path: pathlib.Path):
    """Serialize read-modify-write cycles on an env file across processes.

    Several independent writers hit the same env files (collector-relayed
    peer pushes, the dashboard /api/env route, manual CLI runs, setup), and
    an unsynchronized read-modify-write loses one writer's key. The lock is
    a sidecar file because atomic_write_text replaces the env file's inode
    on every write, so a lock on the env file itself would not persist
    across writes. Degrades to unlocked if the platform/filesystem cannot
    lock, rather than failing the write.
    """
    lock_path = path.with_name(path.name + ".lock")
    handle = None
    locked = False
    try:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            handle = open(lock_path, "a+")
            if os.name == "nt":
                import msvcrt

                handle.seek(0)
                msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)
            else:
                import fcntl

                fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            locked = True
        except OSError:
            pass
        yield
    finally:
        if handle is not None:
            if locked:
                try:
                    if os.name == "nt":
                        import msvcrt

                        handle.seek(0)
                        msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
                    else:
                        import fcntl

                        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
                except OSError:
                    pass
            handle.close()


def atomic_write_text(path: pathlib.Path, text: str) -> None:
    """Write via a same-directory temp file + rename.

    A plain write_text truncates in place, so a concurrent writer or reader
    can observe (or interleave with) a half-written file and corrupt it —
    the 2026-07-03 .env.local device-token line splice. mkstemp creates the
    temp 0o600, so the secret file is never readable by other users and the
    destination keeps that mode after the rename.
    """
    fd, tmp_name = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        for attempt in range(5):
            try:
                os.replace(tmp_name, path)
                break
            except PermissionError:
                # Windows refuses the rename while another process holds the
                # destination open; readers hold it only briefly.
                if attempt == 4:
                    raise
                time.sleep(0.05)
    except OSError:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise


def update_env_file(path: pathlib.Path, key: str, value: str) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    with env_file_lock(path):
        lines = path.read_text().splitlines() if path.exists() else []
        replacement = f"{key}={quote_env(value)}"
        found = False
        output: list[str] = []

        for line in lines:
            stripped = line.strip()
            if stripped.startswith("#") or "=" not in line:
                output.append(line)
                continue
            existing_key = line.split("=", 1)[0].removeprefix("export ").strip()
            if existing_key == key:
                if not found:
                    # Rewrite legacy shlex-concatenated lines even when the
                    # parsed value is unchanged, so touched keys heal into a
                    # form every dotenv-style reader can parse.
                    if parse_env_text(line).get(key) == value and not legacy_concat_value(line.split("=", 1)[1]):
                        output.append(line)
                    else:
                        output.append(replacement)
                    found = True
                continue
            output.append(line)

        if not found:
            if output and output[-1].strip():
                output.append("")
            output.append(replacement)

        next_text = "\n".join(output) + "\n"
        if path.exists() and path.read_text() == next_text:
            return False
        atomic_write_text(path, next_text)
        return True


def remove_env_file_key(path: pathlib.Path, key: str) -> bool:
    if not path.exists():
        return False
    with env_file_lock(path):
        lines = path.read_text().splitlines()
        output: list[str] = []
        for line in lines:
            stripped = line.strip()
            if stripped.startswith("#") or "=" not in line:
                output.append(line)
                continue
            existing_key = line.split("=", 1)[0].removeprefix("export ").strip()
            if existing_key == key:
                continue
            output.append(line)
        next_text = "\n".join(output).rstrip() + ("\n" if output else "")
        if path.read_text() == next_text:
            return False
        atomic_write_text(path, next_text)
        return True


def ensure_env_placeholder(path: pathlib.Path, key: str) -> bool:
    """Append "KEY=" only when the key is absent, for open-and-edit UI flows.

    Runs under the store lock so the read-modify-write can never drop a
    concurrent writer's key. Deliberately never touches the updatedAt meta:
    an empty placeholder with a fresh timestamp would win pull-reconcile on
    peers and delete their real value.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    with env_file_lock(path):
        if key in parse_env_file(path):
            return False
        lines = path.read_text().splitlines() if path.exists() else []
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(f"{key}=")
        atomic_write_text(path, "\n".join(lines) + "\n")
        return True


def env_meta_file(path: pathlib.Path) -> pathlib.Path:
    return path.with_name(path.name + ".meta.json")


def read_env_meta(path: pathlib.Path) -> dict[str, float]:
    meta_path = env_meta_file(path)
    if not meta_path.exists():
        return {}
    try:
        data = json.loads(meta_path.read_text())
    except json.JSONDecodeError:
        return {}
    if not isinstance(data, dict):
        return {}
    updated_at = data.get("updatedAt")
    if not isinstance(updated_at, dict):
        return {}
    return {str(key): float(value) for key, value in updated_at.items() if isinstance(value, (int, float))}


def write_env_meta(path: pathlib.Path, updated_at: dict[str, float]) -> None:
    meta_path = env_meta_file(path)
    meta_path.parent.mkdir(parents=True, exist_ok=True)
    next_text = json.dumps({"version": 1, "updatedAt": dict(sorted(updated_at.items()))}, indent=2) + "\n"
    if meta_path.exists() and meta_path.read_text() == next_text:
        return
    atomic_write_text(meta_path, next_text)


def touch_env_meta(path: pathlib.Path, keys: Iterable[str]) -> None:
    with env_file_lock(env_meta_file(path)):
        updated_at = read_env_meta(path)
        now = time.time()
        for key in keys:
            updated_at[key] = now
        write_env_meta(path, updated_at)


def read_json(path: pathlib.Path) -> dict[str, object]:
    if not path.exists():
        return {}
    try:
        raw = re.sub(r"//[^\n]*", "", path.read_text())
        return json.loads(raw)
    except json.JSONDecodeError:
        return {}


def read_plain_json(path: pathlib.Path) -> dict[str, object]:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
        return data if isinstance(data, dict) else {}
    except json.JSONDecodeError:
        return {}


def write_json(path: pathlib.Path, data: dict[str, object]) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    next_text = json.dumps(data, indent=2) + "\n"
    if path.exists() and path.read_text() == next_text:
        return False
    # mkstemp already creates the temp 0o600, and the rename keeps that mode.
    atomic_write_text(path, next_text)
    return True


def update_openclaw_stores(key: str, value: str) -> bool:
    secrets = read_json(OPENCLAW_SECRETS)
    if value == "":
        secrets.pop(key, None)
    else:
        secrets[key] = value
    changed = write_json(OPENCLAW_SECRETS, secrets)

    config = read_json(OPENCLAW_JSON)
    env = config.get("env")
    if not isinstance(env, dict):
        env = {}
    vars_ = env.get("vars")
    if not isinstance(vars_, dict):
        vars_ = {}
    if value == "":
        vars_.pop(key, None)
    else:
        vars_[key] = value
    env["vars"] = vars_
    config["env"] = env
    return write_json(OPENCLAW_JSON, config) or changed


def openclaw_values() -> dict[str, str]:
    values: dict[str, str] = {}
    config = read_json(OPENCLAW_JSON)
    env = config.get("env")
    config_vars = env.get("vars") if isinstance(env, dict) else {}
    for source in (read_json(OPENCLAW_SECRETS), config_vars):
        if isinstance(source, dict):
            for key, value in source.items():
                if isinstance(key, str) and isinstance(value, str):
                    values[key] = value
    return values


def aeon_repo(args: argparse.Namespace) -> str:
    return (
        args.aeon_repo
        or os.environ.get("AEON_REPO")
        or local_setting("AEON_REPO")
        or os.environ.get("NEXT_PUBLIC_AEON_REPO")
        or local_setting("NEXT_PUBLIC_AEON_REPO")
    ).strip()


def sync_aeon_github_secret(args: argparse.Namespace, key: str, value: str, quiet: bool = False) -> bool:
    if not args.sync_aeon_github_secret:
        return True
    repo = aeon_repo(args)
    if not repo:
        raise RuntimeError("Aeon GitHub secret sync requested, but no --aeon-repo or AEON_REPO is configured.")
    if shutil.which("gh") is None:
        raise RuntimeError("Aeon GitHub secret sync requested, but gh is not installed.")
    if value == "":
        gh_delete_secret(repo, key)
        if not quiet:
            print(f"removed Aeon GitHub secret {key} from {repo}")
        return True
    proc = subprocess.run(
        ["gh", "secret", "set", key, "-R", repo],
        input=value,
        text=True,
        capture_output=True,
        check=False,
        timeout=20,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise RuntimeError(f"failed to sync {key} to Aeon GitHub secrets for {repo}: {detail}")
    if not quiet:
        print(f"synced Aeon GitHub secret {key} to {repo}")
    return True


def normalize_github_repo(value: str) -> str:
    cleaned = value.strip().removesuffix(".git")
    github = re.search(r"github\.com[:/]([^/\s]+)\/([^/\s.]+)$", cleaned, re.I)
    owner_repo = re.match(r"^([^/\s]+)\/([^/\s.]+)$", cleaned)
    match = github or owner_repo
    if not match:
        return ""
    return f"{match.group(1)}/{match.group(2)}"


def configured_aeon_env_sync_repos() -> set[str]:
    repos: set[str] = set()
    configured = (
        os.environ.get("HIVE_AEON_ENV_SYNC_REPOS")
        or local_setting("HIVE_AEON_ENV_SYNC_REPOS")
        or os.environ.get("AEON_REPO")
        or local_setting("AEON_REPO")
        or os.environ.get("NEXT_PUBLIC_AEON_REPO")
        or local_setting("NEXT_PUBLIC_AEON_REPO")
    )
    for raw_repo in (configured or "").split(","):
        repo = normalize_github_repo(raw_repo)
        if repo:
            repos.add(repo)
    registry = read_plain_json(AEON_ENV_SYNC_REPOS_FILE)
    raw_repos = registry.get("repos")
    if isinstance(raw_repos, list):
        for raw_repo in raw_repos:
            if isinstance(raw_repo, str):
                repo = normalize_github_repo(raw_repo)
                if repo:
                    repos.add(repo)
            elif isinstance(raw_repo, dict):
                raw_name = raw_repo.get("repo") or raw_repo.get("aeonRepo")
                if isinstance(raw_name, str):
                    repo = normalize_github_repo(raw_name)
                    if repo:
                        repos.add(repo)
    return repos


def vault_aeon_env_sync_repos() -> set[str]:
    root = note_root()
    if not root:
        return set()
    repos: set[str] = set()
    for folder in ("Agents", "AGENTS"):
        base = root / folder
        if not base.exists():
            continue
        for profile_path in base.glob("**/profile.json"):
            data = read_plain_json(profile_path)
            if data.get("runtime") != "aeon":
                continue
            raw_repo = data.get("aeonRepo")
            if isinstance(raw_repo, str):
                repo = normalize_github_repo(raw_repo)
                if repo:
                    repos.add(repo)
    return repos


def read_aeon_env_sync_state() -> dict[str, object]:
    data = read_plain_json(AEON_ENV_SYNC_STATE_FILE)
    repos = data.get("repos")
    if not isinstance(repos, dict):
        data["repos"] = {}
    data["version"] = 1
    return data


def write_aeon_env_sync_state(state: dict[str, object]) -> None:
    write_json(AEON_ENV_SYNC_STATE_FILE, state)


def state_repo_names(state: dict[str, object]) -> set[str]:
    repos = state.get("repos")
    if not isinstance(repos, dict):
        return set()
    return {repo for repo in repos if isinstance(repo, str) and normalize_github_repo(repo)}


def aeon_env_sync_enabled() -> bool:
    configured = os.environ.get("HIVE_AEON_ENV_AUTO_SYNC") or local_setting("HIVE_AEON_ENV_AUTO_SYNC")
    if configured:
        return truthy(configured)
    return True


def gh_json(args: list[str], timeout: int = 20) -> object:
    proc = subprocess.run(
        ["gh", *args],
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise RuntimeError(detail or f"gh exited with {proc.returncode}")
    return json.loads(proc.stdout or "{}")


def github_repo_is_private(repo: str) -> bool:
    payload = gh_json(["repo", "view", repo, "--json", "isPrivate"], timeout=20)
    return isinstance(payload, dict) and payload.get("isPrivate") is True


def github_secret_names(repo: str) -> set[str]:
    payload = gh_json(["secret", "list", "-R", repo, "--json", "name"], timeout=20)
    if not isinstance(payload, list):
        return set()
    return {item.get("name") for item in payload if isinstance(item, dict) and isinstance(item.get("name"), str)}


def secret_fingerprint(value: str) -> str:
    digest = hashlib.sha256()
    digest.update(str(len(value)).encode("utf-8"))
    digest.update(b"\0")
    digest.update(value.encode("utf-8"))
    return digest.hexdigest()


def github_secret_skip_reason(key: str, value: str) -> str:
    if is_local_only(key):
        return "local-only"
    if not KEY_RE.match(key):
        return "invalid-name"
    if key.upper().startswith(("GITHUB_", "RUNNER_")):
        return "github-reserved-name"
    if not value:
        return "empty"
    if "\0" in value:
        return "nul-byte"
    return ""


def managed_repo_state(state: dict[str, object], repo: str) -> dict[str, object]:
    repos = state.setdefault("repos", {})
    if not isinstance(repos, dict):
        repos = {}
        state["repos"] = repos
    raw = repos.get(repo)
    if not isinstance(raw, dict):
        raw = {"secrets": {}}
        repos[repo] = raw
    secrets = raw.get("secrets")
    if not isinstance(secrets, dict):
        raw["secrets"] = {}
    return raw


def gh_set_secret(repo: str, key: str, value: str) -> None:
    proc = subprocess.run(
        ["gh", "secret", "set", key, "-R", repo],
        input=value,
        text=True,
        capture_output=True,
        check=False,
        timeout=30,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise RuntimeError(detail or f"gh secret set exited with {proc.returncode}")


def gh_delete_secret(repo: str, key: str) -> None:
    proc = subprocess.run(
        ["gh", "secret", "delete", key, "-R", repo, "--confirm"],
        text=True,
        capture_output=True,
        check=False,
        timeout=20,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise RuntimeError(detail or f"gh secret delete exited with {proc.returncode}")


def sync_aeon_repo_shared_env(repo: str, values: dict[str, str], state: dict[str, object]) -> dict[str, int | str]:
    repo_state = managed_repo_state(state, repo)
    secrets_state = repo_state.setdefault("secrets", {})
    if not isinstance(secrets_state, dict):
        secrets_state = {}
        repo_state["secrets"] = secrets_state

    if not github_repo_is_private(repo):
        deleted = 0
        for key in sorted(list(secrets_state.keys())):
            if KEY_RE.match(key):
                try:
                    gh_delete_secret(repo, key)
                    deleted += 1
                except RuntimeError:
                    pass
            secrets_state.pop(key, None)
        repo_state["private"] = False
        return {"repo": repo, "synced": 0, "deleted": deleted, "skipped": "public"}

    existing = github_secret_names(repo)
    synced = 0
    skipped = 0
    failed = 0
    for key, value in sorted(values.items()):
        if github_secret_skip_reason(key, value):
            skipped += 1
            continue
        fingerprint = secret_fingerprint(value)
        raw_previous = secrets_state.get(key)
        previous = raw_previous if isinstance(raw_previous, dict) else {}
        if previous.get("fingerprint") == fingerprint and key in existing:
            continue
        try:
            gh_set_secret(repo, key, value)
        except RuntimeError:
            failed += 1
            continue
        secrets_state[key] = {
            "fingerprint": fingerprint,
            "updatedAt": time.time(),
        }
        existing.add(key)
        synced += 1

    deleted = 0
    current_keys = {key for key, value in values.items() if not github_secret_skip_reason(key, value)}
    for key in sorted(list(secrets_state.keys())):
        if key in current_keys:
            continue
        try:
            gh_delete_secret(repo, key)
            deleted += 1
        except RuntimeError:
            pass
        secrets_state.pop(key, None)

    repo_state["private"] = True
    repo_state["checkedAt"] = time.time()
    return {"repo": repo, "synced": synced, "deleted": deleted, "skipped": skipped, "failed": failed}


def auto_sync_aeon_shared_env(args: argparse.Namespace, values: dict[str, str]) -> None:
    if not values or not aeon_env_sync_enabled() or shutil.which("gh") is None:
        return
    state = read_aeon_env_sync_state()
    repos = configured_aeon_env_sync_repos() | vault_aeon_env_sync_repos() | state_repo_names(state)
    if not repos:
        return
    results: list[dict[str, int | str]] = []
    failures: list[str] = []
    for repo in sorted(repos):
        try:
            results.append(sync_aeon_repo_shared_env(repo, values, state))
        except Exception as error:
            failures.append(f"{repo}: {error}")
    write_aeon_env_sync_state(state)
    synced = sum(int(result.get("synced", 0)) for result in results)
    deleted = sum(int(result.get("deleted", 0)) for result in results)
    failed = sum(int(result.get("failed", 0)) for result in results)
    public = [str(result["repo"]) for result in results if result.get("skipped") == "public"]
    if synced or deleted or failed or public:
        public_suffix = f"; restricted public repo{'s' if len(public) != 1 else ''}: {', '.join(public)}" if public else ""
        failed_suffix = f"; {failed} key write{'s' if failed != 1 else ''} failed" if failed else ""
        print(f"aeon env sync updated {synced} secret{'s' if synced != 1 else ''} and removed {deleted} stale secret{'s' if deleted != 1 else ''} across {len(results)} repo{'s' if len(results) != 1 else ''}{failed_suffix}{public_suffix}")
    if failures:
        print("aeon env sync skipped " + "; ".join(failures), file=sys.stderr)

def agent_env_file(args: argparse.Namespace) -> pathlib.Path:
    raw = (
        args.agent_env_file
        or os.environ.get("HIVE_AGENT_ENV_FILE")
        or workspace_path("envPath")
        or local_setting("HIVE_AGENT_ENV_FILE")
        or str(DEFAULT_AGENT_ENV_FILE)
    )
    return pathlib.Path(os.path.expanduser(raw)).resolve()


def note_root() -> pathlib.Path | None:
    raw = (
        os.environ.get("HIVE_NOTE_ROOT")
        or os.environ.get("HIVE_SHARED_BRAIN_PATH")
        or os.environ.get("NEXT_PUBLIC_OBSIDIAN_VAULT_PATH")
        or workspace_path("vaultPath")
        or local_setting("HIVE_NOTE_ROOT")
        or local_setting("HIVE_SHARED_BRAIN_PATH")
        or local_setting("NEXT_PUBLIC_OBSIDIAN_VAULT_PATH")
    )
    if not raw:
        return next((candidate.resolve() for candidate in DEFAULT_NOTE_ROOT_CANDIDATES if candidate.exists()), None)
    return pathlib.Path(os.path.expanduser(raw)).resolve()


def backup_dir() -> pathlib.Path | None:
    raw = os.environ.get("HIVE_ENV_BACKUP_DIR") or local_setting("HIVE_ENV_BACKUP_DIR")
    if raw:
        return pathlib.Path(os.path.expanduser(raw)).resolve()
    root = note_root()
    if not root:
        return None
    folder = (
        os.environ.get("HIVE_NOTE_SECURE_FOLDER")
        or local_setting("HIVE_NOTE_SECURE_FOLDER")
        or "Operations/Secure"
    )
    return root / folder


def public_key_candidates(directory: pathlib.Path) -> Iterable[pathlib.Path]:
    configured = os.environ.get("HIVE_ENV_PUBLIC_KEY") or local_setting("HIVE_ENV_PUBLIC_KEY")
    if configured:
        yield pathlib.Path(os.path.expanduser(configured)).resolve()
    yield directory / "hive-env-public-key.asc"
    yield directory / "liam-hermes-env-public-key.asc"


def import_public_key(path: pathlib.Path) -> str:
    show = subprocess.run(
        ["gpg", "--with-colons", "--import-options", "show-only", "--import", str(path)],
        text=True,
        capture_output=True,
        check=False,
    )
    if show.returncode != 0:
        return ""
    fingerprint = ""
    for line in show.stdout.splitlines():
        parts = line.split(":")
        if parts and parts[0] == "fpr" and len(parts) > 9:
            fingerprint = parts[9]
            break
    if fingerprint:
        subprocess.run(["gpg", "--import", str(path)], text=True, capture_output=True, check=False)
    return fingerprint


def refresh_encrypted_backup(env_file: pathlib.Path) -> str | None:
    directory = backup_dir()
    if not directory:
        return "No note root configured; skipped encrypted env backup."
    if shutil.which("gpg") is None:
        return "gpg is not installed; skipped encrypted env backup."

    recipient = os.environ.get("HIVE_ENV_GPG_RECIPIENT") or local_setting("HIVE_ENV_GPG_RECIPIENT")
    if not recipient:
        for candidate in public_key_candidates(directory):
            if candidate.exists():
                recipient = import_public_key(candidate)
                if recipient:
                    break
    if not recipient:
        return f"No HIVE_ENV_GPG_RECIPIENT or public key found in {directory}; skipped encrypted env backup."

    directory.mkdir(parents=True, exist_ok=True)
    output = directory / "hive.env.gpg"
    with tempfile.NamedTemporaryFile("w", delete=False) as tmp:
        tmp_path = pathlib.Path(tmp.name)
        tmp.write(env_file.read_text() if env_file.exists() else "")
    try:
        proc = subprocess.run(
            ["gpg", "--batch", "--yes", "--trust-model", "always", "--encrypt", "--recipient", recipient, "--output", str(output), str(tmp_path)],
            text=True,
            capture_output=True,
            check=False,
        )
    finally:
        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass
    if proc.returncode != 0:
        return f"Encrypted backup failed: {proc.stderr.strip() or proc.stdout.strip()}"
    output.chmod(0o600)
    return f"refreshed encrypted backup: {output}"


def backup_env_file(args: argparse.Namespace, env_file: pathlib.Path) -> pathlib.Path:
    if args.scope == "agent" and args.runtime == "generic":
        return agent_env_file(args)
    return env_file


def env_store_file(args: argparse.Namespace, env_file: pathlib.Path) -> pathlib.Path:
    if args.scope in ("all", "app"):
        return env_file
    if args.runtime == "hermes":
        return HERMES_ENV_FILE
    if args.runtime == "aeon":
        return AEON_ENV_FILE
    if args.runtime == "generic":
        return agent_env_file(args)
    return OPENCLAW_SECRETS


def backup_applies(args: argparse.Namespace) -> bool:
    return args.scope in ("all", "app") or (args.scope == "agent" and args.runtime == "generic")


def encrypted_backup_path() -> pathlib.Path | None:
    directory = backup_dir()
    if not directory:
        return None
    return directory / "hive.env.gpg"


def maybe_refresh_encrypted_backup(args: argparse.Namespace, env_file: pathlib.Path) -> None:
    if args.no_backup or not backup_applies(args):
        return
    message = refresh_encrypted_backup(backup_env_file(args, env_file))
    if message:
        print(message, file=sys.stderr if "failed" in message.lower() else sys.stdout)


def export_backup_status(args: argparse.Namespace, env_file: pathlib.Path) -> None:
    path = encrypted_backup_path()
    target = backup_env_file(args, env_file)
    payload = {
        "version": 1,
        "scope": args.scope,
        "runtime": args.runtime,
        "envFile": str(target),
        "backupPath": str(path) if path else "",
        "backupExists": bool(path and path.exists()),
        "gpgAvailable": shutil.which("gpg") is not None,
        "backupApplies": backup_applies(args),
    }
    print(json.dumps(payload, sort_keys=True))


def restore_encrypted_backup(args: argparse.Namespace, env_file: pathlib.Path) -> int:
    if not backup_applies(args):
        print("Encrypted backup restore only applies to app env or the generic shared agent env.", file=sys.stderr)
        return 2
    path = encrypted_backup_path()
    if not path:
        print("No note root configured; cannot find encrypted env backup.", file=sys.stderr)
        return 1
    if not path.exists():
        print(f"Encrypted env backup not found: {path}", file=sys.stderr)
        return 1
    if shutil.which("gpg") is None:
        print("gpg is not installed; cannot restore encrypted env backup.", file=sys.stderr)
        return 1

    target = backup_env_file(args, env_file)
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", delete=False) as tmp:
        tmp_path = pathlib.Path(tmp.name)
    try:
        proc = subprocess.run(
            ["gpg", "--decrypt", str(path)],
            text=True,
            capture_output=True,
            check=False,
            timeout=60,
        )
        if proc.returncode != 0:
            detail = (proc.stderr or proc.stdout).strip()
            print(detail or "Could not decrypt encrypted env backup.", file=sys.stderr)
            return 1
        tmp_path.write_text(proc.stdout)
        tmp_path.chmod(0o600)
        shutil.copyfile(tmp_path, target)
        target.chmod(0o600)
    finally:
        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass

    values = shared_env_values(args, env_file)
    print(f"restored {len(values)} env key{'s' if len(values) != 1 else ''} from encrypted backup")
    if not args.no_tailnet_sync:
        sync_tailnet_updates(args, values, env_file)
    if not args.no_aeon_auto_sync and args.runtime == "generic":
        auto_sync_aeon_shared_env(args, values)
    return 0


def tailscale_local_ips(data: dict[str, object]) -> set[str]:
    self_data = data.get("Self")
    if not isinstance(self_data, dict):
        return set()
    return {str(value) for value in self_data.get("TailscaleIPs") or []}


def local_machine_id() -> str:
    try:
        return MACHINE_ID_FILE.read_text().strip()
    except OSError:
        return ""


def tailnet_peer_status() -> tuple[list[dict[str, str]], list[str]]:
    """Enumerate online tailnet peers.

    Returns (ready collector targets, online peers without a ready collector).
    Peers in the second list are NOT silently dropped from sync accounting:
    callers must report them and keep undelivered updates queued.
    """
    configured = os.environ.get("HIVE_ENV_TAILNET_TARGETS") or local_setting("HIVE_ENV_TAILNET_TARGETS")
    if configured:
        targets = []
        unreachable = []
        for raw_target in sorted({target.strip() for target in configured.split(",") if target.strip()}):
            env_sync = env_sync_from_collector(raw_target)
            if env_sync:
                targets.append({"host": raw_target, "ip": raw_target, **env_sync})
            else:
                unreachable.append(raw_target)
        return targets, unreachable
    cli = tailscale_cli()
    if not cli:
        return [], []
    proc = subprocess.run([cli, "status", "--json"], text=True, capture_output=True, check=False)
    if proc.returncode != 0:
        return [], []
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return [], []

    local_ips = tailscale_local_ips(data)
    own_machine_id = local_machine_id()
    targets: list[dict[str, str]] = []
    unreachable: list[str] = []
    seen_machine_ids: set[str] = set()
    for peer in (data.get("Peer") or {}).values():
        if not isinstance(peer, dict) or peer.get("Online") is False:
            continue
        ip = next((str(value) for value in peer.get("TailscaleIPs") or [] if re.match(r"^\d+\.\d+\.\d+\.\d+$", str(value))), "")
        if not ip or ip in local_ips:
            continue
        target_host = str(peer.get("DNSName") or "").rstrip(".") or ip
        if str(peer.get("OS") or "").lower() in COLLECTORLESS_PEER_OS:
            continue  # skip before probing: phones never host a collector
        env_sync = env_sync_from_collector(ip)
        if not env_sync:
            unreachable.append(target_host)
            continue
        machine_id = env_sync.get("machineId") or ""
        # A machine can appear as two tailnet nodes (system tailscaled +
        # embedded hivemind-linkd); both reach the same collector.
        if machine_id and machine_id == own_machine_id:
            continue
        if machine_id and machine_id in seen_machine_ids:
            continue
        if machine_id:
            seen_machine_ids.add(machine_id)
        targets.append({"host": target_host, "ip": ip, **env_sync})
    targets = sorted(targets, key=lambda target: target["host"])
    return targets, sorted(drop_reachable_machine_duplicates(targets, unreachable))


def tailnet_node_identity(host: str) -> str:
    """Machine identity for a tailnet node name, matching the dashboard's
    convention: strip the hivemindos- linkd prefix, keep -N suffixes (those
    distinguish physically different machines that share a hostname)."""
    label = host.split(".", 1)[0].strip().lower()
    if label.startswith("hivemindos-"):
        label = label[len("hivemindos-"):]
    return label


def normalized_tailnet_dns(host: str) -> str:
    return host.strip().rstrip(".").lower()


def drop_reachable_machine_duplicates(targets: list[dict[str, str]], unreachable: list[str]) -> list[str]:
    """A machine appears as two tailnet nodes (system tailscaled + embedded
    hivemind-linkd). When the collector is loopback-bound behind linkd, only
    the linkd node answers; the system node must not count as an unreachable
    peer or queued env updates are stranded forever.

    The name heuristic alone goes blind after an OS hostname rename: the linkd
    tsnet node re-registers under the NEW name while the system node keeps its
    sticky MagicDNS name, so the two labels no longer share an identity. Ready
    collectors self-report their system node in /health (tailnetSelf), so also
    fold any unreachable node whose MagicDNS name a ready collector claims as
    its own. Match the unique sticky dnsName only — never tailnetSelf.name,
    which is the OS ComputerName and can be shared by distinct machines."""
    ready_identities = {tailnet_node_identity(target["host"]) for target in targets}
    ready_self_nodes = {
        normalized_tailnet_dns(target.get("tailnetSelfDnsName") or "") for target in targets
    } - {""}
    return [
        host
        for host in unreachable
        if tailnet_node_identity(host) not in ready_identities
        and normalized_tailnet_dns(host) not in ready_self_nodes
    ]


def tailscale_peer_targets() -> list[dict[str, str]]:
    return tailnet_peer_status()[0]


def delivery_id(target: dict[str, str]) -> str:
    return target.get("machineId") or target["host"]


def cached_peer_port(ip: str) -> str:
    ports = read_plain_json(ENV_SYNC_PEER_PORTS_FILE).get("ports")
    if isinstance(ports, dict):
        value = str(ports.get(ip) or "")
        if valid_port(value):
            return value
    return ""


def remember_peer_port(ip: str, port: str) -> None:
    data = read_plain_json(ENV_SYNC_PEER_PORTS_FILE)
    ports = data.get("ports") if isinstance(data.get("ports"), dict) else {}
    if ports.get(ip) == port:
        return
    ports[ip] = port
    try:
        write_json(ENV_SYNC_PEER_PORTS_FILE, {"version": 1, "ports": dict(sorted(ports.items()))})
    except Exception:
        pass  # cache only; probing still finds the port next run


def env_sync_from_collector(ip: str) -> dict[str, str] | None:
    ports = collector_ports()
    cached = cached_peer_port(ip)
    if cached and cached in ports:
        ports = [cached, *[port for port in ports if port != cached]]
    for port in ports:
        try:
            with urllib.request.urlopen(f"http://{ip}:{port}/health", timeout=4) as response:
                data = json.loads(response.read().decode("utf-8"))
        except Exception:
            continue
        capabilities = data.get("capabilities")
        if isinstance(capabilities, dict) and capabilities.get("envHttpSync") is not True:
            continue
        env_sync = data.get("envSync")
        if not isinstance(env_sync, dict) or env_sync.get("ready") is not True:
            continue
        user = str(env_sync.get("user") or "").strip()
        if KEY_RE.match(user.replace("-", "_")) or re.match(r"^[A-Za-z0-9._-]+$", user):
            remember_peer_port(ip, port)
            tailnet_self = data.get("tailnetSelf")
            return {
                "user": user,
                "port": port,
                "machineId": str(data.get("machineId") or ""),
                # The collector's system tailscaled node (sticky MagicDNS name);
                # lets peer dedup fold a renamed machine's two tailnet nodes.
                "tailnetSelfDnsName": str(tailnet_self.get("dnsName") or "").strip()
                if isinstance(tailnet_self, dict)
                else "",
            }
    return None


def target_candidates(target: str) -> list[str]:
    if "@" in target:
        return [target]
    configured_user = os.environ.get("HIVE_ENV_TAILNET_USER") or local_setting("HIVE_ENV_TAILNET_USER")
    if configured_user:
        return [f"{configured_user}@{target}"]
    return [target]


def tailnet_sync_enabled(args: argparse.Namespace) -> bool:
    return not args.no_tailnet_sync


def remote_hive_command(args: argparse.Namespace, key: str) -> str:
    remote_args = remote_update_args(args, key)
    return remote_hive_shell_command(remote_args)


def remote_hive_shell_command(remote_args: list[str]) -> str:
    quoted = " ".join(shlex.quote(part) for part in remote_args)
    return (
        "if command -v hive-env-add >/dev/null 2>&1; then "
        f"exec hive-env-add {quoted}; "
        "elif [ -x \"$HOME/.local/bin/hive-env-add\" ]; then "
        f"exec \"$HOME/.local/bin/hive-env-add\" {quoted}; "
        "else echo 'hive-env-add is not installed on this machine' >&2; exit 127; fi"
    )


def remote_update_args(args: argparse.Namespace, key: str) -> list[str]:
    remote_args = [
        "--stdin",
        "--scope", args.scope,
        "--runtime", args.runtime,
        "--no-backup",
        "--no-tailnet-sync",
    ]
    if args.env_file:
        remote_args.extend(["--env-file", args.env_file])
    if args.agent_env_file:
        remote_args.extend(["--agent-env-file", args.agent_env_file])
    remote_args.append(key)
    return remote_args


def sync_target_over_collector(target: dict[str, str], args: argparse.Namespace, updates: dict[str, str]) -> tuple[bool, str]:
    payload = json.dumps({
        "scope": args.scope,
        "runtime": args.runtime,
        "entries": updates,
    }).encode("utf-8")
    ports = [target["port"]] if target.get("port") else collector_ports()
    last_error = ""
    for port in ports:
        url = f"http://{target['ip']}:{port}/env"
        request = urllib.request.Request(url, data=payload, headers={"content-type": "application/json"}, method="POST")
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                data = json.loads(response.read().decode("utf-8") or "{}")
        except Exception as error:
            last_error = f"{port}: {error}"
            continue
        if data.get("ok") is True:
            return True, ""
        last_error = f"{port}: {data.get('error') or 'collector env sync failed'}"
    return False, last_error or "collector env sync failed"


def shared_env_values(args: argparse.Namespace, env_file: pathlib.Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if args.scope in ("all", "app"):
        values.update(parse_env_file(env_file))
    if args.scope in ("all", "agent"):
        if args.runtime == "openclaw":
            values.update(openclaw_values())
        elif args.runtime == "hermes":
            values.update(parse_env_file(HERMES_ENV_FILE))
        elif args.runtime == "aeon":
            values.update(parse_env_file(AEON_ENV_FILE))
        else:
            values.update(parse_env_file(agent_env_file(args)))
    return {
        key: value
        for key, value in values.items()
        if KEY_RE.match(key) and not is_local_only(key)
    }


def read_pending_state() -> dict[str, dict[str, object]]:
    data = read_plain_json(ENV_SYNC_PENDING_FILE)
    pending = data.get("pending")
    if not isinstance(pending, dict):
        return {}
    entries: dict[str, dict[str, object]] = {}
    for key, raw in pending.items():
        if not isinstance(key, str) or not KEY_RE.match(key) or not isinstance(raw, dict):
            continue
        delivered_raw = raw.get("delivered")
        delivered = (
            {str(host): float(value) for host, value in delivered_raw.items() if isinstance(value, (int, float))}
            if isinstance(delivered_raw, dict)
            else {}
        )
        ts = raw.get("ts")
        entries[key] = {
            "ts": float(ts) if isinstance(ts, (int, float)) else 0.0,
            "scope": str(raw.get("scope") or "agent"),
            "runtime": str(raw.get("runtime") or "generic"),
            "delivered": delivered,
        }
    return entries


def write_pending_state(entries: dict[str, dict[str, object]]) -> None:
    write_json(ENV_SYNC_PENDING_FILE, {"version": 1, "pending": dict(sorted(entries.items()))})


def tailnet_verbose() -> bool:
    return truthy(os.environ.get("HIVE_ENV_TAILNET_VERBOSE") or local_setting("HIVE_ENV_TAILNET_VERBOSE"))


def pinned_targets_hint() -> str:
    """Pinned raw-IP targets go stale and have blackholed sync before; make the pin visible."""
    if os.environ.get("HIVE_ENV_TAILNET_TARGETS") or local_setting("HIVE_ENV_TAILNET_TARGETS"):
        return " [targets pinned via HIVE_ENV_TAILNET_TARGETS; prefer auto-discovery — pinned IPs go stale]"
    return ""


def record_pending_outcome(
    args: argparse.Namespace,
    updates: dict[str, str],
    succeeded: list[dict[str, str]],
    fully_delivered: bool,
) -> None:
    entries = read_pending_state()
    now = time.time()
    changed = False
    for key in updates:
        if is_local_only(key) or not KEY_RE.match(key):
            continue
        if fully_delivered:
            if key in entries:
                del entries[key]
                changed = True
            continue
        existing = entries.get(key)
        delivered = dict(existing["delivered"]) if existing else {}
        for target in succeeded:
            delivered[delivery_id(target)] = now
        entries[key] = {
            "ts": now,
            "scope": args.scope,
            "runtime": args.runtime,
            "delivered": delivered,
        }
        changed = True
    if changed:
        write_pending_state(entries)


def sync_tailnet_updates(
    args: argparse.Namespace,
    updates: dict[str, str],
    env_file: pathlib.Path | None = None,
) -> None:
    if not updates or not tailnet_sync_enabled(args):
        return
    targets, unreachable = tailnet_peer_status()
    if not targets:
        suffix = (
            f" ({len(unreachable)} online peer{'s' if len(unreachable) != 1 else ''} without a ready collector; update queued for retry)"
            if unreachable
            else ""
        )
        print("Hivemind Sync env sync is enabled, but no online ready peers were found" + suffix + pinned_targets_hint())
        record_pending_outcome(args, updates, succeeded=[], fully_delivered=False)
        return

    synced = 0
    failed: list[str] = []
    succeeded: list[dict[str, str]] = []
    for target in targets:
        ok, detail = sync_target_over_collector(target, args, updates)
        if ok:
            synced += 1
            succeeded.append(target)
        else:
            failed.append(f"{target['host']}: {detail}")

    fully_delivered = not failed and not unreachable
    record_pending_outcome(args, updates, succeeded=succeeded, fully_delivered=fully_delivered)

    if synced:
        print(f"Hivemind Sync env updated {synced} peer{'s' if synced != 1 else ''}")
    if failed or unreachable:
        attempted_targets = len(targets) + len(unreachable)
        not_ready = len(failed) + len(unreachable)
        if tailnet_verbose():
            details = failed + [f"{host}: no ready collector" for host in unreachable]
            print(
                "Hivemind Sync env queued for retry on "
                + ", ".join(details)
                + " (run setup on that machine and ensure the telemetry collector is reachable)",
                file=sys.stderr,
            )
        else:
            print(
                f"Hivemind Sync env: {not_ready} of {attempted_targets} peer{'s' if attempted_targets != 1 else ''} not ready; update queued for retry (set HIVE_ENV_TAILNET_VERBOSE=true for details)"
                + pinned_targets_hint(),
                file=sys.stderr,
            )
    if env_file is not None:
        try:
            drain_pending(args, env_file, exclude=set(updates), quiet=not tailnet_verbose(), peers=(targets, unreachable))
        except Exception as error:
            print(f"Hivemind Sync env retry queue error: {error}", file=sys.stderr)


def drain_pending(
    args: argparse.Namespace,
    env_file: pathlib.Path,
    exclude: set[str] | None = None,
    quiet: bool = False,
    peers: tuple[list[dict[str, str]], list[str]] | None = None,
) -> dict[str, object]:
    """Retry queued env updates that have not reached every peer collector yet.

    Values are read fresh from the local store at drain time; the queue file
    only holds key names, timestamps, and per-machine delivery receipts.
    """
    entries = read_pending_state()
    now = time.time()
    changed = False
    summary: dict[str, object] = {"retriedKeys": [], "deliveredTo": [], "expired": 0, "remaining": 0, "unreachable": []}

    for key in list(entries):
        if now - float(entries[key]["ts"]) > ENV_SYNC_PENDING_MAX_AGE_SECONDS:
            del entries[key]
            changed = True
            summary["expired"] = int(summary["expired"]) + 1

    work = {key: entry for key, entry in entries.items() if not exclude or key not in exclude}
    if work:
        targets, unreachable = peers if peers is not None else tailnet_peer_status()
        summary["unreachable"] = unreachable
        group_values: dict[tuple[str, str], dict[str, str]] = {}
        group_meta: dict[tuple[str, str], dict[str, float]] = {}
        group_args_cache: dict[tuple[str, str], argparse.Namespace] = {}

        def group_context(scope: str, runtime: str) -> tuple[argparse.Namespace, dict[str, str], dict[str, float]]:
            pair = (scope, runtime)
            if pair not in group_args_cache:
                namespace = argparse.Namespace(**vars(args))
                namespace.scope, namespace.runtime = pair
                group_args_cache[pair] = namespace
                group_values[pair] = shared_env_values(namespace, env_file)
                group_meta[pair] = read_env_meta(env_store_file(namespace, env_file))
            return group_args_cache[pair], group_values[pair], group_meta[pair]

        pushes: dict[str, dict[tuple[str, str], dict[str, str]]] = {}
        target_by_id = {delivery_id(target): target for target in targets}
        for key, entry in list(work.items()):
            scope, runtime = str(entry["scope"]), str(entry["runtime"])
            _, values, meta = group_context(scope, runtime)
            if key in values:
                value = values[key]
            elif key in meta:
                value = ""  # key was removed locally; propagate the removal
            else:
                del entries[key]
                changed = True
                continue
            delivered = entry["delivered"]
            for target_id, target in target_by_id.items():
                if float(delivered.get(target_id, 0)) >= float(entry["ts"]):
                    continue
                pushes.setdefault(target_id, {}).setdefault((scope, runtime), {})[key] = value

        delivered_targets: set[str] = set()
        for target_id, groups in pushes.items():
            target = target_by_id[target_id]
            target_ok = True
            for (scope, runtime), updates in groups.items():
                group_namespace, _, _ = group_context(scope, runtime)
                ok, detail = sync_target_over_collector(target, group_namespace, updates)
                if ok:
                    push_time = time.time()
                    for key in updates:
                        entries[key]["delivered"][target_id] = push_time
                        if key not in summary["retriedKeys"]:
                            summary["retriedKeys"].append(key)
                    changed = True
                else:
                    target_ok = False
                    if not quiet:
                        print(f"Hivemind Sync env retry to {target['host']} failed: {detail}", file=sys.stderr)
            if target_ok:
                delivered_targets.add(target["host"])
        summary["deliveredTo"] = sorted(delivered_targets)

        if targets and not unreachable:
            for key in list(work):
                if key not in entries:
                    continue
                delivered = entries[key]["delivered"]
                if all(float(delivered.get(target_id, 0)) >= float(entries[key]["ts"]) for target_id in target_by_id):
                    del entries[key]
                    changed = True

    summary["remaining"] = len(entries)
    if changed:
        write_pending_state(entries)
    if not quiet and summary["retriedKeys"]:
        print(
            f"Hivemind Sync env retried {len(summary['retriedKeys'])} queued key{'s' if len(summary['retriedKeys']) != 1 else ''}"
            + (f" to {', '.join(summary['deliveredTo'])}" if summary["deliveredTo"] else "")
        )
    return summary


def fetch_peer_env(target: dict[str, str], args: argparse.Namespace) -> dict[str, object] | None:
    url = f"http://{target['ip']}:{target['port']}/env?scope={args.scope}&runtime={args.runtime}"
    try:
        with urllib.request.urlopen(url, timeout=20) as response:
            data = json.loads(response.read().decode("utf-8"))
    except Exception:
        return None
    if not isinstance(data, dict) or data.get("ok") is not True:
        return None
    return data


def pull_reconcile(
    args: argparse.Namespace,
    env_file: pathlib.Path,
    dry_run: bool = False,
    quiet: bool = False,
    peers: tuple[list[dict[str, str]], list[str]] | None = None,
) -> dict[str, object]:
    """Pull shared env keys from every ready peer collector and merge newer keys.

    Newest-wins per key using the per-key updatedAt metadata that every store
    keeps next to its env file. Keys removed locally keep a meta timestamp
    (tombstone), so a peer that still holds an older copy cannot resurrect it.
    Assumes tailnet machines keep reasonable NTP clock sync.
    """
    targets, unreachable = peers if peers is not None else tailnet_peer_status()
    store = env_store_file(args, env_file)
    local_meta = read_env_meta(store)
    local_values = shared_env_values(args, env_file)
    summary: dict[str, object] = {
        "peers": [target["host"] for target in targets],
        "unreachable": unreachable,
        "pulled": [],
        "skippedUnknownAge": [],
        "dryRun": dry_run,
    }

    # key -> (value, remote ts, source host); keep the newest copy across peers
    candidates: dict[str, tuple[str, float, str]] = {}
    for target in targets:
        data = fetch_peer_env(target, args)
        if data is None:
            summary["unreachable"] = sorted({*summary["unreachable"], target["host"]})
            continue
        raw_values = data.get("values")
        raw_updated = data.get("updatedAt")
        if not isinstance(raw_values, dict):
            continue
        updated_at = raw_updated if isinstance(raw_updated, dict) else {}
        for key, value in raw_values.items():
            if not isinstance(key, str) or not isinstance(value, str):
                continue
            if not KEY_RE.match(key) or is_local_only(key):
                continue
            remote_ts_raw = updated_at.get(key)
            remote_ts = float(remote_ts_raw) if isinstance(remote_ts_raw, (int, float)) else 0.0
            best = candidates.get(key)
            if best is None or remote_ts > best[1]:
                candidates[key] = (value, remote_ts, target["host"])

    to_apply: dict[str, tuple[str, float, str]] = {}
    for key, (value, remote_ts, source) in sorted(candidates.items()):
        local_ts = local_meta.get(key, 0.0)
        if key in local_values:
            if local_values[key] == value:
                continue
            if remote_ts <= local_ts:
                continue
            if local_ts == 0.0:
                # local copy exists but has no recorded age; do not overwrite blind
                summary["skippedUnknownAge"].append(key)
                continue
        elif local_ts and remote_ts <= local_ts:
            continue  # tombstoned: removed locally after the peer's copy was written
        to_apply[key] = (value, remote_ts, source)

    summary["pulled"] = sorted(to_apply)
    if dry_run or not to_apply:
        if not quiet and dry_run and to_apply:
            print("Hivemind Sync env pull-reconcile would pull: " + ", ".join(sorted(to_apply)))
        return summary

    changed = False
    for key, (value, _, _) in to_apply.items():
        changed = apply_update(args, env_file, key, value, quiet=True) or changed

    # adopt the origin's timestamps so reconcile converges instead of ping-ponging
    with env_file_lock(env_meta_file(store)):
        meta = read_env_meta(store)
        for key, (_, remote_ts, _) in to_apply.items():
            if remote_ts > 0:
                meta[key] = remote_ts
        write_env_meta(store, meta)

    # pulled values supersede anything this machine still had queued for those keys
    entries = read_pending_state()
    dropped = False
    for key, (_, remote_ts, _) in to_apply.items():
        entry = entries.get(key)
        if entry and remote_ts >= float(entry["ts"]):
            del entries[key]
            dropped = True
    if dropped:
        write_pending_state(entries)

    maybe_refresh_encrypted_backup(args, env_file)
    auto_sync_aeon_if_shared_agent_changed(args, env_file, changed)
    if not quiet:
        sources = sorted({source for (_, _, source) in to_apply.values()})
        print(
            f"Hivemind Sync env pulled {len(to_apply)} key{'s' if len(to_apply) != 1 else ''} from {', '.join(sources)}: "
            + ", ".join(sorted(to_apply))
        )
    return summary


def push_missing_enabled() -> bool:
    """Push-missing is on by default; HIVE_ENV_PUSH_MISSING=0 disables it."""
    raw = os.environ.get("HIVE_ENV_PUSH_MISSING")
    if raw is None:
        raw = local_setting("HIVE_ENV_PUSH_MISSING")
    if raw is None or str(raw).strip() == "":
        return True
    return truthy(raw)


def push_missing_reconcile(
    args: argparse.Namespace,
    env_file: pathlib.Path,
    dry_run: bool = False,
    quiet: bool = False,
    peers: tuple[list[dict[str, str]], list[str]] | None = None,
) -> dict[str, object]:
    """Push locally-held keys to any reachable peer that is entirely MISSING them.

    pull_reconcile only PULLS newer keys from peers, so a key that lives only on
    a machine its peers cannot reach inbound (e.g. a laptop the VPS can't dial,
    but which can dial out) strands forever and silently: the holder reaches the
    peer yet never pushes. This fills genuine gaps — and ONLY gaps: it never
    pushes a key the peer already holds, so it cannot clobber a peer's newer
    value or ping-pong (unlike a blind full-push, which the receiver stamps
    newest-on-receipt). Run AFTER pull_reconcile so the local copy is already
    up to date before it seeds peers. Kill switch: HIVE_ENV_PUSH_MISSING=0.

    Known residual: a key deleted on a peer during a partition but still live
    locally could be re-seeded once (the peer's /env GET can't expose its
    tombstone). Rare and self-correcting; the complete fix is receiver-side
    timestamp/tombstone honoring on the /env POST ingest.
    """
    if not push_missing_enabled() or not tailnet_sync_enabled(args):
        return {"pushed": {}, "peers": [], "disabled": not push_missing_enabled()}
    targets, unreachable = peers if peers is not None else tailnet_peer_status()
    local_values = shared_env_values(args, env_file)
    summary: dict[str, object] = {
        "peers": [target["host"] for target in targets],
        "unreachable": list(unreachable),
        "pushed": {},
        "dryRun": dry_run,
    }
    for target in targets:
        data = fetch_peer_env(target, args)
        if data is None:
            summary["unreachable"] = sorted({*summary["unreachable"], target["host"]})
            continue
        peer_values = data.get("values") if isinstance(data.get("values"), dict) else {}
        missing = {
            key: value
            for key, value in local_values.items()
            if key not in peer_values
            and value != ""
            and KEY_RE.match(key)
            and not is_local_only(key)
        }
        if not missing:
            continue
        summary["pushed"][target["host"]] = sorted(missing)
        if dry_run:
            continue
        ok, detail = sync_target_over_collector(target, args, missing)
        if not ok:
            summary.setdefault("failed", {})[target["host"]] = detail
    if not quiet:
        seeded = sorted({key for keys in summary["pushed"].values() for key in keys})
        if seeded:
            print(f"Hivemind Sync env push-missing seeded {len(seeded)} key(s) to peers: " + ", ".join(seeded))
    return summary


def backfill_meta_enabled() -> bool:
    """Meta backfill is on by default; HIVE_ENV_BACKFILL_META=0 disables it."""
    raw = os.environ.get("HIVE_ENV_BACKFILL_META")
    if raw is None:
        raw = local_setting("HIVE_ENV_BACKFILL_META")
    if raw is None or str(raw).strip() == "":
        return True
    return truthy(raw)


def backfill_missing_meta(
    args: argparse.Namespace,
    env_file: pathlib.Path,
    dry_run: bool = False,
    quiet: bool = False,
) -> dict[str, object]:
    """Stamp any local env key that has no .env.meta.json timestamp.

    A key lands in the shared env file with no per-key updatedAt entry whenever
    something writes it outside the sanctioned apply_update path (a raw file
    edit, an out-of-repo tool, an older writer). pull_reconcile then reads its
    age as 0.0 and treats it as UnknownAge, refusing to overwrite it, while
    export_json serves it as updatedAt=0 so peers won't adopt it either — the
    key is frozen out of sync in BOTH directions and silently diverges the
    moment anyone edits it on one machine. Stamping a real timestamp makes the
    key sync-eligible again, so no key stays stranded regardless of how it was
    written. Run FIRST in --sync-maintenance so the stamped keys take part in
    the same cycle's pull/push. Kill switch: HIVE_ENV_BACKFILL_META=0.

    Only stamps keys PRESENT in the env file but ABSENT from meta, so it never
    disturbs an existing stamp and never resurrects a tombstone (a removed key
    keeps its meta entry but is absent from the values, so it is not eligible).
    """
    store = env_store_file(args, env_file)
    values = shared_env_values(args, env_file)
    meta = read_env_meta(store)
    missing = sorted(key for key in values if key not in meta)
    summary: dict[str, object] = {
        "stamped": missing,
        "dryRun": dry_run,
        "disabled": not backfill_meta_enabled(),
    }
    if not backfill_meta_enabled() or not missing or dry_run:
        if not quiet and missing and dry_run:
            print("Hivemind Sync env meta-backfill would stamp: " + ", ".join(missing))
        return summary
    touch_env_meta(store, missing)
    if not quiet:
        print(f"Hivemind Sync env meta-backfill stamped {len(missing)} unsynced key(s): " + ", ".join(missing))
    return summary


def export_json(args: argparse.Namespace, env_file: pathlib.Path) -> None:
    values = shared_env_values(args, env_file)
    updated_at = read_env_meta(env_store_file(args, env_file))
    payload = {
        "version": 1,
        "scope": args.scope,
        "runtime": args.runtime,
        "values": values,
        "updatedAt": {key: updated_at.get(key, 0) for key in values},
    }
    print(json.dumps(payload, sort_keys=True))


def pull_from_peer(args: argparse.Namespace, env_file: pathlib.Path, target: str) -> int:
    command = remote_hive_shell_command([
        "--export-json",
        "--scope", args.scope,
        "--runtime", args.runtime,
    ])
    proc = subprocess.run(
        ["tailscale", "ssh", target, command],
        text=True,
        capture_output=True,
        check=False,
        timeout=30,
    )
    if proc.returncode != 0:
        print((proc.stderr or proc.stdout).strip() or f"could not pull env from {target}", file=sys.stderr)
        return 1
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        print(f"{target} did not return valid hive-env-add export JSON", file=sys.stderr)
        return 1
    raw_values = payload.get("values")
    if not isinstance(raw_values, dict):
        print(f"{target} returned no env values", file=sys.stderr)
        return 1
    incoming = {key: value for key, value in raw_values.items() if isinstance(key, str) and isinstance(value, str) and KEY_RE.match(key)}
    current = shared_env_values(args, env_file)
    applied = 0
    changed = False
    applied_values: dict[str, str] = {}
    skipped = 0
    conflicts: list[str] = []
    for key, value in incoming.items():
        if key in current and current[key] != value:
            if args.conflict == "fail":
                conflicts.append(key)
                continue
            if args.conflict == "local-wins":
                skipped += 1
                continue
        changed = apply_update(args, env_file, key, value, quiet=True) or changed
        applied += 1
        applied_values[key] = value
    if conflicts:
        print("conflicting keys: " + ", ".join(sorted(conflicts)), file=sys.stderr)
        return 1
    print(f"pulled {applied} env key{'s' if applied != 1 else ''} from {target}" + (f"; skipped {skipped} local conflict{'s' if skipped != 1 else ''}" if skipped else ""))
    if applied:
        maybe_refresh_encrypted_backup(args, env_file)
    if applied and not args.no_tailnet_sync:
        sync_tailnet_updates(args, applied_values, env_file)
    auto_sync_aeon_if_shared_agent_changed(args, env_file, changed)
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Add or update a HivemindOS env var in the canonical shared hive env.",
    )
    parser.add_argument("assignment", nargs="?", help="KEY=value, or KEY to prompt for the value")
    parser.add_argument("--env-file", default="")
    parser.add_argument("--agent-env-file", default="")
    parser.add_argument("--scope", choices=("all", "app", "agent"), default="agent")
    parser.add_argument(
        "--runtime",
        choices=("generic", "hermes", "aeon", "openclaw"),
        default=os.environ.get("HIVE_AGENT_RUNTIME", "generic"),
        help="Compatibility target for --scope agent. Default generic writes the canonical shared hive env.",
    )
    parser.add_argument(
        "--import-env",
        action="store_true",
        help="Import every valid key from the existing Hermes env source into the canonical shared hive env or selected scope.",
    )
    parser.add_argument(
        "--import-stdin",
        action="store_true",
        help="Import .env assignments from stdin into the selected hive scope.",
    )
    parser.add_argument(
        "--reconcile",
        action="store_true",
        help="Push the current shared env set from this machine to every ready Tailnet peer.",
    )
    parser.add_argument(
        "--pull-from",
        default="",
        metavar="USER@HOST",
        help="Pull shared env keys from a trusted Tailnet peer and merge them into this machine.",
    )
    parser.add_argument(
        "--retry-pending",
        action="store_true",
        help="Retry queued env updates that have not reached every peer collector yet.",
    )
    parser.add_argument(
        "--pull-reconcile",
        action="store_true",
        help="Pull shared env keys from every ready peer collector and merge newer keys into this machine (newest-wins by per-key updatedAt).",
    )
    parser.add_argument(
        "--push-missing",
        action="store_true",
        help="Seed every ready peer collector with the keys it is entirely missing (fills strands a pull can't reach). Never overwrites a value a peer already holds.",
    )
    parser.add_argument(
        "--backfill-meta",
        action="store_true",
        help="Stamp any local env key missing a .env.meta.json timestamp so it becomes sync-eligible (heals keys written outside the sanctioned path). Never touches existing stamps or tombstones.",
    )
    parser.add_argument(
        "--sync-maintenance",
        action="store_true",
        help="Run the meta backfill, retry queue, pull-reconcile, and push-missing once, then print a JSON summary. Used by the telemetry collector's periodic loop.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="With --pull-reconcile or --sync-maintenance, report what would change without writing.",
    )
    parser.add_argument(
        "--conflict",
        choices=("local-wins", "remote-wins", "fail"),
        default="local-wins",
        help="Conflict policy for --pull-from. Defaults to preserving local values.",
    )
    parser.add_argument(
        "--export-json",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--backup-status",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--restore-backup",
        action="store_true",
        help="Restore this env store from the encrypted shared-note backup, then sync it to ready Tailnet peers.",
    )
    parser.add_argument(
        "--stdin",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--ensure-placeholder",
        action="store_true",
        help="With a bare KEY: add 'KEY=' to the target env file only if the key is absent, under the store lock. Never stamps updatedAt meta, backs up, or syncs — for UI flows that open the file for manual editing.",
    )
    parser.add_argument("--no-backup", action="store_true", help="Skip encrypted shared-note backup refresh")
    parser.add_argument("--no-tailnet-sync", action="store_true", help="Do not replicate this update to ready Tailnet collectors")
    parser.add_argument("--no-aeon-auto-sync", action="store_true", help="Do not sync changed shared env values to managed private AEON GitHub repos")
    parser.add_argument("--aeon-repo", default="", help="owner/repo target for --sync-aeon-github-secret")
    parser.add_argument(
        "--sync-aeon-github-secret",
        action="store_true",
        help="When --runtime aeon is selected, also set the key as a GitHub Actions secret on the Aeon repo.",
    )
    return parser.parse_args()


def apply_update(args: argparse.Namespace, env_file: pathlib.Path, key: str, value: str, quiet: bool = False) -> bool:
    touched_file = env_store_file(args, env_file)
    changed = False
    if args.scope in ("all", "app"):
        if value == "":
            changed = remove_env_file_key(env_file, key) or changed
        else:
            changed = update_env_file(env_file, key, value) or changed
        if not quiet:
            print(f"updated app env {env_file}: {key}")
    if args.scope in ("all", "agent"):
        if args.runtime == "openclaw":
            changed = update_openclaw_stores(key, value) or changed
            if not quiet:
                print(f"updated OpenClaw runtime secret stores: {key}")
        elif args.runtime == "hermes":
            if value == "":
                changed = remove_env_file_key(HERMES_ENV_FILE, key) or changed
            else:
                changed = update_env_file(HERMES_ENV_FILE, key, value) or changed
            if not quiet:
                print(f"updated Hermes runtime env: {key}")
        elif args.runtime == "aeon":
            if value == "":
                changed = remove_env_file_key(AEON_ENV_FILE, key) or changed
            else:
                changed = update_env_file(AEON_ENV_FILE, key, value) or changed
            if not quiet:
                print(f"updated Aeon runtime env: {key}")
            sync_aeon_github_secret(args, key, value, quiet=quiet)
        else:
            path = agent_env_file(args)
            if value == "":
                changed = remove_env_file_key(path, key) or changed
            else:
                changed = update_env_file(path, key, value) or changed
            if not quiet:
                print(f"updated canonical shared hive env {path}: {key}")
    if changed:
        touch_env_meta(touched_file, [key])
    return changed


def auto_sync_aeon_if_shared_agent_changed(args: argparse.Namespace, env_file: pathlib.Path, changed: bool) -> None:
    if not changed or args.no_aeon_auto_sync:
        return
    if args.scope not in ("all", "agent") or args.runtime != "generic":
        return
    auto_sync_aeon_shared_env(args, shared_env_values(args, env_file))


def propagate_with_progress(
    args: argparse.Namespace,
    env_file: pathlib.Path,
    key: str,
    value: str,
    changed: bool,
) -> None:
    """Run the slow post-write steps under a spinner so the terminal doesn't
    look hung.

    After the local write, hive-env-add refreshes the encrypted backup (GPG),
    pushes the key to every online tailnet peer's collector (each probe has a
    multi-second timeout — the reported 5-10s "hang"), and syncs agent
    secrets. On a TTY we animate a spinner and buffer the phases' own result
    lines, flushing them once the spinner clears so they land cleanly below
    it. Non-TTY callers (the desktop app, shell pipes) skip both the spinner
    and the buffering — byte-for-byte identical to the previous behavior.
    """

    def run_phases(spinner: Spinner | None = None) -> None:
        maybe_refresh_encrypted_backup(args, env_file)
        if spinner is not None:
            spinner.set_message(f"Propagating {key} to fleet peers…")
        sync_tailnet_updates(args, {key: value}, env_file)
        if spinner is not None:
            spinner.set_message(f"Syncing {key} to agent secrets…")
        auto_sync_aeon_if_shared_agent_changed(args, env_file, changed)

    stderr = sys.stderr
    animate = (
        hasattr(stderr, "isatty")
        and stderr.isatty()
        and not truthy(os.environ.get("HIVE_ENV_NO_SPINNER"))
    )
    if not animate:
        run_phases()
        return

    out_buffer, err_buffer = io.StringIO(), io.StringIO()
    try:
        with Spinner(f"Refreshing backup for {key}…", stream=stderr) as spinner:
            with contextlib.redirect_stdout(out_buffer), contextlib.redirect_stderr(err_buffer):
                run_phases(spinner)
    finally:
        sys.stdout.write(out_buffer.getvalue())
        sys.stdout.flush()
        sys.stderr.write(err_buffer.getvalue())
        sys.stderr.flush()


def main() -> int:
    args = parse_args()
    env_file = pathlib.Path(os.path.expanduser(
        args.env_file
        or os.environ.get("HIVE_ENV_FILE")
        or local_setting("HIVE_ENV_FILE")
        or str(DEFAULT_ENV_FILE)
    )).resolve()

    if args.export_json:
        export_json(args, env_file)
        return 0

    if args.backup_status:
        export_backup_status(args, env_file)
        return 0

    if args.restore_backup:
        return restore_encrypted_backup(args, env_file)

    if args.pull_from:
        return pull_from_peer(args, env_file, args.pull_from)

    if args.sync_maintenance:
        peers = tailnet_peer_status()
        # Stamp any locally-present key that has no meta timestamp FIRST, so a
        # key written outside the sanctioned path (raw edit, out-of-repo tool)
        # stops reading as UnknownAge and takes part in this same cycle's sync
        # instead of silently freezing out of reconcile forever.
        backfill_summary = backfill_missing_meta(args, env_file, dry_run=args.dry_run, quiet=True)
        drain_summary = drain_pending(args, env_file, quiet=True, peers=peers)
        # Pull first (adopt anything newer from peers), THEN seed peers with the
        # keys they're missing — so a strand on a hard-to-reach holder heals
        # automatically instead of waiting on a manual --reconcile.
        pull_summary = pull_reconcile(args, env_file, dry_run=args.dry_run, quiet=True, peers=peers)
        push_summary = push_missing_reconcile(args, env_file, dry_run=args.dry_run, quiet=True, peers=peers)
        print(json.dumps({"version": 1, "backfill": backfill_summary, "retry": drain_summary, "pull": pull_summary, "push": push_summary}, sort_keys=True))
        return 0

    if args.retry_pending:
        summary = drain_pending(args, env_file, quiet=False)
        retried = summary["retriedKeys"]
        if not retried:
            print(
                f"Hivemind Sync env retry queue: nothing to deliver ({summary['remaining']} entr{'ies' if summary['remaining'] != 1 else 'y'} still queued)"
            )
        return 0

    if args.pull_reconcile:
        pull_reconcile(args, env_file, dry_run=args.dry_run)
        return 0

    if args.push_missing:
        summary = push_missing_reconcile(args, env_file, dry_run=args.dry_run)
        if args.dry_run:
            print(json.dumps(summary, sort_keys=True))
        return 0

    if args.backfill_meta:
        summary = backfill_missing_meta(args, env_file, dry_run=args.dry_run)
        if args.dry_run:
            print(json.dumps(summary, sort_keys=True))
        return 0

    if args.reconcile:
        values = shared_env_values(args, env_file)
        if not values:
            print("No local shared env keys found to reconcile.", file=sys.stderr)
            return 1
        sync_tailnet_updates(args, values, env_file)
        maybe_refresh_encrypted_backup(args, env_file)
        if not args.no_aeon_auto_sync and args.runtime == "generic":
            auto_sync_aeon_shared_env(args, values)
        return 0

    if args.import_env:
        source = pathlib.Path(os.path.expanduser(os.environ.get("HERMES_ENV_FILE", str(HERMES_ENV_FILE)))).resolve()
        values = parse_env_file(source)
        valid_values = {key: value for key, value in values.items() if KEY_RE.match(key)}
        if not source.exists():
            print(f"Hermes env source not found: {source}", file=sys.stderr)
            return 1
        if not valid_values:
            print(f"No valid env keys found in {source}", file=sys.stderr)
            return 1
        changed = False
        for key, value in valid_values.items():
            changed = apply_update(args, env_file, key, value, quiet=True) or changed
        print(f"imported {len(valid_values)} keys from {source}")
        maybe_refresh_encrypted_backup(args, env_file)
        sync_tailnet_updates(args, valid_values, env_file)
        auto_sync_aeon_if_shared_agent_changed(args, env_file, changed)
        return 0

    if args.import_stdin:
        values = parse_env_text(sys.stdin.read())
        valid_values = {key: value for key, value in values.items() if KEY_RE.match(key)}
        if not valid_values:
            print("No valid env keys found on stdin", file=sys.stderr)
            return 1
        changed = False
        for key, value in valid_values.items():
            changed = apply_update(args, env_file, key, value, quiet=True) or changed
        print(f"imported {len(valid_values)} keys from stdin")
        maybe_refresh_encrypted_backup(args, env_file)
        sync_tailnet_updates(args, valid_values, env_file)
        auto_sync_aeon_if_shared_agent_changed(args, env_file, changed)
        return 0

    if args.ensure_placeholder:
        key = (args.assignment or "").strip()
        if not key or "=" in key:
            print("--ensure-placeholder takes a bare KEY", file=sys.stderr)
            return 2
        if not KEY_RE.match(key):
            print(f"Invalid env key: {key!r}", file=sys.stderr)
            return 2
        if args.scope == "app":
            target = env_file
        elif args.scope == "agent" and args.runtime == "generic":
            target = agent_env_file(args)
        else:
            print("--ensure-placeholder supports --scope app or the generic agent store", file=sys.stderr)
            return 2
        if ensure_env_placeholder(target, key):
            print(f"added placeholder to {target}: {key}=")
        else:
            print(f"{target} already has {key}")
        return 0

    if not args.assignment:
        print("Usage: hive-env-add KEY=value, hive-env-add KEY, hive-env-add --import-env, hive-env-add --import-stdin, hive-env-add --reconcile, hive-env-add --retry-pending, hive-env-add --pull-reconcile, or hive-env-add --pull-from USER@HOST", file=sys.stderr)
        return 2

    if "=" in args.assignment:
        key, value = args.assignment.split("=", 1)
    elif args.stdin:
        key = args.assignment
        # Strip one trailing newline so `echo value |` and `printf '%s'`
        # agree, matching the getpass branch below. App callers pipe the
        # value with no newline, so this only affects shell pipes.
        value = sys.stdin.read()
        if value.endswith("\r\n"):
            value = value[:-2]
        elif value.endswith("\n"):
            value = value[:-1]
    else:
        key = args.assignment
        value = prompt_secret(f"{key}=")

    if not KEY_RE.match(key):
        print(f"Invalid env key: {key!r}", file=sys.stderr)
        return 2

    changed = apply_update(args, env_file, key, value)

    propagate_with_progress(args, env_file, key, value, changed)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
