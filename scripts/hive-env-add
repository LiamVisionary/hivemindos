#!/usr/bin/env python3
"""Add or update local HivemindOS environment variables.

The command keeps plaintext secrets local, then optionally refreshes an
encrypted folder-backed note backup when GPG configuration is available.
"""
from __future__ import annotations

import argparse
import contextlib
import getpass
import hashlib
import io
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
from typing import Iterable

SCRIPT_PATH = pathlib.Path(__file__).resolve()
