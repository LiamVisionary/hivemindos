{
  "name": "hivemindos-paid-agent-gateway-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create hivemindos_paid_agent_gateway",
    "d1:migrate:local": "wrangler d1 execute hivemindos_paid_agent_gateway --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute hivemindos_paid_agent_gateway --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@x402/core": "^2.16.0",
    "@x402/evm": "^2.16.0",
    "@x402/extensions": "^2.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260521.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.17.0"
  }
}
