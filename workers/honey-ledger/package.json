{
  "name": "hivemindos-honey-ledger-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create hivemindos_honey_ledger",
    "d1:migrate:local": "wrangler d1 execute hivemindos_honey_ledger --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute hivemindos_honey_ledger --remote --file=./schema.sql",
    "d1:migrate:reward-pool:remote": "wrangler d1 execute hivemindos_honey_ledger --remote --file=./migrations/0002_reward_pool.sql",
    "d1:migrate:managed-billing:remote": "wrangler d1 execute hivemindos_honey_ledger --remote --file=./migrations/0003_managed_billing.sql",
    "d1:migrate:command-nonces:remote": "wrangler d1 execute hivemindos_honey_ledger --remote --file=./migrations/0004_command_nonces.sql",
    "typecheck": "tsc --noEmit",
    "test": "node test/auth-matrix.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260521.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.17.0"
  }
}
