    "@ai-sdk/react": "^2.0.181",
    "@livekit/agents": "^1.4.5",
    "@livekit/agents-plugin-openai": "^1.4.5",
    "@livekit/rtc-node": "^0.13.29",
    "@lottiefiles/dotlottie-react": "^0.19.3",
    "@lottiefiles/dotlottie-web": "0.73.0",
