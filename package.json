{
  "name": "hivemindos",
  "version": "0.2.3",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@8.6.12",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "hive:update": "bash scripts/update-hivemindos.sh",
    "build": "scripts/run-with-memory-limit.sh --limit-mb 5000 --timeout-seconds 300 -- next build --webpack",
    "dashboard-auth": "node scripts/dashboard-auth.mjs",
    "start": "next start -H 127.0.0.1 -p 5020",
    "lint": "eslint",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev-signed.mjs",
    "tauri:next-dev": "node scripts/tauri-next-dev.mjs",
    "tauri:prepare": "node scripts/stage-tauri-claw-sidecar.mjs && node scripts/tauri-build.mjs",
    "tauri:prepare:server": "HIVEMINDOS_TAURI_EMBEDDED_NEXT=1 node scripts/stage-tauri-claw-sidecar.mjs && HIVEMINDOS_TAURI_EMBEDDED_NEXT=1 node scripts/tauri-build.mjs",
    "tauri:prepare:server:fresh": "HIVEMINDOS_TAURI_EMBEDDED_NEXT=1 HIVEMINDOS_TAURI_FORCE_NEXT_BUILD=1 node scripts/stage-tauri-claw-sidecar.mjs && HIVEMINDOS_TAURI_EMBEDDED_NEXT=1 HIVEMINDOS_TAURI_FORCE_NEXT_BUILD=1 node scripts/tauri-build.mjs",
    "tauri:phase2-required": "pnpm tauri:prepare",
    "tauri:build": "tauri build",
    "tauri:build:server": "HIVEMINDOS_TAURI_EMBEDDED_NEXT=1 tauri build",
    "tauri:build:server:fast": "HIVEMINDOS_TAURI_EMBEDDED_NEXT=1 tauri build --no-bundle",
    "tauri:bundle:server": "HIVEMINDOS_TAURI_EMBEDDED_NEXT=1 pnpm tauri:prepare:server && tauri bundle --bundles app,dmg",
    "version:bump": "node scripts/bump-app-version.mjs",
    "test:kanban": "node scripts/test-kanban-workflow.mjs",
    "test:e2e:queen-bee": "node scripts/e2e-queen-bee-real-chat.mjs",
    "test:queen-bee:autonomous": "node scripts/test-queen-bee-autonomous-pickup.mjs",
    "test:dashboard-nav": "node scripts/test-dashboard-nav.mjs",
    "test:fleet-agent-suppression": "node scripts/test-fleet-agent-suppression.mjs",
    "test:dashboard-state-snapshot": "node scripts/test-dashboard-state-snapshot.mjs",
    "test:native-first-launch-privacy": "node scripts/test-native-first-launch-privacy.mjs",
    "test:tauri-release-mode": "node scripts/test-tauri-release-mode.mjs",
    "test:fleet-local": "node scripts/test-fleet-local-collector.mjs",
    "test:fleet-app-icons": "node scripts/test-fleet-app-icons.mjs",
    "test:e2e:real-fleet": "node scripts/e2e-real-fleet.mjs",
    "test:e2e:agents": "node scripts/e2e-real-fleet.mjs --suite=agents",
    "test:e2e:env": "node scripts/e2e-real-fleet.mjs --suite=env",
    "test:e2e:skills": "node scripts/e2e-real-fleet.mjs --suite=skills",
    "test:e2e:file-share": "node scripts/e2e-real-fleet.mjs --suite=file-share",
    "test:e2e:handoff": "node scripts/e2e-real-fleet.mjs --suite=handoff",
    "test:e2e:kanban": "node scripts/e2e-real-fleet.mjs --suite=kanban",
    "test:e2e:adaptive-agent": "node scripts/e2e-real-fleet.mjs --suite=adaptive-agent",
    "test:e2e:agent-call": "node scripts/e2e-dashboard-agent-call.mjs",
    "test:e2e:dashboard-smoke": "node scripts/e2e-real-fleet.mjs --suite=smoke",
    "test:e2e:setup-matrix": "node scripts/test-setup-e2e-matrix.mjs",
    "test:aeon-brain": "node scripts/test-aeon-brain-access.mjs",
    "test:api-auth": "node scripts/test-dashboard-api-auth.mjs",
    "test:dashboard-auth": "node scripts/test-dashboard-auth-helper.mjs",
    "test:honey-economics": "node scripts/simulate-honey-economics.mjs",
    "test:gbrain-foundation": "node scripts/test-gbrain-foundation.mjs",
    "test:vault-structure": "node scripts/test-vault-structure-contract.mjs",
    "test:hive-env-remove": "node scripts/test-hive-env-remove.mjs",
    "benchmark:token-savings": "pnpm benchmark:context-savings",
    "benchmark:e2e-token-savings": "node scripts/benchmark-e2e-token-savings.mjs",
    "vault:doctor": "node scripts/vault-doctor.mjs",
    "test:hive-transfer": "node scripts/test-hive-transfer.mjs",
    "test:buy-stock": "node scripts/test-buy-stock-xstocks.mjs",
    "e2e:buy-stock-alpaca": "node scripts/e2e-buy-stock-alpaca.mjs",
    "check-sizes": "node scripts/check-file-sizes.mjs",
    "typecheck": "tsc --noEmit",
    "benchmark:context-savings": "node scripts/benchmark-context-savings.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.77",
